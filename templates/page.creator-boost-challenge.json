      "settings": {
        "custom_liquid": "{% comment %}\n  ============================================================\n  VALTINSU — 无缝滚动图片长廊（无文字版）\n  使用：Shopify 主题编辑器 → 自定义 Liquid 代码块\n  修改：编辑下方 \"图片配置\" 区域，替换图片 URL\n  ============================================================\n{% endcomment %}\n\n{% comment %} ====== 图片配置（修改这里，替换为你的图片 URL）====== {% endcomment %}\n\n{% assign ig_images = \"\nhttps://cdn.shopify.com/s/files/1/0702/6999/3050/files/VALTINSU-Electric-Dirt-Bike-Picture-Slideshow-10.jpg?v=1776916519|Rider 1,\nhttps://cdn.shopify.com/s/files/1/0702/6999/3050/files/VALTINSU-Electric-Dirt-Bike-Picture-Slideshow-6.jpg?v=1776916519|Rider 2,\nhttps://cdn.shopify.com/s/files/1/0702/6999/3050/files/VALTINSU-Electric-Dirt-Bike-Picture-Slideshow-13.jpg?v=1776916520|Rider 3,\nhttps://cdn.shopify.com/s/files/1/0702/6999/3050/files/VALTINSU-Electric-Dirt-Bike-Picture-Slideshow-8.jpg?v=1776916520|Rider 4,\nhttps://cdn.shopify.com/s/files/1/0702/6999/3050/files/VALTINSU-Electric-Dirt-Bike-Picture-Slideshow-4.jpg?v=1776916520|Rider 5,\nhttps://cdn.shopify.com/s/files/1/0702/6999/3050/files/VALTINSU-Electric-Dirt-Bike-Picture-Slideshow-5.jpg?v=1776916519|Rider 6,\nhttps://cdn.shopify.com/s/files/1/0702/6999/3050/files/VALTINSU-Electric-Dirt-Bike-Picture-Slideshow-12.jpg?v=1776916519|Rider 7,\nhttps://cdn.shopify.com/s/files/1/0702/6999/3050/files/VALTINSU-Electric-Dirt-Bike-Picture-Slideshow-14.jpg?v=1776916520|Rider 8,\nhttps://cdn.shopify.com/s/files/1/0702/6999/3050/files/VALTINSU-Electric-Dirt-Bike-Picture-Slideshow-3.jpg?v=1776916519|Rider 9,\nhttps://cdn.shopify.com/s/files/1/0702/6999/3050/files/VALTINSU-Electric-Dirt-Bike-Picture-Slideshow-9.jpg?v=1776916519|Rider 10,\nhttps://cdn.shopify.com/s/files/1/0702/6999/3050/files/VALTINSU-Electric-Dirt-Bike-Picture-Slideshow-11.jpg?v=1776916520|Rider 11,\nhttps://cdn.shopify.com/s/files/1/0702/6999/3050/files/VALTINSU-Electric-Dirt-Bike-Picture-Slideshow-1.jpg?v=1776916520|Rider 12,\nhttps://cdn.shopify.com/s/files/1/0702/6999/3050/files/VALTINSU-Electric-Dirt-Bike-Picture-Slideshow-7.jpg?v=1776916520|Rider 13,\nhttps://cdn.shopify.com/s/files/1/0702/6999/3050/files/VALTINSU-Electric-Dirt-Bike-Picture-Slideshow-2.jpg?v=1776916520|Rider 14\n\" %}\n\n{% assign ig_speed     = 40 %}\n{% assign ig_height    = 420 %}\n{% assign ig_gap       = 6 %}\n{% assign ig_bar_color = \"#c8000a\" %}\n\n{% comment %} ====== 以下无需修改 ====== {% endcomment %}\n\n<div id=\"ig-root\">\n  <div class=\"ig-stage\" aria-label=\"Community ride photos\">\n    <div class=\"ig-fade ig-fade--left\"  aria-hidden=\"true\"></div>\n    <div class=\"ig-fade ig-fade--right\" aria-hidden=\"true\"></div>\n\n    <div class=\"ig-track\" id=\"igTrack\">\n      {% for pass in (1..2) %}\n        <div class=\"ig-reel\" aria-hidden=\"{% if pass == 2 %}true{% else %}false{% endif %}\">\n          {% assign items = ig_images | split: \",\" %}\n          {% for item in items %}\n            {% assign parts = item | strip | split: \"|\" %}\n            {% assign img_url = parts[0] | strip %}\n            {% assign img_alt = parts[1] | strip | default: \"VALTINSU rider\" %}\n            {% if img_url != \"\" %}\n              <div class=\"ig-item\">\n                <img\n                  src=\"{{ img_url }}\"\n                  alt=\"{{ img_alt }}\"\n                  loading=\"lazy\"\n                  decoding=\"async\"\n                  draggable=\"false\"\n                >\n                <div class=\"ig-item__overlay\" aria-hidden=\"true\"></div>\n              </div>\n            {% endif %}\n          {% endfor %}\n        </div>\n      {% endfor %}\n    </div>\n  </div>\n</div>\n\n<style>\n/* ── 突破 Dawn 主题容器，强制全宽 ── */\n#ig-root {\n  --ig-bar:    {{ ig_bar_color }};\n  --ig-h:      {{ ig_height }}px;\n  --ig-gap:    {{ ig_gap }}px;\n  --ig-speed:  {{ ig_speed }}s;\n  --ig-bg:     #0a0a0a;\n  --ig-fade-w: 120px;\n\n  background: var(--ig-bg);\n  overflow: hidden;\n\n  /* 关键：突破 Dawn 所有父级容器的宽度限制 */\n  width: 100vw;\n  max-width: 100vw !important;\n  position: relative;\n  left: 50%;\n  right: 50%;\n  margin-left: -50vw;\n  margin-right: -50vw;\n}\n\n#ig-root *, #ig-root *::before, #ig-root *::after {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\n/* ── 滚动舞台 ── */\n.ig-stage {\n  position: relative;\n  width: 100%;\n  overflow: hidden;\n  user-select: none;\n  -webkit-user-select: none;\n  /* 调整上下内边距，让图片垂直居中更美观 */\n  padding: 20px 0;\n}\n\n/* 左右渐变遮罩 */\n.ig-fade {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  width: var(--ig-fade-w);\n  z-index: 2;\n  pointer-events: none;\n}\n.ig-fade--left {\n  left: 0;\n  background: linear-gradient(to right, var(--ig-bg) 0%, transparent 100%);\n}\n.ig-fade--right {\n  right: 0;\n  background: linear-gradient(to left, var(--ig-bg) 0%, transparent 100%);\n}\n\n/* ── 轨道 ── */\n.ig-track {\n  display: flex;\n  width: max-content;\n}\n\n/* ── 单个 reel ── */\n.ig-reel {\n  display: flex;\n  gap: var(--ig-gap);\n  padding: 0 var(--ig-gap) 0 0;\n  animation: ig-scroll var(--ig-speed) linear infinite;\n}\n\n/* 鼠标悬停暂停 */\n.ig-stage:hover .ig-reel {\n  animation-play-state: paused;\n}\n\n/* ── 单张图片卡片 ── */\n.ig-item {\n  position: relative;\n  height: var(--ig-h);\n  flex-shrink: 0;\n  overflow: hidden;\n  clip-path: polygon(\n    0 0,\n    calc(100% - 10px) 0,\n    100% 10px,\n    100% 100%,\n    10px 100%,\n    0 calc(100% - 10px)\n  );\n  cursor: pointer;\n  min-width: 200px;\n}\n\n.ig-item img {\n  height: 100%;\n  width: auto;\n  max-width: none;\n  object-fit: cover;\n  display: block;\n  transition: transform 0.5s ease;\n  pointer-events: none;\n}\n\n.ig-item:hover img {\n  transform: scale(1.06);\n}\n\n.ig-item__overlay {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(\n    to top,\n    rgba(200, 0, 10, 0.35) 0%,\n    transparent 50%\n  );\n  opacity: 0;\n  transition: opacity 0.3s ease;\n}\n.ig-item:hover .ig-item__overlay {\n  opacity: 1;\n}\n\n/* ── 滚动动画 ── */\n@keyframes ig-scroll {\n  0%   { transform: translateX(0); }\n  100% { transform: translateX(-50%); }\n}\n\n/* ── 响应式 ── */\n@media (max-width: 768px) {\n  #ig-root {\n    --ig-h: 280px;\n    --ig-fade-w: 60px;\n  }\n  .ig-item {\n    min-width: 140px;\n  }\n}\n\n@media (max-width: 480px) {\n  #ig-root {\n    --ig-h: 220px;\n    --ig-speed: 30s;\n    --ig-fade-w: 40px;\n  }\n  .ig-item {\n    min-width: 120px;\n  }\n}\n\n/* 无障碍：减少动画 */\n@media (prefers-reduced-motion: reduce) {\n  .ig-reel {\n    animation: none !important;\n  }\n  .ig-track {\n    overflow-x: auto;\n  }\n}\n</style>\n\n<script>\n(function () {\n  var stage = document.querySelector('#ig-root .ig-stage');\n  var reels = document.querySelectorAll('#ig-root .ig-reel');\n  if (!stage || !reels.length) return;\n\n  stage.addEventListener('touchstart', function () {\n    reels.forEach(function (r) {\n      r.style.animationPlayState = 'paused';\n    });\n  }, { passive: true });\n\n  stage.addEventListener('touchend', function () {\n    reels.forEach(function (r) {\n      r.style.animationPlayState = '';\n    });\n  }, { passive: true });\n})();\n</script>",
        "color_scheme": "",
        "padding_top": 8,
        "padding_bottom": 0
      }
    },
