    "custom_liquid_xJTjj8": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- Valtinsu Ride Challenge - Rules & Guidelines (English) - 全宽黑色系版 - 电脑端3列 -->\n<style>\n  /* 全宽黑色背景外层容器 */\n  .vr-challenge-wrapper {\n    width: 100%;\n    background: #000000; /* 纯黑色全宽背景 */\n    padding: 4rem 0; /* 上下留白，保证模块间距 */\n    margin: 2rem 0;\n  }\n\n  .vr-challenge-rules {\n    max-width: 1400px;\n    margin: 0 auto; /* 内容居中 */\n    padding: 1.5rem;\n    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n    background: #000000; /* 内部背景同步纯黑 */\n    border-radius: 28px;\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);\n  }\n\n  .vr-header {\n    text-align: center;\n    margin-bottom: 2.5rem;\n    padding-bottom: 1rem;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .vr-header h2 {\n    font-size: 3rem;\n    font-weight: 700;\n    background: linear-gradient(135deg, #ffffff, #e0e0e0);\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n    margin-bottom: 0.5rem;\n  }\n\n  .vr-header p {\n    color: #ff6600;\n    font-size: 1.5rem;\n    border-top: 2px solid rgba(255, 255, 255, 0.1);\n    display: inline-block;\n    padding-top: 0.5rem;\n  }\n\n  /* 默认栅格（移动优先） - 自动适配列数 */\n  .vr-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n    gap: 1.8rem;\n  }\n\n  /* 电脑端（≥1024px）强制改为 3 列 */\n  @media (min-width: 1024px) {\n    .vr-grid {\n      grid-template-columns: repeat(3, 1fr);\n    }\n  }\n\n  .vr-card {\n    background: #121212;\n    border-radius: 28px;\n    padding: 1.5rem 1.8rem;\n    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25), 0 2px 6px rgba(0, 0, 0, 0.15);\n    transition: all 0.3s ease;\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .vr-card:hover {\n    transform: translateY(-3px);\n    box-shadow: 0 20px 30px -12px rgba(0, 0, 0, 0.3);\n    border-color: rgba(255, 102, 0, 0.3);\n    background: rgba(18, 18, 18, 0.95);\n  }\n\n  .vr-card-title {\n    font-size: 2rem;\n    font-weight: 700;\n    margin-bottom: 1.25rem;\n    display: flex;\n    align-items: center;\n    gap: 0.6rem;\n    border-left: 4px solid #ff6600;\n    padding-left: 0.9rem;\n    color: #ffffff;\n  }\n\n  .vr-list {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n  }\n\n  .vr-list li {\n    margin-bottom: 1rem;\n    padding-left: 1.4rem;\n    position: relative;\n    font-size: 1.5rem;\n    line-height: 1.4;\n    color: #e0e0e0;\n  }\n\n  .vr-list li::before {\n    content: \"▹\";\n    position: absolute;\n    left: 0;\n    color: #ffdd57;\n    font-weight: 600;\n  }\n\n  .vr-note {\n    background: rgba(255, 102, 0, 0.1);\n    padding: 0.9rem;\n    border-radius: 20px;\n    margin-top: 1rem;\n    font-size: 1.2rem;\n    color: #f0f0f0;\n    border-left: 3px solid #ff6600;\n  }\n\n  .vr-badge {\n    background: rgba(0, 102, 204, 0.2);\n    color: #4db8ff;\n    font-weight: 600;\n    padding: 0.2rem 0.7rem;\n    border-radius: 40px;\n    font-size: 1rem;\n    display: inline-block;\n    margin-bottom: 0.8rem;\n    letter-spacing: 0.3px;\n    border: 1px solid rgba(0, 102, 204, 0.3);\n  }\n\n  hr {\n    margin: 1rem 0;\n    border-color: rgba(255, 255, 255, 0.08);\n  }\n\n  /* 移动端适配（保持不变） */\n  @media (max-width: 700px) {\n    .vr-challenge-wrapper {\n      padding: 2.5rem 0;\n      margin: 1.5rem 0;\n    }\n    .vr-challenge-rules {\n      padding: 1rem;\n      border-radius: 20px;\n    }\n    .vr-card {\n      padding: 1.2rem;\n    }\n    .vr-card-title {\n      font-size: 1.8rem;\n    }\n    .vr-list li {\n      font-size: 1.2rem;\n    }\n    .vr-grid {\n      gap: 1.2rem;\n    }\n    .vr-header h2 {\n      font-size: 2.2rem;\n    }\n    .vr-header p {\n      font-size: 1.2rem;\n    }\n  }\n\n  @media (max-width: 480px) {\n    .vr-challenge-wrapper {\n      padding: 1.5rem 0;\n    }\n    .vr-card-title {\n      font-size: 1.6rem;\n    }\n    .vr-list li {\n      font-size: 1.1rem;\n    }\n    .vr-note {\n      font-size: 1.1rem;\n    }\n  }\n</style>\n\n<!-- 全宽黑色容器包裹 -->\n<div class=\"vr-challenge-wrapper\">\n  <div class=\"vr-challenge-rules\">\n    <div class=\"vr-header\">\n      <h2>Valtinsu Ride Challenge</h2>\n      <p>Official rules & participation guidelines</p>\n    </div>\n\n    <div class=\"vr-grid\">\n      <!-- 1. REVIEW & PAYMENT MECHANISM -->\n      <div class=\"vr-card\">\n        <div class=\"vr-card-title\">📋 Review & Payment</div>\n        <ul class=\"vr-list\">\n          <li>Submit video link + backend analytics screenshot (views/engagement).</li>\n          <li>Provide PayPal email (invalid/unreachable = forfeit).</li>\n          <li>Manual compliance review → then payout.</li>\n          <li>Submissions received by month end are reviewed by the 15th of next month.</li>\n          <li>Rewards paid from last week of next month → first week of following month.</li>\n        </ul>\n        <div class=\"vr-note\">⚠️ Must use Valtinsu branded vehicle / product in a real riding or usage scene.</div>\n      </div>\n\n      <!-- 2. CONTENT RULES -->\n      <div class=\"vr-card\">\n        <div class=\"vr-card-title\">🎬 Video Requirements</div>\n        <ul class=\"vr-list\">\n          <li>Minimum length: 10 seconds.</li>\n          <li>Product must be clearly visible.</li>\n          <li>Must be original content (no stolen/reused clips).</li>\n          <li>Video must be public (do not private before reward is paid).</li>\n          <li>Must @valtinsu and use hashtag <strong>#ValtinsuRideChallenge</strong>.</li>\n        </ul>\n        <div class=\"vr-note\">📍 Platform: TikTok  /  Instagram Reels only.</div>\n      </div>\n\n      <!-- 3. ELIGIBILITY & SUBMISSION LIMITS -->\n      <div class=\"vr-card\">\n        <div class=\"vr-card-title\">👥 Participation rules</div>\n        <ul class=\"vr-list\">\n          <li>Each video can only be submitted once.</li>\n          <li>One account: max 3 different video submissions per month.</li>\n          <li>Reward sent via PayPal – taxes, duties, government fees are responsibility of recipient.</li>\n          <li>Already working with or sponsored by Valtinsu? Not eligible.</li>\n        </ul>\n      </div>\n\n      <!-- 4. SAFETY & COMPLIANCE -->\n      <div class=\"vr-card\">\n        <div class=\"vr-card-title\">🛡️ Safety & Compliance</div>\n        <ul class=\"vr-list\">\n          <li>Must be filmed in a safe, legal riding zone.</li>\n          <li>Real riding / authentic usage – no fake setups.</li>\n          <li>No slideshows, stock footage, or compiled ad snippets.</li>\n        </ul>\n      </div>\n\n      <!-- 5. PROHIBITED BEHAVIOR -->\n      <div class=\"vr-card\">\n        <div class=\"vr-card-title\">🚫 Cheating / Fraud</div>\n        <ul class=\"vr-list\">\n          <li>No purchased views, likes, comments, shares.</li>\n          <li>No bot traffic or engagement pods.</li>\n          <li>Violation = immediate disqualification.</li>\n        </ul>\n        <div class=\"vr-note\">🔍 All entries are manually checked for authenticity.</div>\n      </div>\n\n      <!-- 6. RIGHTS TO CONTENT -->\n      <div class=\"vr-card\">\n        <div class=\"vr-card-title\">📢 Content usage rights</div>\n        <ul class=\"vr-list\">\n          <li>By posting, you grant Valtinsu the right to use your video in ads (worldwide).</li>\n          <li>Brand may perform light editing (does not change original meaning).</li>\n          <li>No extra compensation beyond the challenge reward.</li>\n        </ul>\n      </div>\n    </div>\n  </div>\n</div>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
