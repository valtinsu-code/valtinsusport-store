      "settings": {
        "custom_liquid": "<!-- Reward Tiers - Valtinsu Creator Boost（全宽纯黑版）+ 参与奖置顶 -->\n<style>\n  /* 全宽黑色背景容器 */\n  .reward-tier-wrapper {\n    width: 100%;\n    background: #000000;\n    padding: 3rem 0;\n    margin: 2rem 0;\n  }\n\n  .reward-tier-section {\n    max-width: 1400px;\n    margin: 0 auto;\n    padding: 1.5rem;\n    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n    background: #000000;\n    border-radius: 28px;\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);\n  }\n\n  .reward-header {\n    text-align: center;\n    margin-bottom: 2rem;\n    padding-bottom: 1rem;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .reward-header h3 {\n    font-size: 1.8rem;\n    font-weight: 700;\n    color: #ffffff;\n    margin-bottom: 0.5rem;\n    line-height: 1.3;\n  }\n\n  .reward-header .accent-line {\n    width: 70px;\n    height: 4px;\n    background: #ff6600;\n    margin: 0.8rem auto 0;\n    border-radius: 4px;\n  }\n\n  /* 桌面表格样式 */\n  .reward-table {\n    background: #121212;\n    border-radius: 28px;\n    overflow: hidden;\n    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25), 0 2px 6px rgba(0, 0, 0, 0.15);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n    margin-bottom: 1.5rem;\n  }\n\n  .reward-row {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 1.5rem 2rem;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n    transition: all 0.3s ease;\n  }\n\n  .reward-row:last-child {\n    border-bottom: none;\n  }\n\n  .reward-row:hover {\n    background: rgba(255, 102, 0, 0.08);\n    transform: translateX(2px);\n  }\n\n  .views {\n    font-weight: 600;\n    font-size: 1.5rem;\n    color: #e0e0e0;\n    display: flex;\n    align-items: center;\n    gap: 0.6rem;\n    flex-wrap: wrap;\n  }\n\n  .reward-amount {\n    font-weight: 800;\n    font-size: 1.4rem;\n    color: #ffdd57;\n    letter-spacing: -0.3px;\n  }\n\n  .participation-note {\n    font-size: 1rem;\n    color: #ffcc88;\n    background: rgba(0,0,0,0.4);\n    padding: 0.2rem 0.8rem;\n    border-radius: 30px;\n    margin-left: 10px;\n  }\n\n  /* 额外奖励卡片 */\n  .extra-rewards {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 1.2rem;\n    justify-content: space-between;\n    align-items: center;\n    background: rgba(255, 102, 0, 0.1);\n    border-left: 5px solid #ff6600;\n    border-radius: 20px;\n    padding: 1.5rem 2rem;\n    margin-top: 1rem;\n  }\n\n  .extra-item {\n    display: flex;\n    align-items: center;\n    gap: 0.8rem;\n    font-size: 1.5rem;\n    color: #f0f0f0;\n    flex: 1;\n    min-width: 220px;\n  }\n\n  .extra-icon {\n    font-size: 1.5rem;\n    color: #ffdd57;\n  }\n\n  .extra-text strong {\n    color: #ff6600;\n    font-weight: 700;\n  }\n\n  /* 移动端适配 */\n  @media (max-width: 768px) {\n    .reward-tier-wrapper {\n      padding: 2rem 0;\n      margin: 1.5rem 0;\n    }\n    .reward-tier-section {\n      padding: 1rem;\n      border-radius: 20px;\n    }\n    .reward-row {\n      flex-direction: column;\n      align-items: flex-start;\n      gap: 0.8rem;\n      padding: 1.2rem 1.5rem;\n    }\n    .reward-amount {\n      font-size: 1.5rem;\n      align-self: flex-end;\n    }\n    .views {\n      font-size: 1.5rem;\n      width: 100%;\n      justify-content: space-between;\n    }\n    .participation-note {\n      margin-left: 0;\n      margin-top: 5px;\n      display: inline-block;\n      width: auto;\n    }\n    .extra-rewards {\n      flex-direction: column;\n      align-items: flex-start;\n      padding: 1.2rem 1.5rem;\n    }\n    .extra-item {\n      min-width: 100%;\n    }\n    .reward-header h3 {\n      font-size: 1.5rem;\n    }\n  }\n\n  @media (max-width: 480px) {\n    .reward-tier-wrapper {\n      padding: 1.5rem 0;\n    }\n    .reward-row {\n      padding: 1rem 1.2rem;\n    }\n    .extra-rewards {\n      padding: 1rem 1.2rem;\n    }\n    .reward-header h3 {\n      font-size: 1.3rem;\n    }\n  }\n</style>\n\n<div class=\"reward-tier-wrapper\">\n  <div class=\"reward-tier-section\">\n    <div class=\"reward-header\">\n      <h3>📊 Video Views → Cash Reward</h3>\n      <div class=\"accent-line\"></div>\n    </div>\n\n    <div class=\"reward-table\">\n      <!-- 参与奖作为第一行 -->\n      <div class=\"reward-row\">\n        <span class=\"views\">\n          🎁 3,000+ views\n        </span>\n        <span class=\"reward-amount\">$10</span>\n      </div>\n      <!-- 原有奖励阶梯 -->\n      <div class=\"reward-row\">\n        <span class=\"views\">🎯 5,000+ views</span>\n        <span class=\"reward-amount\">$20</span>\n      </div>\n      <div class=\"reward-row\">\n        <span class=\"views\">🚀 10,000+ views</span>\n        <span class=\"reward-amount\">$40</span>\n      </div>\n      <div class=\"reward-row\">\n        <span class=\"views\">🔥 20,000+ views</span>\n        <span class=\"reward-amount\">$50</span>\n      </div>\n      <div class=\"reward-row\">\n        <span class=\"views\">⚡ 50,000+ views</span>\n        <span class=\"reward-amount\">$70</span>\n      </div>\n      <div class=\"reward-row\">\n        <span class=\"views\">🏆 100,000+ views</span>\n        <span class=\"reward-amount\">$100</span>\n      </div>\n    </div>\n\n    <div class=\"extra-rewards\">\n      <div class=\"extra-item\">\n        <span class=\"extra-icon\">🥇</span>\n        <span class=\"extra-text\"><strong>Top 3 monthly creators</strong> → +$50 bonus</span>\n      </div>\n      <div class=\"extra-item\">\n        <span class=\"extra-icon\">📢</span>\n        <span class=\"extra-text\">High‑quality videos will be <strong>reshared by Valtinsu</strong></span>\n      </div>\n    </div>\n  </div>\n</div>",
