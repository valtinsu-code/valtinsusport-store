      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n.boost-challenge-modern {\n  position: relative;\n  height: 750px;\n  padding: 0 1.5rem;\n  font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n  background: url(https://cdn.shopify.com/s/files/1/0702/6999/3050/files/Creator-Boost-Challenge-Header-1.jpg?v=1777342147) center center;\n  background-size: cover;\n  background-repeat: no-repeat;\n  z-index: 1;\n  display: flex;\n  align-items: center;\n}\n.boost-challenge-modern::before {\n  content: '';\n  position: absolute;\n  left: 0;\n  top: 0;\n  width: 100%;\n  height: 100%;\n  background: rgba(0, 0, 0, 0.45);\n  z-index: -1;\n}\n.boost-container {\n  max-width: 1200px;\n  margin: 0 auto;\n  position: relative;\n  z-index: 2;\n  text-align: center;\n  width: 100%;\n}\n.boost-title-group {\n  margin-bottom: 3rem;\n}\n.boost-title {\n  font-size: 3.6rem;\n  font-weight: 800;\n  color: #fff;\n  margin-bottom: 0.5rem;\n  text-shadow: 0 2px 10px rgba(0,0,0,0.4);\n  line-height: 1.2;\n}\n/* 新增小标题样式 */\n.boost-subtitle {\n  font-size: 1.6rem;\n  font-weight: 500;\n  color: rgba(255, 255, 255, 0.9);\n  text-shadow: 0 1px 4px rgba(0,0,0,0.3);\n  letter-spacing: 0.5px;\n  margin-top: 0.5rem;\n}\n/* 新增强调文字样式 */\n.boost-highlight-text {\n  display: inline-block;\n  margin-top: 1rem;\n  padding: 0.5rem 1.2rem;\n  background: rgba(255, 221, 87, 0.15);\n  border: 1px solid rgba(255, 221, 87, 0.4);\n  color: #ffdd57;\n  font-size: 1.3rem;\n  font-weight: 600;\n  border-radius: 50px;\n  letter-spacing: 0.5px;\n  text-shadow: 0 1px 2px rgba(0,0,0,0.5);\n}\n.boost-stats-grid {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 1.5rem;\n  margin-bottom: 2rem;\n}\n.boost-stat-card {\n  background: rgba(255, 255, 255, 0.15);\n  backdrop-filter: blur(10px);\n  border-radius: 24px;\n  padding: 1.8rem 1.4rem;\n  flex: 1;\n  min-width: 150px;\n  border: 1px solid rgba(255,255,255,0.25);\n  transition: all 0.3s ease;\n  text-align: center;\n  box-shadow: 0 8px 25px rgba(0,0,0,0.2);\n}\n.boost-stat-card:hover {\n  transform: translateY(-4px);\n  background: rgba(255, 255, 255, 0.25);\n  border-color: rgba(255,255,255,0.4);\n}\n.boost-stat-value {\n  font-size: 2.2rem;\n  font-weight: 800;\n  color: #ffdd57;\n  margin-bottom: 0.4rem;\n}\n.boost-stat-label {\n  font-size: 0.9rem;\n  color: rgba(255,255,255,0.92);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  font-weight: 500;\n}\n.boost-btn-wrapper {\n  margin-top: 2rem;\n  text-align: center;\n}\n.boost-trigger-btn {\n  background: linear-gradient(135deg, #ff8c42 0%, #f77314 100%);\n  border: none;\n  color: white;\n  font-weight: 600;\n  padding: 14px 32px;\n  border-radius: 50px;\n  font-size: 1.05rem;\n  font-family: 'Montserrat', system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n  cursor: pointer;\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  box-shadow: 0 6px 14px rgba(247, 115, 20, 0.3);\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  letter-spacing: 0.5px;\n}\n.boost-trigger-btn:hover {\n  background: linear-gradient(135deg, #ff9b55 0%, #e05f00 100%);\n  transform: translateY(-3px);\n  box-shadow: 0 12px 24px rgba(247, 115, 20, 0.4);\n}\n@media (max-width: 768px) {\n  .boost-trigger-btn {\n    padding: 11px 24px;\n    font-size: 0.9rem;\n  }\n  .boost-challenge-modern {\n    height: auto;\n    padding: 3rem 1rem;\n    background-position: center;\n  }\n  .boost-title {\n    font-size: 2.2rem;\n  }\n  .boost-subtitle {\n    font-size: 1.2rem;\n  }\n  .boost-highlight-text {\n    font-size: 1.2rem;\n    padding: 0.4rem 1rem;\n    margin-top: 0.8rem;\n  }\n  .boost-stats-grid {\n    flex-direction: column;\n    max-width: 300px;\n    margin: 0 auto 1.5rem auto;\n    gap: 1rem;\n  }\n  .boost-stat-card {\n    padding: 1.4rem 1rem;\n  }\n  .boost-stat-value {\n    font-size: 1.8rem;\n  }\n}\n@media (max-width: 480px) {\n  .boost-challenge-modern {\n    padding: 2rem 1rem;\n  }\n  .boost-title {\n    font-size: 1.8rem;\n  }\n  .boost-subtitle {\n    font-size: 1.1rem;\n  }\n  .boost-highlight-text {\n    font-size: 1rem;\n  }\n}\n</style>\n\n<section class=\"boost-challenge-modern\">\n  <div class=\"boost-container\">\n    <div class=\"boost-title-group\">\n      <h1 class=\"boost-title\">Valtinsu Creator Boost Challenge</h1>\n      <div class=\"boost-highlight-text\">\n        Videos must include @valtinsu and #ValtinsuRideChallenge\n      </div>\n    </div>\n    <div class=\"boost-stats-grid\">\n      <div class=\"boost-stat-card\"><div class=\"boost-stat-value\">3%+</div><div class=\"boost-stat-label\">Engagement Rate</div></div>\n      <div class=\"boost-stat-card\"><div class=\"boost-stat-value\">10s+</div><div class=\"boost-stat-label\">Video Duration</div></div>\n      <div class=\"boost-stat-card\"><div class=\"boost-stat-value\">$100</div><div class=\"boost-stat-label\">Top Reward</div></div>\n      <div class=\"boost-stat-card\"><div class=\"boost-stat-value\">3x</div><div class=\"boost-stat-label\">Monthly Submissions</div></div>\n    </div>\n    <div class=\"boost-btn-wrapper\">\n      <button class=\"boost-trigger-btn globo-formbuilder-open\" data-id=\"MTQ0NjA5\">\n        ✨ Join Valtinsu Creator Boost Challenge →\n      </button>\n    </div>\n  </div>\n</section>\n\n<script>\n(function() {\n  if (window.__VALTINSU_POWERFUL_CLOSE_FIX) return;\n  window.__VALTINSU_POWERFUL_CLOSE_FIX = true;\n\n  // 检测当前是否存在 Powerful Form Builder 弹窗\n  function isPowerfulModalVisible() {\n    return !!document.querySelector('.gfb__modal, .powerful-modal, [class*=\"gfb__modal\"], [class*=\"powerful-modal\"]');\n  }\n\n  // 强制关闭特定弹窗（只移除 Powerful Form Builder 相关元素）\n  function forceClosePowerfulPopup() {\n    const selectors = [\n      '.gfb__modal', '.gfb__modal-overlay', '.gfb__modal-container',\n      '.powerful-modal', '.powerful-modal-overlay', '.powerful-modal-container',\n      '[class*=\"gfb__modal\"]', '[class*=\"powerful-modal\"]'\n    ];\n    let removed = false;\n    selectors.forEach(sel => {\n      document.querySelectorAll(sel).forEach(el => {\n        if (el && el.offsetParent !== null) {\n          el.remove();\n          removed = true;\n        }\n      });\n    });\n    if (removed) {\n      // 恢复滚动\n      document.body.style.overflow = '';\n      document.body.style.paddingRight = '';\n      document.documentElement.style.overflow = '';\n      document.body.classList.remove('modal-open', 'overflow-hidden', 'no-scroll', 'scroll-lock');\n    }\n    return removed;\n  }\n\n  // 全局点击捕获：仅当点击目标属于 Powerful 弹窗的关闭按钮或遮罩时才干预，其他弹窗完全不管\n  document.addEventListener('click', function(e) {\n    // 首先检查是否存在 Powerful 弹窗\n    if (!isPowerfulModalVisible()) return;\n\n    let target = e.target;\n    // 检查点击是否在 Powerful 弹窗内部或遮罩上\n    let isWithinPowerful = false;\n    for (let t = target; t && t !== document.body; t = t.parentElement) {\n      if (t.classList && (\n        t.classList.contains('gfb__modal') ||\n        t.classList.contains('gfb__modal-overlay') ||\n        t.classList.contains('powerful-modal') ||\n        t.classList.contains('powerful-modal-overlay') ||\n        t.classList.contains('gfb__modal-container') ||\n        t.classList.contains('powerful-modal-container')\n      )) {\n        isWithinPowerful = true;\n        break;\n      }\n    }\n    if (!isWithinPowerful) return;\n\n    // 关闭条件：点击了关闭按钮 / 遮罩 / 任何包含 close/dismiss 的元素\n    for (let i = 0; i < 5 && target && target !== document.body; i++) {\n      const cls = typeof target.className === 'string' ? target.className : '';\n      const aria = (target.getAttribute('aria-label') || '').toLowerCase();\n      const isClose = cls.includes('close') || cls.includes('dismiss') || aria === 'close' || aria === 'dismiss';\n      if (isClose) {\n        e.preventDefault();\n        e.stopPropagation();\n        setTimeout(forceClosePowerfulPopup, 10);\n        break;\n      }\n      target = target.parentElement;\n    }\n  }, true);\n\n  // ESC 键关闭：只针对 Powerful 弹窗\n  document.addEventListener('keydown', function(e) {\n    if ((e.key === 'Escape' || e.keyCode === 27) && isPowerfulModalVisible()) {\n      forceClosePowerfulPopup();\n    }\n  });\n\n  // 动态为 Powerful 弹窗的蒙层绑定点击关闭（不影响其他弹窗）\n  const observer = new MutationObserver(() => {\n    if (!isPowerfulModalVisible()) return;\n    const overlays = document.querySelectorAll('.gfb__modal-overlay, .powerful-modal-overlay');\n    overlays.forEach(overlay => {\n      if (!overlay.__valtinsu_powerful_bound) {\n        overlay.__valtinsu_powerful_bound = true;\n        overlay.addEventListener('click', function(e) {\n          if (e.target === overlay) forceClosePowerfulPopup();\n        });\n      }\n    });\n  });\n  observer.observe(document.body, { childList: true, subtree: true });\n\n  // 轮询注入备用关闭按钮：只针对 Powerful 弹窗且没有原生关闭按钮时添加\n  let injectedBtn = null;\n  setInterval(() => {\n    const powerfulVisible = isPowerfulModalVisible();\n    if (powerfulVisible) {\n      const hasNativeClose = document.querySelector('.gfb__modal-close, .powerful-modal-close, .modal-close');\n      if (!hasNativeClose && !injectedBtn) {\n        const btn = document.createElement('button');\n        btn.innerHTML = '✕';\n        btn.setAttribute('aria-label', 'Close');\n        btn.style.cssText = `\n          position: fixed;\n          top: 20px;\n          right: 20px;\n          width: 44px;\n          height: 44px;\n          background: rgba(0,0,0,0.7);\n          border: 2px solid rgba(255,255,255,0.5);\n          border-radius: 50%;\n          color: white;\n          font-size: 24px;\n          font-weight: bold;\n          cursor: pointer;\n          z-index: 1000000;\n          display: flex;\n          align-items: center;\n          justify-content: center;\n        `;\n        btn.onclick = (e) => {\n          e.stopPropagation();\n          forceClosePowerfulPopup();\n        };\n        document.body.appendChild(btn);\n        injectedBtn = btn;\n      }\n    } else {\n      if (injectedBtn) {\n        injectedBtn.remove();\n        injectedBtn = null;\n      }\n    }\n  }, 500);\n})();\n</script>",
