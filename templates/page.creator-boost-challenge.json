    "custom_liquid_tcrr6N": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- Video Carousel Section - 4 columns on desktop (with TikTok support) -->\n<div class=\"video-carousel-wrapper\">\n  <div class=\"video-carousel-container\">\n    \n\n    <!-- Slide 1: Instagram -->\n    <div class=\"video-slide\">\n      <div class=\"video-wrapper\">\n        <iframe src=\"https://www.instagram.com/p/DXmmkQsgDsu/embed\" frameborder=\"0\" allowfullscreen></iframe>\n      </div>\n      <div class=\"video-caption\">🔥 #RidewithVALTINSU</div>\n    </div>\n\n\n    <!-- Slide 2: TikTok (NEW!) -->\n    <div class=\"video-slide\">\n      <div class=\"video-wrapper\">\n        <iframe src=\"https://www.tiktok.com/player/v1/7565545005088001294?autoplay=0&controls=1&loop=0\" \n                allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\"\n                allowfullscreen>\n        </iframe>\n      </div>\n      <div class=\"video-caption\">#valtinsuem5</div>\n    </div>\n\n\n    <!-- Slide 3: Instagram -->\n    <div class=\"video-slide\">\n      <div class=\"video-wrapper\">\n        <iframe src=\"https://www.instagram.com/p/DTToilYiTkL/embed\" frameborder=\"0\" allowfullscreen></iframe>\n      </div>\n      <div class=\"video-caption\">@valtinsu EM5 full winter review - now playing!</div>\n    </div>\n\n\n    <!-- Slide 4: TikTok (NEW!) -->\n    <div class=\"video-slide\">\n      <div class=\"video-wrapper\">\n        <iframe src=\"https://www.tiktok.com/player/v1/7632150114953415967?autoplay=0&controls=1&loop=0\" \n                allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\"\n                allowfullscreen>\n        </iframe>\n      </div>\n      <div class=\"video-caption\">Four Valtinsu riders ready for spring trails</div>\n    </div>\n\n\n\n    <!-- Slide 5: Instagram -->\n    <div class=\"video-slide\">\n      <div class=\"video-wrapper\">\n        <iframe src=\"https://www.instagram.com/p/DVMSNUeD1YE/embed\" frameborder=\"0\" allowfullscreen></iframe>\n      </div>\n      <div class=\"video-caption\">Check out this awesome new Valtinsu Electric Pit Bike</div>\n    </div>\n\n\n    <!-- Slide 6: TikTok (NEW!) -->\n    <div class=\"video-slide\">\n      <div class=\"video-wrapper\">\n        <iframe src=\"https://www.tiktok.com/player/v1/7617957773128535326?autoplay=0&controls=1&loop=0\" \n                allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\"\n                allowfullscreen>\n        </iframe>\n      </div>\n      <div class=\"video-caption\">#valtinsu #em5 red</div>\n    </div>\n\n\n    <!-- Slide 7: Instagram -->\n    <div class=\"video-slide\">\n      <div class=\"video-wrapper\">\n        <iframe src=\"https://www.instagram.com/p/DTJPzCBiZkX/embed\" frameborder=\"0\" allowfullscreen></iframe>\n      </div>\n      <div class=\"video-caption\">Winter test ride with the @valtinsu EM5</div>\n    </div>\n\n\n    <!-- Slide 8: TikTok (NEW!) -->\n    <div class=\"video-slide\">\n      <div class=\"video-wrapper\">\n        <iframe src=\"https://www.tiktok.com/player/v1/7620912658270801165?autoplay=0&controls=1&loop=0\" \n                allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\"\n                allowfullscreen>\n        </iframe>\n      </div>\n      <div class=\"video-caption\">#em5pro #valtinsu @EConicCycles</div>\n    </div>\n\n    <!-- Slide 9: Instagram -->\n    <div class=\"video-slide\">\n      <div class=\"video-wrapper\">\n        <iframe src=\"https://www.instagram.com/p/DXdBC3zkUiw/embed\" frameborder=\"0\" allowfullscreen></iframe>\n      </div>\n      <div class=\"video-caption\">POV ride on the Valtinsu EM5 🔥</div>\n    </div>\n\n\n    <!-- Slide 10: TikTok (NEW!) -->\n    <div class=\"video-slide\">\n      <div class=\"video-wrapper\">\n        <iframe src=\"https://www.tiktok.com/player/v1/7630167873935215886?autoplay=0&controls=1&loop=0\" \n                allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\"\n                allowfullscreen>\n        </iframe>\n      </div>\n      <div class=\"video-caption\">Size Comparison- Valtinsu 48v VS 60V EM-5 Pro ⚡️</div>\n    </div>\n\n  </div>\n\n  <!-- Navigation Arrows -->\n  <button class=\"carousel-prev\">❮</button>\n  <button class=\"carousel-next\">❯</button>\n\n  <!-- Dots Indicator -->\n  <div class=\"carousel-dots\"></div>\n</div>\n\n<style>\n  /* Base Styles */\n  .video-carousel-wrapper {\n    position: relative;\n    max-width: 1400px;\n    margin: 0 auto;\n    padding: 20px 40px;\n    overflow: hidden;\n  }\n\n  .video-carousel-container {\n    display: flex;\n    overflow-x: auto;\n    scroll-behavior: smooth;\n    scroll-snap-type: x mandatory;\n    gap: 20px;\n    padding: 10px 0;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n  }\n\n  .video-carousel-container::-webkit-scrollbar {\n    display: none;\n  }\n\n  .video-slide {\n    flex: 0 0 calc(25% - 15px); /* 4 columns on desktop */\n    scroll-snap-align: start;\n    background: #f5f5f5;\n    border-radius: 16px;\n    overflow: hidden;\n    transition: transform 0.3s ease;\n  }\n\n  .video-slide:hover {\n    transform: translateY(-5px);\n  }\n\n  .video-wrapper {\n    position: relative;\n    padding-bottom: 177.77%; /* 9:16 aspect ratio for vertical videos */\n    height: 0;\n    overflow: hidden;\n    background: #000;\n  }\n\n  .video-wrapper iframe {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    border: 0;\n  }\n\n  .video-caption {\n    padding: 12px;\n    text-align: center;\n    font-size: 14px;\n    font-weight: 500;\n    color: #333;\n    background: white;\n  }\n\n  /* Navigation Buttons */\n  .carousel-prev, .carousel-next {\n    position: absolute;\n    top: 50%;\n    transform: translateY(-50%);\n    background: rgba(0,0,0,0.6);\n    color: white;\n    border: none;\n    width: 40px;\n    height: 40px;\n    border-radius: 50%;\n    cursor: pointer;\n    font-size: 20px;\n    transition: background 0.3s;\n    z-index: 10;\n  }\n\n  .carousel-prev { left: 10px; }\n  .carousel-next { right: 10px; }\n\n  .carousel-prev:hover, .carousel-next:hover {\n    background: rgba(0,0,0,0.9);\n  }\n\n  /* Dots Indicator */\n  .carousel-dots {\n    text-align: center;\n    margin-top: 20px;\n  }\n\n  .carousel-dots .dot {\n    display: inline-block;\n    width: 10px;\n    height: 10px;\n    margin: 0 5px;\n    background: #ccc;\n    border-radius: 50%;\n    cursor: pointer;\n    transition: background 0.3s;\n  }\n\n  .carousel-dots .dot.active {\n    background: #333;\n  }\n\n  /* Tablet: 2 columns */\n  @media (max-width: 1024px) {\n    .video-slide {\n      flex: 0 0 calc(50% - 10px);\n    }\n    .video-carousel-wrapper {\n      padding: 20px 30px;\n    }\n  }\n\n  /* Mobile: 1 column */\n  @media (max-width: 640px) {\n    .video-slide {\n      flex: 0 0 85%;\n    }\n    .video-caption {\n      font-size: 12px;\n      padding: 8px;\n    }\n    .carousel-prev, .carousel-next {\n      width: 30px;\n      height: 30px;\n      font-size: 14px;\n    }\n  }\n</style>\n\n<script>\n  (function() {\n    const container = document.querySelector('.video-carousel-container');\n    const prevBtn = document.querySelector('.carousel-prev');\n    const nextBtn = document.querySelector('.carousel-next');\n    const dotsContainer = document.querySelector('.carousel-dots');\n\n    if (!container) return;\n\n    let slides = Array.from(container.children);\n    let currentIndex = 0;\n\n    function createDots() {\n      if (!dotsContainer) return;\n      dotsContainer.innerHTML = '';\n      slides.forEach((_, idx) => {\n        const dot = document.createElement('span');\n        dot.classList.add('dot');\n        if (idx === currentIndex) dot.classList.add('active');\n        dot.addEventListener('click', () => scrollToSlide(idx));\n        dotsContainer.appendChild(dot);\n      });\n    }\n\n    function scrollToSlide(index) {\n      if (index < 0) index = 0;\n      if (index >= slides.length) index = slides.length - 1;\n      const slide = slides[index];\n      if (slide) {\n        slide.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });\n        currentIndex = index;\n        updateDots();\n      }\n    }\n\n    function updateDots() {\n      const dots = document.querySelectorAll('.dot');\n      dots.forEach((dot, idx) => {\n        if (idx === currentIndex) dot.classList.add('active');\n        else dot.classList.remove('active');\n      });\n    }\n\n    function handleScroll() {\n      const scrollPosition = container.scrollLeft;\n      const slideWidth = slides[0]?.offsetWidth || 0;\n      const gap = parseFloat(getComputedStyle(container).gap) || 20;\n      const newIndex = Math.round(scrollPosition / (slideWidth + gap));\n      if (newIndex !== currentIndex && newIndex >= 0 && newIndex < slides.length) {\n        currentIndex = newIndex;\n        updateDots();\n      }\n    }\n\n    function nextSlide() {\n      scrollToSlide(currentIndex + 1);\n    }\n\n    function prevSlide() {\n      scrollToSlide(currentIndex - 1);\n    }\n\n    if (prevBtn) prevBtn.addEventListener('click', prevSlide);\n    if (nextBtn) nextBtn.addEventListener('click', nextSlide);\n    if (container) container.addEventListener('scroll', handleScroll);\n\n    createDots();\n\n    let resizeTimeout;\n    window.addEventListener('resize', () => {\n      clearTimeout(resizeTimeout);\n      resizeTimeout = setTimeout(() => {\n        slides = Array.from(container.children);\n        createDots();\n        handleScroll();\n      }, 200);\n    });\n  })();\n</script>",
