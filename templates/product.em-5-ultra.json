        "info_accordion_a3GP83": {
          "type": "info_accordion",
          "settings": {
            "heading_1": "About EM-5 Ultra",
            "content_1": "<p>EM-5 Ultra pushes Valtinsu dirt performance further with a 72V 8000W motor, 203 lb-ft torque, 4s acceleration, 56 mph top speed, and up to 75 miles of range. With three riding modes plus reverse gear, IPX6 protection, and 17” / 14” wheels, it is built for riders who want stronger speed, longer ride time, and more control across demanding dirt terrain.</p>",
            "heading_2": "What's Included",
            "content_2": "<ul><li>EM-5 Ultra Dirt Bike Body</li><li>Front Wheel</li><li>Front Fender</li><li>Number Plate</li><li>Handlebar Pad</li><li>Foot Pedals</li><li>Side Panels</li><li>Mounting Brackets</li><li>Keys</li><li>Charger</li><li>Assembly Tool Kit</li><li>Headlight Optional</li><li>Manual & Setup Support</li><li>Download User Manual</li><li>Watch Installation Video</li></ul>",
            "heading_3": "Manual & Setup Support",
            "content_3": "<ul><li>Download  <a href=\"https://cdn.shopify.com/s/files/1/0702/6999/3050/files/EM5_40V.pdf?v=1781073813\" target=\"_blank\" title=\"https://cdn.shopify.com/s/files/1/0702/6999/3050/files/EM5_40V.pdf?v=1781073813\">User Manual</a></li><li>Watch  <a href=\"https://www.youtube.com/watch?v=FKHIVyj6vms\" target=\"_blank\" title=\"https://www.youtube.com/watch?v=FKHIVyj6vms\">Installation Video</a></li></ul>"
          }
        },
