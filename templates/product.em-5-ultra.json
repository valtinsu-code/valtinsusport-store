    "faq_navee_4fpw6x": {
      "type": "faq-navee",
      "blocks": {
        "faq_item_CxKFUq": {
          "type": "faq_item",
          "settings": {
            "question": "Who is EM-5 Ultra best for?",
            "answer": "<p>EM-5 Ultra is best for riders who want Valtinsu’s strongest EM-series power, higher speed, longer range, and more control for demanding dirt riding conditions.</p>"
          }
        },
        "faq_item_Eg4UKD": {
          "type": "faq_item",
          "settings": {
            "question": "How fast does EM-5 Ultra go?",
            "answer": "<p>EM-5 Ultra has a top speed of 56 mph and three riding modes: 30 mph, 42 mph, and 56 mph. It also includes reverse gear.</p>"
          }
        },
        "faq_item_dkzhNh": {
          "type": "faq_item",
          "settings": {
            "question": "What makes EM-5 Ultra different from EM-5 Pro?",
            "answer": "<p>EM-5 Ultra has stronger key performance specs, including a 72V 8000W motor, 203 lb-ft maximum torque, 56 mph top speed, 75-mile range, and reverse gear.</p>"
          }
        },
        "faq_item_JHNm6U": {
          "type": "faq_item",
          "settings": {
            "question": "What motor does EM-5 Ultra use?",
            "answer": "<p>EM-5 Ultra uses a 72V 8000W motor with 203 lb-ft maximum torque and chain drive.</p>"
          }
        },
        "faq_item_JctdzT": {
          "type": "faq_item",
          "settings": {
            "question": "What battery does EM-5 Ultra have?",
            "answer": "<p>EM-5 Ultra uses a 72V / 25Ah Samsung battery and comes with an 84V / 5A CE-certified charger. Charging time is around 7–8 hours.</p>"
          }
        },
        "faq_item_GtUdUF": {
          "type": "faq_item",
          "settings": {
            "question": "How far can EM-5 Ultra ride?",
            "answer": "<p>EM-5 Ultra has a listed range of up to 75 miles.</p>"
          }
        },
        "faq_item_JKhzQT": {
          "type": "faq_item",
          "settings": {
            "question": "Does EM-5 Ultra have reverse gear?",
            "answer": "<p>Yes. EM-5 Ultra comes with three riding modes plus reverse gear, helping riders reposition the bike more easily at low speed.</p>"
          }
        },
        "faq_item_79nWAq": {
          "type": "faq_item",
          "settings": {
            "question": "Is EM-5 Ultra waterproof?",
            "answer": "<p>EM-5 Ultra has an IPX6 waterproof rating, which helps it handle splash-prone outdoor riding conditions. It should not be submerged or used for deep water crossing.</p>"
          }
        },
        "faq_item_Jdt9F9": {
          "type": "faq_item",
          "settings": {
            "question": "What is the seat height of EM-5 Ultra?",
            "answer": "<p>EM-5 Ultra has a 31.5 in seat height, with 17” front and 14” rear wheels.</p>"
          }
        },
        "faq_item_Ew8Jiw": {
          "type": "faq_item",
          "settings": {
            "question": "What is the maximum load capacity?",
            "answer": "<p>EM-5 Ultra supports a maximum load capacity of 287 lbs.</p>"
          }
        },
        "faq_item_4EzLah": {
          "type": "faq_item",
          "settings": {
            "question": "Should I choose EM-5 Pro, EM-5 Ultra, or EM23?",
            "answer": "<p>Choose EM-5 Pro if you want strong adult-ready dirt performance with a balanced setup. Choose EM-5 Ultra if you want higher voltage, stronger torque, faster speed, longer range, and reverse gear.Choose EM23 if you prefer a larger 19” / 17” wheel setup and a bigger open-ground riding feel.</p>"
          }
        }
      },
