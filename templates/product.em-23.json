        "info_accordion_a3GP83": {
          "type": "info_accordion",
          "settings": {
            "heading_1": "About EM23",
            "content_1": "<p>EM23 brings a bigger dirt-bike feel to Valtinsu’s electric lineup — with 184 lb-ft torque, 4s acceleration, 43.5 mph top speed, a 60V / 27Ah battery, and large 19” / 17” wheels for more confident open-ground riding.</p>",
            "heading_2": "What's Included",
            "content_2": "<ul><li>EM23 Dirt Bike Body</li><li>Front Wheel</li><li>Front Fender</li><li>Number Plate</li><li>Handlebar Pad</li><li>Foot Pedals</li><li>Side Panels</li><li>Mounting Brackets</li><li>Keys</li><li>Charger</li><li>Assembly Tool Kit</li><li>Headlight Optional</li></ul>",
            "heading_3": "Manual & Setup Support",
            "content_3": "<ul><li>Download  <a href=\"https://cdn.shopify.com/s/files/1/0702/6999/3050/files/EM-23.pdf?v=1781073850\" target=\"_blank\" title=\"https://cdn.shopify.com/s/files/1/0702/6999/3050/files/EM-23.pdf?v=1781073850\">User Manual</a></li><li>Watch  <a href=\"https://youtu.be/VaT_8tTBWHU?si=sSHXDwqU71IRWiRm\" target=\"_blank\" title=\"https://youtu.be/VaT_8tTBWHU?si=sSHXDwqU71IRWiRm\">Installation Video</a></li></ul>"
          }
