    "faq_navee_4fpw6x": {
      "type": "faq-navee",
      "blocks": {
        "faq_item_hyJCc3": {
          "type": "faq_item",
          "settings": {
            "question": "Who is EM23 best for?",
            "answer": "<p>EM23 is best for 16+ riders who want a bigger electric dirt bike feel, faster launch, larger wheels, and more confidence across open-ground riding sections.</p>"
          }
        },
        "faq_item_GQGtNK": {
          "type": "faq_item",
          "settings": {
            "question": "How fast does EM23 go?",
            "answer": "<p>EM23 has a top speed of 43.5 mph and three riding modes: 16 mph, 28 mph, and 43.5 mph.</p>"
          }
        },
        "faq_item_pHeaEB": {
          "type": "faq_item",
          "settings": {
            "question": "What makes EM23 different from EM-5 Pro?",
            "answer": "<p>It has 19” / 17” wheels, 184 lb-ft torque, 4s acceleration, and a 100A controller, while EM-5 Pro focuses more on higher peak power and IPX6 splash-ready protection.</p>"
          }
        },
        "faq_item_LB48JE": {
          "type": "faq_item",
          "settings": {
            "question": "What motor does EM23 use?",
            "answer": "<p>EM23 uses a 60V 4000W geared motor with 184 lb-ft maximum torque and chain drive.</p>"
          }
        },
        "faq_item_YPLptH": {
          "type": "faq_item",
          "settings": {
            "question": "What battery does EM23 have?",
            "answer": "<p>EM23 uses a 60V / 27Ah battery and comes with a 67.2V / 5A CE-certified charger. Charging time is around 6–7 hours.</p>"
          }
        },
        "faq_item_EM3nVe": {
          "type": "faq_item",
          "settings": {
            "question": "Is EM23 waterproof?",
            "answer": "<p>EM23 has an IPX4 waterproof rating, which helps support outdoor riding in splash-prone conditions. It should not be submerged or used for deep water crossing.</p>"
          }
        },
        "faq_item_hTRPQB": {
          "type": "faq_item",
          "settings": {
            "question": "What is the seat height of EM23?",
            "answer": "<p>EM23 has a 31.9 in seat height, with 19” front and 17” rear wheels.</p>"
          }
        },
        "faq_item_UDxbkY": {
          "type": "faq_item",
          "settings": {
            "question": "Should I choose EM-5, EM-5 Pro, or EM23?",
            "answer": "<p>Choose EM-5 if you want a more approachable first electric dirt bike. Choose EM-5 Pro if you want higher peak power and stronger adult-ready performance. Choose EM23 if you want bigger wheels, faster acceleration, higher torque, and a larger open-ground riding feel.</p>"
          }
        }
