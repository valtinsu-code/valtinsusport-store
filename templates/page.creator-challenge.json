      "blocks": {
        "faq_item_LxBUMX": {
          "type": "faq_item",
          "settings": {
            "question": "How many videos can I submit each month?",
            "answer": "<p>You may submit up to 3 different videos per month. Each video can only be submitted once.</p>"
          }
        },
        "faq_item_JEA6rh": {
          "type": "faq_item",
          "settings": {
            "question": "When will I receive my reward?",
            "answer": "<p>Qualified submissions are reviewed monthly. Rewards are paid after Valtinsu verifies your video link, view count, and analytics screenshot.</p>"
          }
        },
        "faq_item_btYm3w": {
          "type": "faq_item",
          "settings": {
            "question": "What kind of video is eligible?",
            "answer": "<p>Eligible videos must be original, public, and clearly feature a Valtinsu bike or product. Riding videos, reviews, unboxings, and lifestyle videos are welcome.</p>"
          }
        },
        "faq_item_ecPhMj": {
          "type": "faq_item",
          "settings": {
            "question": "What screenshot do I need to upload?",
            "answer": "<p>Please upload a screenshot from your platform analytics showing the video views, account name, and video performance data.</p>"
          }
        },
        "faq_item_rgJ6zq": {
          "type": "faq_item",
          "settings": {
            "question": "Can I join if I am already sponsored by Valtinsu?",
            "answer": "<p>Sponsored riders, paid campaign participants, or creators under a separate agreement may not be eligible for this challenge unless approved by Valtinsu.</p>"
          }
        },
        "faq_item_9pfG4q": {
          "type": "faq_item",
          "settings": {
            "question": "Can Valtinsu use my video after I submit it?",
            "answer": "<p>Yes. By submitting your video, you grant Valtinsu permission to use, repost, edit, and share the content for marketing and promotional purposes.</p>"
          }
        }
      },
