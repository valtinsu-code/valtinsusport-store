    "faq_navee_NTaHXP": {
      "type": "faq-navee",
      "blocks": {
        "faq_item_FaR6Fb": {
          "type": "faq_item",
          "settings": {
            "question": "Are the Green and Black versions different?",
            "answer": "<p>No. Both colorways share the same EM-5 Pro power, torque, suspension, wheel setup, and ride system.</p>"
          }
        },
        "faq_item_kDcQJt": {
          "type": "faq_item",
          "settings": {
            "question": "Who is EM-5 Pro best for?",
            "answer": "<p>EM-5 Pro is best for adult riders aged 18+ who want stronger launch, higher speed, and a more serious electric dirt bike feel.</p>"
          }
        },
        "faq_item_D8WBDA": {
          "type": "faq_item",
          "settings": {
            "question": "How fast does EM-5 Pro go?",
            "answer": "<p>EM-5 Pro has a top speed of 52 MPH and three riding modes: 26 MPH, 40 MPH, and 52 MPH.</p>"
          }
        },
        "faq_item_dY8Lhf": {
          "type": "faq_item",
          "settings": {
            "question": "What motor does EM-5 Pro use?",
            "answer": "<p>EM-5 Pro uses a 60V 5600W geared motor with 177 lb-ft maximum torque.</p>"
          }
        },
        "faq_item_p7pmKX": {
          "type": "faq_item",
          "settings": {
            "question": "Is EM-5 Pro waterproof?",
            "answer": "<p>EM-5 Pro has an IPX6 waterproof rating for splash-prone outdoor riding conditions. It should not be submerged or used for deep water crossing.</p>"
          }
        },
        "faq_item_kGeVp9": {
          "type": "faq_item",
          "settings": {
            "question": "Should I choose EM-5 or EM-5 Pro?",
            "answer": "<p>Choose EM-5 if you want a more approachable first dirt bike. Choose EM-5 Pro if you want stronger launch, higher torque, faster speed, and a bigger adult-ready ride.</p>"
          }
        }
      },
