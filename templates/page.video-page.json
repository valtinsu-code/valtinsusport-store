aria-selected=\"false\" aria-controls=\"vs-render-shorts\" data-tab=\"shorts\">Shorts</button>\n      <button class=\"vs-tab\"           role=\"tab\" aria-selected=\"false\" aria-controls=\"vs-render-review\" data-tab=\"review\">Reviews</button>\n    </div>\n  </nav>\n\n  <!-- ★ GRID AREA ★ -->\n  <div class=\"vs-grid-wrap vs-center vs-padx\">\n    <div id=\"vs-render-all\"    class=\"vs-grid-all\"    role=\"tabpanel\" aria-label=\"All Videos\"></div>\n    <div id=\"vs-render-trail\"  class=\"vs-grid-3       vs-panel-hidden\" role=\"tabpanel\" aria-label=\"Trail Rides\" hidden></div>\n    <div id=\"vs-render-shorts\" class=\"vs-grid-shorts  vs-panel-hidden\" role=\"tabpanel\" aria-label=\"Shorts\" hidden></div>\n    <div id=\"vs-render-review\" class=\"vs-grid-3       vs-panel-hidden\" role=\"tabpanel\" aria-label=\"Reviews\" hidden></div>\n  </div>\n\n  <!-- ★ SUBSCRIBE BANNER ★ -->\n  <section class=\"vs-sub\" aria-label=\"Subscribe to VALTINSU on YouTube\">\n    <div class=\"vs-sub-inner\">\n      <h2>More Rides Drop <span>Weekly</span></h2>\n      <p>Subscribe on YouTube for trail runs, honest reviews &amp; behind-the-scenes builds</p>\n      <a href=\"https://www.youtube.com/@valtinsu-dirtbike\"\n         target=\"_blank\"\n         rel=\"noopener noreferrer\"\n         class=\"vs-yt-btn\"\n         aria-label=\"Subscribe to VALTINSU on YouTube (opens in new tab)\">\n        <svg width=\"20\" height=\"14\" viewBox=\"0 0 20 14\" fill=\"none\" aria-hidden=\"true\">\n          <path d=\"M19.58 2.19A2.52 2.52 0 0017.83.43C16.28 0 10 0 10\n                   0S3.72 0 2.17.43A2.52 2.52 0 00.42 2.19C0 3.74 0 7 0\n                   7s0 3.26.42 4.81a2.52 2.52 0 001.75 1.76C3.72 14 10 14\n                   10 14s6.28 0 7.83-.43a2.52 2.52 0 001.75-1.76C20 10.26\n                   20 7 20 7s0-3.26-.42-4.81zM8 10V4l5.2 3L8 10z\"\n                fill=\"white\"/>\n        </svg>\n        Subscribe on YouTube\n      </a>\n      <div class=\"vs-sub-pill\" aria-label=\"New content every week\">New rides every week</div>\n    </div>\n  </section>\n\n</div><!-- /#vs-root -->\n\n<!-- ★ MODAL ★ -->\n<div class=\"vs-modal\"\n     id=\"vsModal\"\n     role=\"dialog\"\n     aria-modal=\"true\"\n     aria-labelledby=\"vsModalTitle\"\n     tabindex=\"-1\">\n  <div class=\"vs-modal-box\">\n    <div class=\"vs-modal-hd\">\n      <h3 class=\"vs-modal-title\" id=\"vsModalTitle\">—</h3>\n      <button class=\"vs-modal-close\"\n              id=\"vsModalCloseBtn\"\n              aria-label=\"Close video\">✕</button>\n    </div>\n    <div class=\"vs-modal-video vs-land\" id=\"vsModalVideo\">\n      <iframe id=\"vsModalIframe\"\n              src=\"\"\n              title=\"VALTINSU Video\"\n              allow=\"autoplay; encrypted-media\"\n              allowfullscreen\n              loading=\"lazy\"></iframe>\n    </div>\n  </div>\n</div>\n\n<script>\n(function () {\n  'use strict';\n\n  /* ══════════════════════════════════════════\n     VIDEO DATA — edit here, rest auto-updates\n     ══════════════════════════════════════════ */\n  var VIDEO_DATA = {\n\n    trail: [\n      {\n        vid: 'lcTqgx70wgM',\n        title: 'Fun Off the Line, Wants to Be Tuned — VALTINSU EM-5 Review',\n        orient: 'land',\n        cat: 'Trail Ride',\n        cardTitle: 'Fun Off the Line, Wants to Be Tuned',\n        meta: ['4K', '16:54', 'EM-5']\n      },\n      {\n        vid: 'a5DtTshG0wE',\n        title: 'The E-BIKE Everyone Will Want in 2026!!',\n        orient: 'land',\n        cat: 'Performance',\n        cardTitle: 'The E-BIKE Everyone Will Want in 2026!!',\n        meta: ['4K', '3:13', 'EM-5']\n      },\n      {\n        vid: '8dUeYbIr7ss',\n        title: 'How Fun is This? VALTINSU EM-5 Electric Dirt Bike Review',\n        orient: 'land',\n        cat: 'Performance',\n        cardTitle: 'How Fun is This? Full EM-5 Review',\n        meta: ['4K', '24:44', 'EM-5']\n      },\n      {\n        vid: 'NvC2a_Seo4g',\n        title: 'This Electric Dirt Bike DOMINA