6',\n        orient: 'land',\n        cat: 'Review',\n        cardTitle: 'Worth It? 35MPH!',\n        meta: ['HD', '6:28', 'EM-5']\n      },\n      {\n        vid: 'LuuAvPSpBPg',\n        title: 'This Alibaba Electric Dirt Bike Costs Less Than an iPhone 17',\n        orient: 'land',\n        cat: 'Review',\n        cardTitle: 'Costs Less Than an iPhone 17?',\n        meta: ['HD', '15:29', 'EM-5']\n      },\n      {\n        vid: 'B9Md1MvTusM',\n        title: 'Unboxing E-Bike Valtinsu EM5',\n        orient: 'land',\n        cat: 'Comparison',\n        cardTitle: 'Unboxing E-Bike Valtinsu EM5',\n        meta: ['4K', '4:28']\n      },\n      {\n        vid: 'i5Iu71n8KuE',\n        title: 'Is the VALTINSU EM-5 Worth It in 2026?',\n        orient: 'land',\n        cat: 'Comparison',\n        cardTitle: 'Is the EM-5 Worth It in 2026?',\n        meta: ['4K', '3:46']\n      },\n      {\n        vid: 'oZHBlC38ZZY',\n        title: 'Is the VALTINSU EM-5 a Tuttio / Yozma Killer?',\n        orient: 'land',\n        cat: 'Comparison',\n        cardTitle: 'A Tuttio / Yozma Killer?',\n        meta: ['HD', '23:04']\n      }\n    ]\n  };\n\n  /* ── Play icon ── */\n  var PLAY_SVG = '<svg width=\"12\" height=\"14\" viewBox=\"0 0 12 14\" fill=\"white\" aria-hidden=\"true\">'\n               + '<path d=\"M0 0l12 7L0 14V0z\"/></svg>';\n\n  /* ── Build card HTML ── */\n  function buildCard(item) {\n    var isPort    = item.orient === 'port';\n    var thumbCls  = isPort ? 'vs-thumb-port' : 'vs-thumb-land';\n    var thumbUrl  = 'https://img.youtube.com/vi/' + item.vid + '/sddefault.jpg';\n    var metaHtml  = item.meta.map(function (m, i) {\n      return (i > 0 ? '<span class=\"vs-dot\" aria-hidden=\"true\"></span>' : '')\n           + '<span>' + escHtml(m) + '</span>';\n    }).join('');\n    var safeTitle = escHtml(item.title);\n    var safeCard  = escHtml(item.cardTitle);\n    var safeCat   = escHtml(item.cat);\n\n    return '<article class=\"vs-card\"'\n         + ' role=\"button\"'\n         + ' tabindex=\"0\"'\n         + ' data-vid=\"' + item.vid + '\"'\n         + ' data-title=\"' + safeTitle + '\"'\n         + ' data-orient=\"' + item.orient + '\"'\n         + ' aria-label=\"Play: ' + safeCard + '\">'\n         + '<div class=\"' + thumbCls + '\">'\n         + '<img src=\"' + thumbUrl + '\"'\n         + ' alt=\"' + safeCard + ' — VALTINSU video thumbnail\"'\n         + ' loading=\"lazy\" width=\"' + (isPort ? '360' : '640') + '\"'\n         + ' height=\"' + (isPort ? '640' : '360') + '\">'\n         + '<div class=\"vs-play-mask\" aria-hidden=\"true\">'\n         + '<div class=\"vs-play-btn\">' + PLAY_SVG + '</div>'\n         + '</div></div>'\n         + '<div class=\"vs-card-info\">'\n         + '<p class=\"vs-card-cat\">' + safeCat + '</p>'\n         + '<h3 class=\"vs-card-title\">' + safeCard + '</h3>'\n         + '<div class=\"vs-card-meta\">' + metaHtml + '</div>'\n         + '</div></article>';\n  }\n\n  /* ── Group label for ALL tab ── */\n  function buildGroupLabel(text) {\n    return '<div class=\"vs-group-label\" aria-hidden=\"true\">'\n         + '<span class=\"vs-group-label-text\">' + escHtml(text) + '</span>'\n         + '<span class=\"vs-group-label-line\"></span>'\n         + '</div>';\n  }\n\n  /* ── Simple HTML escape ── */\n  function escHtml(str) {\n    return String(str)\n      .replace(/&/g,'&amp;')\n      .replace(/</g,'&lt;')\n      .replace(/>/g,'&gt;')\n      .replace(/\"/g,'&quot;');\n  }\n\n  /* ── Render a single panel ── */\n  function renderPanel(id, items) {\n    var el = document.getElementById(id);\n    if (el) el.innerHTML = items.map(buildCard).join('');\n  }\n\n  /* ── Render ALL tab ── */\n  function renderAll() {\n    var el = document.getElementById('vs-render-all');\n    if (!el) return;\n    var groups = [\n      { label: 'Trail Rides', key: 'trail'  },\n      { label: 'Shorts',      key: 'shorts' },\n      { label: 'Reviews',     key: 'review' }\n    ];\n    el.innerHTML = groups.map(function (g) {\n      var items = VIDEO_DATA[g.key];\n      return items && items.length\n        ? buildGroupLabel(g.label) + items.map(buildCard).join('')\n        : '';\n    }).join('');\n  }\n\n  /* ── Init ── */\n  renderAll();\n  renderPanel('vs-render-trail',  VIDEO_DATA.trail);\n  renderPanel('vs-render-shorts', VIDEO_DATA.shorts);\n  renderPanel('vs-render-review', VIDEO_DATA.review);\n\n  /* ── Tab switching (delegated) ── */\n  var tabsEl = document.querySelector('.vs-tabs-inner');\n  if (tabsEl) {\n    tabsEl.addEventListener('click', switchTab);\n    tabsEl.addEventListener('keydown', function (e) {\n      if (e.key === 'Enter' || e.key === ' ') {\n        switchTab(e);\n        e.preventDefault();\n      }\n    });\n  }\n\n  function switchTab(e) {\n    var btn = e.target.closest('.vs-tab');\n    if (!btn) return;\n    var tab = btn.getAttribute('data-tab');\n\n    /* Update tab styles + ARIA */\n    document.querySelectorAll('#vs-root .vs-tab').forEach(function (b) {\n      var active = b === btn;\n      b.classList.toggle('vs-active', active);\n      b.setAttribute('aria-selected', active ? 'true' : 'false');\n    });\n\n    /* Show/hide panels */\n    var map = {\n      all:    'vs-render-all',\n      trail:  'vs-render-trail',\n      shorts: 'vs-render-shorts',\n      review: 'vs-render-review'\n    };\n    Object.keys(map).forEach(function (k) {\n      var el = document.getElementById(map[k]);\n      if (!el) return;\n      var show = k === tab;\n      el.classList.toggle('vs-panel-hidden', !show);\n      if (show) { el.removeAttribute('hidden'); }\n      else       { el.setAttribute('hidden', ''); }\n    });\n  }\n\n  /* ── Card click / keyboard (delegated) ── */\n  var root = document.getElementById('vs-root');\n  root.addEventListener('click', handleCardActivate);\n  root.addEventListener('keydown', function (e) {\n    if (e.key === 'Enter' || e.key === ' ') {\n      handleCardActivate(e);\n      e.preventDefault();\n    }\n  });\n\n  function handleCardActivate(e) {\n    var card = e.target.closest('.vs-card');\n    if (!card) return;\n    var vid   = card.getAttribute('data-vid');\n    var title = card.getAttribute('data-title');\n    var ori   = card.getAttribute('data-orient');\n    if (vid) openModal(vid, title, ori);\n  }\n\n  /* ── Featured video inline play ── */\n  window.vsPlayFeatured = function (el) {\n    var vid = el.getAttribute('data-vid');\n    if (!vid) return;\n    var iframe = el.querySelector('iframe');\n    iframe.src = 'https://www.youtube.com/embed/' + vid\n               + '?autoplay=1&rel=0&modestbranding=1';\n    el.classList.add('playing');\n    el.setAttribute('aria-label', 'Video playing');\n  };\n\n  /* ── Open modal ── */\n  function openModal(vid, title, ori) {\n    var modal = document.getElementById('vsModal');\n    document.getElementById('vsModalIframe').src =\n      'https://www.youtube.com/embed/' + vid\n      + '?autoplay=1&rel=0&modestbranding=1';\n    document.getElementById('vsModalTitle').textContent = title || '';\n    document.getElementById('vsModalVideo').className =\n      'vs-modal-video ' + (ori === 'port' ? 'vs-port' : 'vs-land');\n    modal.classList.add('vs-open');\n    document.body.style.overflow = 'hidden';\n    /* Focus trap: focus modal for screen readers */\n    modal.focus();\n  }\n\n  /* ── Close modal ── */\n  function closeModal() {\n    document.getElementById('vsModalIframe').src = '';\n    document.getElementById('vsModal').classList.remove('vs-open');\n    document.body.style.overflow = '';\n  }\n\n  document.getElementById('vsModal').addEventListener('click', function (e) {\n    if (e.target === this) closeModal();\n  });\n  document.getElementById('vsModalCloseBtn').addEventListener('click', closeModal);\n  document.addEventListener('keydown', function (e) {\n    if (e.key === 'Escape') closeModal();\n  });\n\n})();\n</script>",
