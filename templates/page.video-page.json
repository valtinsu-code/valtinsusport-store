        "custom_liquid": "{% comment %}\n════════════════════════════════════════════════════════════════\n  VALTINSU — VIDEO PAGE SECTION  (Optimized v2)\n  · SEO: semantic HTML5, meta-friendly structure, alt text, schema\n  · Mobile-first responsive with improved touch targets\n  · Performance: lazy loading, reduced layout shifts\n  · Accessibility: ARIA roles, keyboard nav, focus states\n════════════════════════════════════════════════════════════════\n{% endcomment %}\n\n<!-- SEO: Schema.org VideoObject markup for Google rich results -->\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"VideoGallery\",\n  \"name\": \"VALTINSU Electric Dirt Bike — Ride Videos\",\n  \"description\": \"Watch VALTINSU EM-5 electric dirt bike trail rides, reviews, and shorts. Raw footage on real terrain — zero emissions, full send.\",\n  \"url\": \"https://valtinsusport.com/pages/videos\",\n  \"publisher\": {\n    \"@type\": \"Organization\",\n    \"name\": \"VALTINSU\",\n    \"url\": \"https://valtinsusport.com\",\n    \"sameAs\": \"https://www.youtube.com/@valtinsu-dirtbike\"\n  }\n}\n</script>\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,600;0,700;0,800;1,300&display=swap\" rel=\"stylesheet\">\n\n<style>\n/* ─────────────────────────────────────────────\n   SHOPIFY OVERRIDES\n───────────────────────────────────────────── */\n#vs-root,\n#vs-root .shopify-section,\n#vs-root .page-width,\n#vs-root .container,\n#vs-root main {\n  max-width: 100% !important;\n  padding-left: 0 !important;\n  padding-right: 0 !important;\n  margin-left: 0 !important;\n  margin-right: 0 !important;\n}\n\n/* ─────────────────────────────────────────────\n   DESIGN TOKENS\n───────────────────────────────────────────── */\n#vs-root {\n  --vs-accent:    #e8380d;\n  --vs-accent2:   #ff6b35;\n  --vs-bg:        #080808;\n  --vs-panel:     #111111;\n  --vs-panel2:    #161616;\n  --vs-border:    #1e1e1e;\n  --vs-dim:       #252525;\n  --vs-white:     #f2ede7;\n  --vs-text:      #c4c0b8;\n  --vs-muted:     #555555;\n  --vs-page-px:   clamp(20px, 5vw, 80px);\n  --vs-page-max:  1300px;\n  --vs-radius:    2px;\n  --vs-trans:     0.22s ease;\n}\n\n/* ─────────────────────────────────────────────\n   RESET\n───────────────────────────────────────────── */\n#vs-root *, #vs-root *::before, #vs-root *::after {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n#vs-root {\n  background: var(--vs-bg);\n  color: var(--vs-text);\n  font-family: 'Montserrat', sans-serif;\n  overflow-x: hidden;\n  width: 100%;\n  max-width: 100% !important;\n  display: block;\n  -webkit-font-smoothing: antialiased;\n}\n\n/* ─────────────────────────────────────────────\n   FOCUS (accessibility)\n───────────────────────────────────────────── */\n#vs-root :focus-visible {\n  outline: 2px solid var(--vs-accent);\n  outline-offset: 3px;\n}\n\n/* ─────────────────────────────────────────────\n   LAYOUT HELPERS\n───────────────────────────────────────────── */\n.vs-padx {\n  padding-left:  var(--vs-page-px) !important;\n  padding-right: var(--vs-page-px) !important;\n}\n.vs-center {\n  max-width: var(--vs-page-max) !important;\n  margin-left:  auto !important;\n  margin-right: auto !important;\n  width: 100% !important;\n}\n\n/* ═══════════════════════════════════════════\n   HERO\n═══════════════════════════════════════════ */\n.vs-hero {\n  position: relative;\n  padding-top:    clamp(56px, 9vw, 110px);\n  padding-bottom: clamp(48px, 7vw, 90px);\n  overflow: hidden;\n  width: 100%;\n}\n.vs-hero-bg {\n  position: absolute;\n  inset: 0;\n  background:\n    radial-gradient(ellipse 80% 65% at 50% -5%,\n      rgba(232,56,13,0.12) 0%, transparent 68%),\n    linear-gradient(180deg, #0d0d0d 0%, var(--vs-bg) 100%);\n}\n.vs-hero-bg::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: repeating-linear-gradient(\n    -45deg,\n    transparent 0px, transparent 18px,\n    rgba(255,255,255,0.012) 18px, rgba(255,255,255,0.012) 19px\n  );\n  pointer-events: none;\n}\n/* Decorative accent bar */\n.vs-hero-bg::before {\n  content: '';\n  position: absolute;\n  top: 0; left: 0; right: 0;\n  height: 3px;\n  background: linear-gradient(90deg,\n    transparent 0%, var(--vs-accent) 30%,\n    var(--vs-accent2) 60%, transparent 100%\n  );\n}\n.vs-hero-inner {\n  position: relative;\n  z-index: 1;\n}\n.vs-hero-label {\n  font-size: 10px;\n  letter-spacing: 0.38em;\n  color: var(--vs-accent);\n  text-transform: uppercase;\n  margin-bottom: 20px;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n.vs-hero-label::before {\n  content: '';\n  display: block;\n  width: 28px;\n  height: 1px;\n  background: var(--vs-accent);\n  flex-shrink: 0;\n}\n.vs-h1 {\n  font-weight: 800;\n  font-size: clamp(48px, 10.5vw, 128px);\n  line-height: 0.88;\n  text-transform: uppercase;\n  color: var(--vs-white);\n  letter-spacing: -0.02em;\n}\n.vs-h1 .vs-stroke {\n  color: transparent;\n  -webkit-text-stroke: 1.5px var(--vs-accent);\n  text-stroke: 1.5px var(--vs-accent);\n}\n.vs-hero-sub {\n  margin-top: 26px;\n  font-style: italic;\n  font-weight: 300;\n  font-size: clamp(15px, 2vw, 20px);\n  letter-spacing: 0.06em;\n  color: var(--vs-muted);\n  max-width: 500px;\n  line-height: 1.55;\n}\n/* Stats row */\n.vs-stats {\n  display: flex;\n  flex-wrap: wrap;\n  gap: clamp(18px, 4vw, 52px);\n  margin-top: clamp(36px, 5.5vw, 60px);\n}\n.vs-stat {\n  border-left: 2px solid var(--vs-accent);\n  padding-left: 14px;\n}\n.vs-stat-num {\n  font-weight: 800;\n  font-size: clamp(26px, 3.8vw, 42px);\n  color: var(--vs-white);\n  line-height: 1;\n}\n.vs-stat-num small {\n  font-size: 0.52em;\n  color: var(--vs-accent);\n  letter-spacing: 0.1em;\n}\n.vs-stat-label {\n  font-size: 9px;\n  letter-spacing: 0.25em;\n  color: var(--vs-muted);\n  text-transform: uppercase;\n  margin-top: 5px;\n}\n\n/* ─── Divider ─── */\n.vs-divider {\n  height: 1px;\n  background: linear-gradient(\n    90deg,\n    transparent 0%,\n    var(--vs-border) 20%,\n    var(--vs-dim) 50%,\n    var(--vs-border) 80%,\n    transparent 100%\n  );\n  margin: 0 clamp(20px, 5vw, 70px);\n}\n\n/* ═══════════════════════════════════════════\n   FEATURED VIDEO\n═══════════════════════════════════════════ */\n.vs-featured {\n  padding-top:    clamp(44px, 6vw, 84px);\n  padding-bottom: clamp(56px, 8vw, 110px);\n  width: 100%;\n}\n.vs-section-hd {\n  display: flex;\n  align-items: flex-end;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 10px;\n  margin-bottom: clamp(18px, 3vw, 32px);\n}\n.vs-section-tag {\n  font-size: 9px;\n  letter-spacing: 0.4em;\n  color: var(--vs-accent);\n  text-transform: uppercase;\n  margin-bottom: 7px;\n}\n.vs-section-title {\n  font-weight: 800;\n  font-size: clamp(26px, 4vw, 46px);\n  text-transform: uppercase;\n  color: var(--vs-white);\n  letter-spacing: 0.01em;\n  line-height: 1;\n}\n.vs-section-count {\n  font-size: 10px;\n  color: var(--vs-muted);\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n}\n\n/* Featured frame */\n.vs-featured-wrap {\n  position: relative;\n  aspect-ratio: 16 / 9;\n  background: var(--vs-panel);\n  overflow: hidden;\n  clip-path: polygon(\n    0 0, calc(100% - 22px) 0,\n    100% 22px, 100% 100%,\n    22px 100%, 0 calc(100% - 22px)\n  );\n  border: 1px solid var(--vs-border);\n  cursor: pointer;\n  /* Prevent CLS */\n  min-height: 200px;\n}\n.vs-featured-wrap:hover { border-color: var(--vs-accent); }\n.vs-featured-wrap:focus-visible {\n  outline: 2px solid var(--vs-accent);\n  outline-offset: 4px;\n}\n\n.vs-featured-wrap iframe {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  border: none;\n  display: none;\n}\n.vs-featured-wrap.playing iframe   { display: block; }\n.vs-featured-wrap.playing .vs-featured-thumb,\n.vs-featured-wrap.playing .vs-feat-overlay,\n.vs-featured-wrap.playing .vs-feat-play { display: none; }\n\n.vs-featured-thumb {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform 0.5s ease;\n}\n.vs-featured-wrap:hover .vs-featured-thumb { transform: scale(1.04); }\n\n.vs-feat-overlay {\n  position: absolute;\n  bottom: 0; left: 0; right: 0;\n  background: linear-gradient(to top,\n    rgba(0,0,0,0.92) 0%,\n    rgba(0,0,0,0.55) 55%,\n    transparent 100%\n  );\n  padding: clamp(28px,5vw,52px) clamp(18px,3vw,36px) clamp(18px,2.5vw,30px);\n}\n.vs-feat-badge {\n  display: inline-block;\n  background: var(--vs-accent);\n  font-size: 9px;\n  letter-spacing: 0.3em;\n  text-transform: uppercase;\n  color: #fff;\n  padding: 4px 11px;\n  margin-bottom: 10px;\n  clip-path: polygon(5px 0%, 100% 0%, calc(100% - 5px) 100%, 0% 100%);\n  font-weight: 700;\n}\n.vs-feat-title {\n  font-weight: 800;\n  font-size: clamp(17px, 2.8vw, 32px);\n  color: #fff;\n  text-transform: uppercase;\n  letter-spacing: 0.02em;\n  line-height: 1.15;\n}\n.vs-feat-meta {\n  font-size: 12px;\n  color: rgba(255,255,255,0.48);\n  letter-spacing: 0.1em;\n  margin-top: 7px;\n}\n/* Play button */\n.vs-feat-play {\n  position: absolute;\n  top: 50%; left: 50%;\n  transform: translate(-50%, -50%);\n  width: clamp(60px, 8vw, 88px);\n  height: clamp(60px, 8vw, 88px);\n  background: rgba(232,56,13,0.88);\n  border: 2px solid rgba(255,255,255,0.55);\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: transform var(--vs-trans), background var(--vs-trans),\n              box-shadow var(--vs-trans);\n  box-shadow: 0 0 0 0 rgba(232,56,13,0);\n}\n.vs-featured-wrap:hover .vs-feat-play,\n.vs-featured-wrap:focus-visible .vs-feat-play {\n  transform: translate(-50%, -50%) scale(1.14);\n  background: var(--vs-accent);\n  box-shadow: 0 0 32px rgba(232,56,13,0.35);\n}\n.vs-feat-play svg { margin-left: 5px; }\n\n/* ═══════════════════════════════════════════\n   TABS\n═══════════════════════════════════════════ */\n.vs-tabs-outer {\n  width: 100%;\n  border-bottom: 1px solid var(--vs-border);\n  overflow-x: auto;\n  scrollbar-width: none;\n  -webkit-overflow-scrolling: touch;\n}\n.vs-tabs-outer::-webkit-scrollbar { display: none; }\n\n.vs-tabs-inner {\n  display: flex;\n  gap: 0;\n  white-space: nowrap;\n}\n.vs-tab {\n  font-family: 'Montserrat', sans-serif;\n  font-weight: 700;\n  font-size: 11px;\n  letter-spacing: 0.3em;\n  text-transform: uppercase;\n  color: var(--vs-muted);\n  background: none;\n  border: none;\n  /* Larger tap target for mobile */\n  padding: 20px clamp(20px, 4vw, 56px);\n  min-height: 56px;\n  cursor: pointer;\n  position: relative;\n  transition: color var(--vs-trans);\n  white-space: nowrap;\n  flex-shrink: 0;\n}\n.vs-tab::after {\n  content: '';\n  position: absolute;\n  bottom: -1px; left: 0; right: 0;\n  height: 2px;\n  background: var(--vs-accent);\n  transform: scaleX(0);\n  transform-origin: left;\n  transition: transform 0.28s cubic-bezier(0.4,0,0.2,1);\n}\n.vs-tab:hover  { color: var(--vs-text); }\n.vs-tab.vs-active { color: var(--vs-white); }\n.vs-tab.vs-active::after { transform: scaleX(1); }\n\n/* ═══════════════════════════════════════════\n   GRID WRAPPER\n═══════════════════════════════════════════ */\n.vs-grid-wrap {\n  padding-top:    clamp(36px, 5vw, 64px);\n  padding-bottom: clamp(56px, 8vw, 104px);\n  width: 100%;\n}\n\n/* Grid layouts */\n.vs-grid-3,\n.vs-grid-all { grid-template-columns: repeat(3, 1fr); }\n.vs-grid-shorts { grid-template-columns: repeat(4, 1fr); }\n\n.vs-grid-3,\n.vs-grid-all,\n.vs-grid-shorts {\n  display: grid;\n  gap: clamp(12px, 1.6vw, 20px);\n}\n.vs-panel-hidden { display: none !important; }\n\n/* Group label in ALL tab */\n.vs-group-label {\n  grid-column: 1 / -1;\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  padding: clamp(24px, 3.5vw, 40px) 0 clamp(8px, 1.5vw, 14px);\n  margin-top: 8px;\n}\n.vs-group-label:first-child { padding-top: 0; margin-top: 0; }\n.vs-group-label-text {\n  font-weight: 700;\n  font-size: 10px;\n  letter-spacing: 0.38em;\n  color: var(--vs-accent);\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n.vs-group-label-line {\n  flex: 1;\n  height: 1px;\n  background: linear-gradient(90deg, var(--vs-border), transparent);\n}\n\n/* ═══════════════════════════════════════════\n   VIDEO CARD\n═══════════════════════════════════════════ */\n.vs-card {\n  background: var(--vs-panel);\n  border: 1px solid var(--vs-border);\n  overflow: hidden;\n  cursor: pointer;\n  clip-path: polygon(\n    0 0, calc(100% - 10px) 0,\n    100% 10px, 100% 100%,\n    10px 100%, 0 calc(100% - 10px)\n  );\n  transition: border-color var(--vs-trans), transform var(--vs-trans),\n              box-shadow var(--vs-trans);\n  position: relative;\n  animation: vs-fadeup 0.4s ease both;\n  /* Tap highlight on mobile */\n  -webkit-tap-highlight-color: transparent;\n}\n/* Staggered entrance */\n.vs-card:nth-child(2)  { animation-delay: 0.05s; }\n.vs-card:nth-child(3)  { animation-delay: 0.10s; }\n.vs-card:nth-child(4)  { animation-delay: 0.15s; }\n.vs-card:nth-child(5)  { animation-delay: 0.20s; }\n.vs-card:nth-child(6)  { animation-delay: 0.25s; }\n.vs-card:nth-child(7)  { animation-delay: 0.30s; }\n.vs-card:nth-child(8)  { animation-delay: 0.35s; }\n@keyframes vs-fadeup {\n  from { opacity: 0; transform: translateY(20px); }\n  to   { opacity: 1; transform: translateY(0); }\n}\n.vs-card:hover {\n  border-color: var(--vs-accent);\n  transform: translateY(-4px);\n  box-shadow: 0 12px 40px rgba(232,56,13,0.08);\n}\n/* Corner accent */\n.vs-card::before {\n  content: '';\n  position: absolute;\n  top: 0; right: 0;\n  border-style: solid;\n  border-width: 0 22px 22px 0;\n  border-color: transparent var(--vs-accent) transparent transparent;\n  z-index: 2;\n  transition: border-width var(--vs-trans);\n}\n.vs-card:hover::before { border-width: 0 30px 30px 0; }\n\n/* Thumbnails */\n.vs-thumb-land {\n  position: relative;\n  aspect-ratio: 16 / 9;\n  background: var(--vs-dim);\n  overflow: hidden;\n}\n.vs-thumb-port {\n  position: relative;\n  aspect-ratio: 9 / 16;\n  background: var(--vs-dim);\n  overflow: hidden;\n}\n.vs-thumb-land img,\n.vs-thumb-port img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n  transition: transform 0.45s ease;\n  /* Prevent layout shift */\n  background: var(--vs-dim);\n}\n.vs-card:hover .vs-thumb-land img,\n.vs-card:hover .vs-thumb-port img { transform: scale(1.06); }\n\n/* Hover play mask */\n.vs-play-mask {\n  position: absolute;\n  inset: 0;\n  background: rgba(0,0,0,0.38);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  opacity: 0;\n  transition: opacity var(--vs-trans);\n}\n.vs-card:hover .vs-play-mask,\n.vs-card:focus-visible .vs-play-mask { opacity: 1; }\n.vs-play-btn {\n  width: 52px; height: 52px;\n  background: rgba(232,56,13,0.9);\n  border: 2px solid rgba(255,255,255,0.7);\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: transform var(--vs-trans), box-shadow var(--vs-trans);\n}\n.vs-card:hover .vs-play-btn {\n  transform: scale(1.12);\n  box-shadow: 0 0 28px rgba(232,56,13,0.4);\n}\n.vs-play-btn svg { margin-left: 4px; }\n\n.vs-card-info {\n  padding: clamp(10px,1.4vw,15px) clamp(12px,1.6vw,18px) clamp(13px,1.6vw,18px);\n}\n.vs-card-cat {\n  font-size: 9px;\n  letter-spacing: 0.32em;\n  color: var(--vs-accent);\n  text-transform: uppercase;\n  margin-bottom: 5px;\n  font-weight: 600;\n}\n.vs-card-title {\n  font-weight: 700;\n  font-size: clamp(13px, 1.4vw, 16px);\n  color: var(--vs-white);\n  text-transform: uppercase;\n  letter-spacing: 0.03em;\n  line-height: 1.25;\n  margin-bottom: 8px;\n  /* Prevent extra-long titles breaking layout */\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n.vs-card-meta {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 10px;\n  color: var(--vs-muted);\n  letter-spacing: 0.1em;\n  flex-wrap: wrap;\n}\n.vs-dot {\n  width: 3px; height: 3px;\n  background: var(--vs-dim);\n  border-radius: 50%;\n  flex-shrink: 0;\n}\n\n/* ═══════════════════════════════════════════\n   SUBSCRIBE BANNER\n═══════════════════════════════════════════ */\n.vs-sub {\n  background: var(--vs-panel);\n  border-top:    1px solid var(--vs-border);\n  border-bottom: 1px solid var(--vs-border);\n  padding: clamp(52px, 8vw, 90px) clamp(20px,5vw,60px);\n  text-align: center;\n  position: relative;\n  overflow: hidden;\n  width: 100%;\n}\n.vs-sub::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: radial-gradient(\n    ellipse 55% 85% at 50% 50%,\n    rgba(232,56,13,0.07) 0%, transparent 68%\n  );\n  pointer-events: none;\n}\n/* Decorative lines */\n.vs-sub::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: repeating-linear-gradient(\n    90deg,\n    transparent 0px, transparent 48px,\n    rgba(255,255,255,0.008) 48px, rgba(255,255,255,0.008) 49px\n  );\n  pointer-events: none;\n}\n.vs-sub-inner { position: relative; z-index: 1; }\n.vs-sub h2 {\n  font-weight: 800;\n  font-size: clamp(28px, 5.5vw, 56px);\n  text-transform: uppercase;\n  color: var(--vs-white);\n  letter-spacing: -0.01em;\n  line-height: 1;\n}\n.vs-sub h2 span { color: var(--vs-accent); }\n.vs-sub p {\n  margin-top: 12px;\n  color: var(--vs-muted);\n  font-size: clamp(13px, 1.4vw, 15px);\n  letter-spacing: 0.08em;\n  line-height: 1.6;\n  max-width: 480px;\n  margin-left: auto;\n  margin-right: auto;\n}\n.vs-yt-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  margin-top: 32px;\n  background: var(--vs-accent);\n  color: #fff;\n  font-family: 'Montserrat', sans-serif;\n  font-weight: 700;\n  font-size: 13px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  text-decoration: none;\n  padding: 15px 36px;\n  clip-path: polygon(9px 0%, 100% 0%, calc(100% - 9px) 100%, 0% 100%);\n  transition: background var(--vs-trans), transform var(--vs-trans),\n              box-shadow var(--vs-trans);\n  /* Minimum tap target */\n  min-height: 48px;\n}\n.vs-yt-btn:hover {\n  background: var(--vs-accent2);\n  transform: translateY(-3px);\n  color: #fff;\n  text-decoration: none;\n  box-shadow: 0 8px 28px rgba(232,56,13,0.3);\n}\n.vs-yt-btn:focus-visible {\n  outline: 2px solid #fff;\n  outline-offset: 3px;\n}\n\n/* Subscriber count pill */\n.vs-sub-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  margin-top: 16px;\n  font-size: 11px;\n  letter-spacing: 0.15em;\n  color: var(--vs-muted);\n  text-transform: uppercase;\n}\n.vs-sub-pill::before {\n  content: '';\n  display: block;\n  width: 6px; height: 6px;\n  background: var(--vs-accent);\n  border-radius: 50%;\n  animation: vs-pulse 1.6s ease-in-out infinite;\n}\n@keyframes vs-pulse {\n  0%, 100% { opacity: 1; transform: scale(1); }\n  50% { opacity: 0.5; transform: scale(0.7); }\n}\n\n/* ═══════════════════════════════════════════\n   MODAL\n═══════════════════════════════════════════ */\n.vs-modal {\n  position: fixed;\n  inset: 0;\n  background: rgba(0,0,0,0.95);\n  z-index: 99999;\n  display: none;\n  align-items: center;\n  justify-content: center;\n  padding: 16px;\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n}\n.vs-modal.vs-open { display: flex; }\n.vs-modal-box {\n  width: 100%;\n  max-width: 940px;\n  background: var(--vs-panel);\n  border: 1px solid var(--vs-border);\n  clip-path: polygon(\n    0 0, calc(100% - 16px) 0,\n    100% 16px, 100% 100%,\n    16px 100%, 0 calc(100% - 16px)\n  );\n  animation: vs-modalpop 0.2s cubic-bezier(0.34,1.56,0.64,1);\n}\n@keyframes vs-modalpop {\n  from { opacity: 0; transform: scale(0.92) translateY(12px); }\n  to   { opacity: 1; transform: scale(1) translateY(0); }\n}\n.vs-modal-hd {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 14px 20px;\n  border-bottom: 1px solid