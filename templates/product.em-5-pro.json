          "settings": {
            "question": "Who is EM-5 Pro best for?",
            "answer": "<p>EM-5 Pro is best for adult riders aged 18+ who want stronger launch, higher speed, and a more serious electric dirt bike feel than beginner-focused models.</p>"
          }
        },
        "faq_item_GQGtNK": {
          "type": "faq_item",
          "settings": {
            "question": "How fast does EM-5 Pro go?",
            "answer": "<p>EM-5 Pro has a top speed of 52 MPH and three riding modes: 26 MPH, 40 MPH, and 52 MPH.</p>"
          }
        },
        "faq_item_pHeaEB": {
          "type": "faq_item",
          "settings": {
            "question": "What motor does EM-5 Pro use?",
            "answer": "<p>EM-5 Pro uses a 60V 5600W geared motor with 177 lb-ft maximum torque.</p>"
          }
        },
        "faq_item_LB48JE": {
          "type": "faq_item",
          "settings": {
            "question": "What battery does EM-5 Pro have?",
            "answer": "<p>EM-5 Pro uses a 60V / 27Ah battery and comes with a 67.2V / 5A CE-certified charger. Charging time is around 7–8 hours.</p>"
          }
        },
        "faq_item_YPLptH": {
          "type": "faq_item",
          "settings": {
            "question": "Is EM-5 Pro waterproof?",
            "answer": "<p>EM-5 Pro has an IPX6 waterproof rating, which helps it handle splash-prone outdoor riding conditions. It should not be submerged or used for deep water crossing.</p>"
          }
        },
        "faq_item_EM3nVe": {
          "type": "faq_item",
          "settings": {
            "question": "What is the seat height of EM-5 Pro?",
            "answer": "<p>EM-5 Pro has a 31.5 in seat height, with front 17” and rear 14” wheels.</p>"
          }
        },
        "faq_item_hTRPQB": {
          "type": "faq_item",
          "settings": {
            "question": "What is the maximum load capacity?",
            "answer": "<p>EM-5 Pro supports a maximum load capacity of 287 lbs.</p>"
          }
        },
        "faq_item_UDxbkY": {
          "type": "faq_item",
          "settings": {
            "question": "Should I choose EM-5 or EM-5 Pro?",
            "answer": "<p>Choose EM-5 if you want a more approachable first dirt bike. Choose EM-5 Pro if you want stronger launch, higher torque, faster speed, and a bigger adult-ready ride.</p>"
          }
