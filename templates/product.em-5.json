      const difference = targetDate - now;\n\n      // 获取各时间节点元素\n      const daysElem = document.getElementById(\"em5-days\");\n      const hoursElem = document.getElementById(\"em5-hours\");\n      const minsElem = document.getElementById(\"em5-minutes\");\n      const secsElem = document.getElementById(\"em5-seconds\");\n\n      if (!daysElem || !hoursElem || !minsElem || !secsElem) return;\n\n      // 如果促销已结束的兜底显示\n      if (difference <= 0) {\n        daysElem.innerText = \"00\";\n        hoursElem.innerText = \"00\";\n        minsElem.innerText = \"00\";\n        secsElem.innerText = \"00\";\n        document.querySelector(\".em5-countdown-label\").innerText = \"Offer Expired\";\n        clearInterval(timerInterval);\n        return;\n      }\n\n      // 时间计算公式\n      const days = Math.floor(difference / (1000 * 60 * 60 * 24));\n      const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));\n      const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));\n      const seconds = Math.floor((difference % (1000 * 60)) / 1000);\n\n      // 补零填充（例如把 9 变成 09）\n      daysElem.innerText = days < 10 ? \"0\" + days : days;\n      hoursElem.innerText = hours < 10 ? \"0\" + hours : hours;\n      minsElem.innerText = minutes < 10 ? \"0\" + minutes : minutes;\n      secsElem.innerText = seconds < 10 ? \"0\" + seconds : seconds;\n    }\n\n    // 初始化并建立高频定时器\n    updateCountdown();\n    const timerInterval = setInterval(updateCountdown, 1000);\n  })();\n</script>"
