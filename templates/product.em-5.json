    "faq_navee_4fpw6x": {
      "type": "faq-navee",
      "blocks": {
        "faq_item_hyJCc3": {
          "type": "faq_item",
          "settings": {
            "question": "Who is EM-5 best for?",
            "answer": "<p>EM-5 is best for 13+ riders, first-time dirt riders, and riders who want a more approachable way into electric dirt biking. It is the most beginner-friendly model in the Valtinsu lineup.</p>"
          }
        },
        "faq_item_GQGtNK": {
          "type": "faq_item",
          "settings": {
            "question": "Is EM-5 good for beginners?",
            "answer": "<p>Yes. EM-5 is designed as a more approachable first dirt bike, with a 28.3 in seat height, 14” / 12” wheels, and three speed modes that let riders build confidence step by step.</p>"
          }
        },
        "faq_item_pHeaEB": {
          "type": "faq_item",
          "settings": {
            "question": "How fast does EM-5 go?",
            "answer": "<p>EM-5 has three speed modes: 22 MPH, 32 MPH, and 40 MPH. Riders can start slow and move up as they become more comfortable.</p>"
          }
        },
        "faq_item_LB48JE": {
          "type": "faq_item",
          "settings": {
            "question": "What is the rider fit for EM-5?",
            "answer": "<p>EM-5 is recommended for 13+ riders. It has a 28.3 in seat height, 243 lbs max load, 14” front wheel, 12” rear wheel, and a product size of 61.0 × 26.8 × 37.0 in.</p>"
          }
        },
        "faq_item_YPLptH": {
          "type": "faq_item",
          "settings": {
            "question": "What are the EM-5 battery and charging specs?",
            "answer": "<p>EM-5 uses a 48V / 23.4Ah battery with a 48V / 5A CE-certified charger. Charging time is around 7–8 hours.</p>"
          }
        },
        "faq_item_EM3nVe": {
          "type": "faq_item",
          "settings": {
            "question": "Can EM-5 handle outdoor dirt riding?",
            "answer": "<p>Yes. EM-5 is built with geared-motor power, chain drivetrain, front hydraulic shock absorbers, rear adjustable air suspension, off-road wheels, and IPX6 splash-ready protection for outdoor dirt conditions.</p>"
          }
        },
        "faq_item_hTRPQB": {
          "type": "faq_item",
          "settings": {
            "question": "Is EM-5 waterproof?",
            "answer": "<p>EM-5 has an IPX6 waterproof rating, which helps it handle splash-prone outdoor conditions. It should not be submerged or used for deep water crossing.</p>"
          }
        },
        "faq_item_UDxbkY": {
          "type": "faq_item",
          "settings": {
            "question": "Should I choose EM-5, EM-5 Pro, or EM23?",
            "answer": "<p>Choose EM-5 for your first real dirt ride, EM-5 Pro for harder launch and stronger performance, and EM23 for bigger wheels and more grown-up open-ground riding.</p>"
          }
        }
      },
