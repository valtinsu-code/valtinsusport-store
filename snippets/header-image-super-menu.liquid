<header-menu>
  <details id="Details-HeaderImageSuperMenu-{{ block.id }}" class="header-super-menu-details header-image-super-menu-details">
    <summary
      id="HeaderMenu-{{ link.handle }}"
      class="header__menu-item header-super-menu-trigger list-menu__item link focus-inset font-text-4"
    >
      <span
        {%- if link.child_active %}
          class="header__active-menu-item"
        {% endif %}
      >
        {{- link.title | escape -}}
      </span>
      {{- 'icon-caret.svg' | inline_asset_content -}}
    </summary>

    <div class="header-super-menu-panel header-image-super-menu-panel color-{{ section.settings.menu_color_scheme }} gradient" tabindex="-1">
      <div class="header-image-super-menu-panel__inner">
        {%- for index in (1..3) -%}
          {%- liquid
            assign image_key = 'card_' | append: index | append: '_image'
            assign title_key = 'card_' | append: index | append: '_title'
            assign text_key = 'card_' | append: index | append: '_text'
            assign url_key = 'card_' | append: index | append: '_url'
            assign card_image = block.settings[image_key]
            assign card_title = block.settings[title_key]
            assign card_text = block.settings[text_key]
            assign card_url = block.settings[url_key] | default: link.url
          -%}

          <a href="{{ card_url }}" class="header-image-super-menu-card" target="_blank">
            {%- if card_image != blank -%}
              {{
                card_image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '360, 540, 720, 900',
                  class: 'header-image-super-menu-card__image',
                  alt: card_title
              }}
            {%- endif -%}
            {% comment %} <span class="header-image-super-menu-card__shade"></span> {% endcomment %}
            <span class="header-image-super-menu-card__content">
              {%- if card_title != blank -%}
                <span class="header-image-super-menu-card__title font-h3">{{ card_title | escape }}</span>
              {%- endif -%}
              {%- if card_text != blank -%}
                <span class="header-image-super-menu-card__text font-text-3">{{ card_text | escape }}</span>
              {%- endif -%}
            </span>
            <span class="header-image-super-menu-card__arrow" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="18" viewBox="0 0 10 18" fill="none">
                <path d="M1.25 0.75L9.25 8.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M1.25 16.75L9.25 8.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </details>
</header-menu>
