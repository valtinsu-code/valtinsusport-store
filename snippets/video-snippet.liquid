 {{ 'video-section.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* .section-{{ section_id }}-padding {
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
  } */
  .shopify-{{section_id}}-video-play-svg-wrapper{
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    left: 50%;
    top: 40%;
    transform: translate(-50% , -50%);
    width: 52px;
    height: 52px;
    background: rgba(255, 255, 255, 0.23);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px); 
    border-radius: 6px;
    color: #ffffff;
    overflow: hidden;
    & svg{
      width:20px;
      height: 20px;
    }
  }
  @media( max-width: 767px ){
    .shopify-{{section_id}}-video-play-svg-wrapper{
      width: 68px;
      height: 68px;
    }
  }

  @media( max-width: 480px ){
    .shopify-{{section_id}}-video-play-svg-wrapper{
      width: 40px;
      height: 40px;
      & svg{
      width:12px;
      height: 12px;
    }
    }
  }
  .shopify-{{section_id}} .deferred-media__poster{
    border-radius: 15px;
  }
  .{{  section_id }}-video-full-btn{
    height: auto !important;
    width: 100%;
    aspect-ratio: 352 / 529;
  }
  /* @media screen and (max-width: 767px) {
    .section-{{ section_id }}-padding {
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
    }
  }
  @media (min-width: 458px) and (max-width: 767px){
    .{{  section_id }}-video-full-btn{
        height: 700px;
    }
  }
  @media (max-width: 457px){
    .{{  section_id }}-video-full-btn{
      aspect-ratio: 458 / 700;
      height: auto;
    }
  } */
{%- endstyle -%}
{%- liquid
  assign video_id = video.id | default: video_url.id
  assign video_alt = video.alt | default: description
  assign alt = 'sections.video.load_video' | t: description: video_alt | escape

  assign poster = cover_image

  if poster == null and video_url != null
  
    if video_url.type == 'youtube'
     if youtube_use_type == 'hq'
       assign youtube_thumb = "https://img.youtube.com/vi/" | append: video_id | append: "/hqdefault.jpg"
     else
      assign youtube_thumb = "https://img.youtube.com/vi/" | append: video_id | append: "/maxresdefault.jpg"
     endif
      assign poster_url = youtube_thumb
    elsif video_url.type == 'vimeo'
      assign vimeo_thumb = "https://i.vimeocdn.com/video/" | append: video_id | append: "_1280x720.jpg"
      assign poster_url = vimeo_thumb
    endif
  endif

  if poster == null and video != null
    assign poster = video.preview_image
  endif
-%}

{%- capture sizes -%}
  {% if full_width -%}
    100vw
  {%- else -%}
    (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px)
    calc(100vw - 10rem), 100vw
  {%- endif %}
{%- endcapture -%}

<div class="color-{{ color_scheme }} gradient">
  <div class="video-section isolate{% unless full_width %} page-width{% endunless %} section-{{ section_id }}-padding" style="margin:0; padding:0;">
    <div {% if full_width %}class="page-width"{% endif %} style="display:none;"></div>

    <deferred-media
      class="video-section__media deferred-media gradient global-media-settings{% if full_width %} global-media-settings--full-width{% endif %}"
      data-media-id="{{ video_id }}"
      {% if poster != null or poster_url != null %}
        style="--ratio-percent: 56.25%;"
      {% endif %}
    >
      <button
        id="Deferred-Poster-Modal-{{ video_id }}"
        class="video-section__poster media deferred-media__poster media--landscape {{  section_id }}-video-full-btn"
        type="button"
        aria-label="{{ alt }}"
      >
        {%- if poster != null -%}
          {{
            poster
            | image_url: width: 1920, format: 'webp'
            | image_tag:
              widths: '352, 458',
              sizes: '(max-width: 767px) 458px, 352px',
              alt: alt
          }}
        {% elsif poster_url != null %}
          <img 
            src="{{ poster_url }}" 
            alt="{{ alt }}" 
            width="352" 
            height="198" 
            loading="lazy"
            style="width: 100%; height: 100%; object-fit: cover;object-position:center;"
          >
        {%- else -%}
          {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
        {%- endif -%}

        <span class="deferred-media__poster motion-reduce">
          <span class="shopify-{{section_id}}-video-play-svg-wrapper">
            {{- 'icon-play.svg' | inline_asset_content -}}
          </span>
        </span>
      </button>

      <template>
        {%- if video == null and video_url != null -%}
          {%- liquid
            assign loop = ''
            if enable_video_looping
              assign loop = '&loop=1&playlist=' | append: video_id
            endif
          -%}

          {%- if video_url.type == 'youtube' -%}
            <iframe
              src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&autoplay=1{{ loop }}"
              class="js-youtube"
              allow="autoplay; encrypted-media"
              allowfullscreen
              title="{{ description | escape }}"
            ></iframe>
          {%- else -%}
            <iframe
              src="https://player.vimeo.com/video/{{ video_id }}?api=1&autoplay=1{{ loop }}"
              class="js-vimeo"
              allow="autoplay; encrypted-media"
              allowfullscreen
              title="{{ description | escape }}"
            ></iframe>
          {%- endif -%}
        {%- else -%}
          {{
            video
            | video_tag:
              image_size: '1100x',
              autoplay: true,
              loop: enable_video_looping,
              controls: true,
              muted: false
          }}
        {%- endif -%}
      </template>
    </deferred-media>
  </div>
</div>