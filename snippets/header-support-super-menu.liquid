{%- liquid
  assign render_mode = mode | default: 'desktop'
  assign support_hero_button_link = block.settings.hero_button_url | default: link.url
-%}

{%- capture support_menu_content -%}
  <div class="header-support-super-menu-panel__inner">
    {%- if render_mode == 'desktop' -%}
      <div class="header-support-super-menu-hero">
        {%- if block.settings.hero_image != blank -%}
          {{
            block.settings.hero_image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '360, 540, 720, 900',
              class: 'header-support-super-menu-hero__image',
              alt: block.settings.hero_title
          }}
        {%- endif -%}
        <span class="header-support-super-menu-hero__shade"></span>
        <span class="header-support-super-menu-hero__content">
          {%- if block.settings.hero_title != blank -%}
            <span class="header-support-super-menu-hero__title font-h3">{{ block.settings.hero_title | escape }}</span>
          {%- endif -%}
          {%- if block.settings.hero_text != blank -%}
            <span class="header-support-super-menu-hero__text font-text-3">{{ block.settings.hero_text | escape }}</span>
          {%- endif -%}
          {%- if block.settings.hero_button_label != blank -%}
            {%- render 'feature-hero-button',
              class: 'header-support-super-menu-hero__button font-text-3',
              button_text: block.settings.hero_button_label,
              button_link: support_hero_button_link,
              button_style: 'header-support-super-menu-hero',
              button_bg_color: '#ffffff',
              button_text_color: '#333333',
              button_hover_bg_color: '#ffffff',
              button_hover_text_color: '#333333'
            -%}
          {%- endif -%}
        </span>
      </div>
    {%- endif -%}

    <div class="header-support-super-menu-list">
      {%- for index in (1..10) -%}
        {%- liquid
          assign title_key = 'item_' | append: index | append: '_title'
          assign text_key = 'item_' | append: index | append: '_text'
          assign url_key = 'item_' | append: index | append: '_url'
          assign icon_key = 'item_' | append: index | append: '_icon'
          assign item_title = block.settings[title_key]
          assign item_text = block.settings[text_key]
          assign item_url = block.settings[url_key] | default: link.url
          assign item_icon = block.settings[icon_key]
        -%}
        {%- if item_title != blank -%}
          <a href="{{ item_url }}" class="header-support-super-menu-card{% if forloop.first %} header-support-super-menu-card--active{% endif %}">
            <span class="header-support-super-menu-card__icon" aria-hidden="true">
              {%- case item_icon -%}
                {%- when 'question' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none">
                    <path d="M11 20.25C16.1086 20.25 20.25 16.1086 20.25 11C20.25 5.89137 16.1086 1.75 11 1.75C5.89137 1.75 1.75 5.89137 1.75 11C1.75 16.1086 5.89137 20.25 11 20.25Z" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M8.6 8.45C8.82 6.98 10.06 6.25 11.1 6.25C12.42 6.25 13.5 7.1 13.5 8.48C13.5 9.48 12.94 10.04 12.18 10.57C11.45 11.07 11 11.45 11 12.45" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M11 15.5H11.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                {%- when 'chat' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none">
                    <path d="M3.5 5.5H18.5V15H8.5L4.5 18V15H3.5V5.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M7.5 10H7.51M11 10H11.01M14.5 10H14.51" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                {%- when 'shield' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none">
                    <path d="M11 2.75L18 5.25V10.7C18 14.75 15.22 18.52 11 19.5C6.78 18.52 4 14.75 4 10.7V5.25L11 2.75Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M11 7.25V12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M11 15H11.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                {%- when 'truck' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none">
                    <path d="M3 6H13V15H3V6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M13 9H16.5L19 12V15H13V9Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M6.5 17.25C7.4665 17.25 8.25 16.4665 8.25 15.5C8.25 14.5335 7.4665 13.75 6.5 13.75C5.5335 13.75 4.75 14.5335 4.75 15.5C4.75 16.4665 5.5335 17.25 6.5 17.25Z" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M16.5 17.25C17.4665 17.25 18.25 16.4665 18.25 15.5C18.25 14.5335 17.4665 13.75 16.5 13.75C15.5335 13.75 14.75 14.5335 14.75 15.5C14.75 16.4665 15.5335 17.25 16.5 17.25Z" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                {%- when 'return' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none">
                    <path d="M8 7H14.5C17 7 19 9 19 11.5C19 14 17 16 14.5 16H6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M8 4L4 7L8 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- else -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none">
                    <path d="M6 2.75H13.5L18 7.25V19.25H6V2.75Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M13.5 2.75V7.25H18" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M8.75 11H15.25M8.75 14.5H14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
              {%- endcase -%}
            </span>
            <span class="header-support-super-menu-card__body">
              <span class="header-support-super-menu-card__title font-text-3">{{ item_title | escape }}</span>
              {%- if item_text != blank -%}
                <span class="header-support-super-menu-card__text font-text-5">{{ item_text | escape }}</span>
              {%- endif -%}
            </span>
            <span class="header-support-super-menu-card__arrow" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="9" height="15" viewBox="0 0 9 15" fill="none">
                <path d="M1.59071 13.589L1.53409 13.6401C1.2395 13.8806 0.804746 13.8637 0.530054 13.589C0.255361 13.3143 0.238401 12.8795 0.478954 12.5849L0.530054 12.5283L6.5301 6.52826C6.823 6.23537 7.29787 6.23537 7.59076 6.52826C7.88366 6.82116 7.88366 7.29603 7.59076 7.58892L1.59071 13.589Z" fill="currentColor"/>
                <path d="M0.539529 1.59031L0.487739 1.533C0.247784 1.23842 0.265054 0.804125 0.539529 0.52965C0.814004 0.255175 1.2483 0.237905 1.54288 0.47786L1.60019 0.52965L5.84283 4.77229C6.13572 5.06518 6.13572 5.54006 5.84283 5.83295C5.54994 6.12584 5.07506 6.12584 4.78217 5.83295L0.539529 1.59031Z" fill="currentColor"/>
              </svg>
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if render_mode == 'drawer' -%}
      <div class="header-support-super-menu-hero">
        {%- if block.settings.hero_image != blank -%}
          {{
            block.settings.hero_image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '360, 540, 720, 900',
              class: 'header-support-super-menu-hero__image',
              alt: block.settings.hero_title
          }}
        {%- endif -%}
        <span class="header-support-super-menu-hero__shade"></span>
        <span class="header-support-super-menu-hero__content">
          {%- if block.settings.hero_title != blank -%}
            <span class="header-support-super-menu-hero__title font-h3">{{ block.settings.hero_title | escape }}</span>
          {%- endif -%}
          {%- if block.settings.hero_text != blank -%}
            <span class="header-support-super-menu-hero__text font-text-3">{{ block.settings.hero_text | escape }}</span>
          {%- endif -%}
          {%- if block.settings.hero_button_label != blank -%}
            {%- render 'feature-hero-button',
              class: 'header-support-super-menu-hero__button font-text-3',
              button_text: block.settings.hero_button_label,
              button_link: support_hero_button_link,
              button_style: 'header-support-super-menu-hero',
              button_bg_color: '#ffffff',
              button_text_color: '#333333',
              button_hover_bg_color: '#ffffff',
              button_hover_text_color: '#333333'
            -%}
          {%- endif -%}
        </span>
      </div>
    {%- endif -%}
  </div>
{%- endcapture -%}

{%- if render_mode == 'drawer' -%}
  <div class="header-support-super-menu-drawer">
    {{ support_menu_content }}
  </div>
{%- else -%}
  <header-menu>
    <details id="Details-HeaderSupportSuperMenu-{{ block.id }}" class="header-super-menu-details header-support-super-menu-details">
      <summary
        id="HeaderMenu-{{ link.handle }}"
        class="header__menu-item header-super-menu-trigger list-menu__item link focus-inset font-text-4"
      >
        <span
          {%- if link.child_active %}
            class="header__active-menu-item"
          {% endif %}
        >
          {{- link.title | escape -}}
        </span>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>

      <div class="header-super-menu-panel header-support-super-menu-panel color-{{ section.settings.menu_color_scheme }} gradient" tabindex="-1">
        {{ support_menu_content }}
      </div>
    </details>
  </header-menu>
{%- endif -%}
