{%- endcapture -%}
<style>
  .social-media-container{
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 19px;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    margin-top: 40px;
  }
  .social-media__item {
    --color-accent:#fff;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #000;
  }
  .social-media__item a{
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
  }
  .social-media__item span{
    display: none;
  }
  .social-media-container-userinfobox{
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .social-media-container-userinfo{
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .social-media-container-userinfo-name{
    color: #333;
  }
  .social-media-container-userinfo-date{
    color: rgba(51, 51, 51, 0.4);
  }
  .social-media-container-userinfo-avatar{
    border-radius: 50%;
    width: 71px;
    height: 71px;
    aspect-ratio: 1/1;
    flex-shrink: 0;
  }
  .social-media-container-title{
      color: #333;
      margin-bottom: 7px;
      text-align: right;
  }
  .social-media-container .social-media{
    gap: 5px;
    flex-direction: row;
    justify-content: flex-end;
  }
  .blog-tags-box{
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 32px;
  }
  .blog-tags-box p{
    padding: 8px 20px;
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    line-height: 16px;
    color: color: rgba(29, 29, 29, 0.70);
    border-radius: 7px;
    border: 1px solid rgba(29, 29, 29, 0.10);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media(max-width: 767px){
       .social-media-container  .unstyled-list li a svg{
        width: calc(100vw * 57 / var(--base-width));
      }
      .social-media-container-userinfo-avatar{
        width: calc(100vw * 98 / var(--base-width));
        height: calc(100vw * 98 / var(--base-width));
      }
      .social-media__item{
        width: 32px;
        height: 32px;
      }
      .social-media__item a{
        width: 15px;
      }
  } 
</style>
<div class="social-media-containerbox">
  <div class="social-media-container">
    <div class="social-media-container-userinfobox">
       {% assign default_avatar_image = section.settings.avatar_image %}
      {% if article.user.image != blank %}
        <img class="social-media-container-userinfo-avatar" src="{{ article.user.image | default: default_avatar_image | image_url }}" />
      {%  elsif default_avatar_image != blank %}
        <img class="social-media-container-userinfo-avatar" src="{{ default_avatar_image | image_url }}" />
      {% else %}
        <img class="social-media-container-userinfo-avatar" src="https://cdn.shopify.com/s/files/1/0702/6999/3050/files/20260613-140415.jpg?v=1781330732" />
      {% endif %}
      <div class="social-media-container-userinfo">
        <p class="font-text-18 social-media-container-userinfo-name">{{ article.author }}</p>
        <p class="font-text-14 social-media-container-userinfo-date">{{ article.published_at | date: '%B %d, %Y' }}</p>
      </div>
    </div>
    {%- if social_media != blank -%}
      <div>
        <p class="font-text-12 social-media-container-title">SHARE ARTICLE</p>
        <ul class="social-media unstyled-list" role="list">
        {{- social_media -}}
      </ul>
      </div>
    {%- endif -%}
  </div>
  <div class="blog-tags-box">
      {% for tag in article.tags %}
        <p class="">{{ tag }}</p>
      {% endfor %}
  </div>
</div>