{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
SOCIAL MEDIA
----------------------------------------------------------------------------------------------------------------------

Output a list of social media icons based on the social URL settings.
{%- endcomment -%}
{% assign share_url = article.url | prepend: request.origin %}
  {% assign share_url_encoded = share_url | url_encode %}
  {% assign share_title = article.title | url_encode %}
  {% assign email_subject = article.title | append: ' | ' | append: shop.name | url_encode %}
  {% assign email_body = article.title | append: ' ' | append: share_url | url_encode %}

