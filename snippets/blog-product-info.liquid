{% assign product_parameters = blog_settings.product_parameters.value %}
{% if product_parameters != blank %}
    {% assign product_parameters_product = product_parameters.product.value %}
    <div class="blog-product-info" style="display: none;">
        <div class="blog-product-info-lt">
            {%- render 'product-card-custom-blog', product: product_parameters_product -%}
        </div>
        <div class="blog-product-info-rt">
            <div class="blog-product-info-rt-header">
                <div class="blog-product-info-rt-header-item">
                    {{ product_parameters.box1_parameters | metafield_tag }}
                </div>
                <div class="blog-product-info-rt-header-item">
                    {{ product_parameters.box2_parameters | metafield_tag }}
                </div>
            </div>
            <div class="blog-text-14 blog-product-info-rt-content">
                {{ product_parameters.box3_parameters | metafield_tag }}
            </div>
        </div>
    </div>
{% endif %} 