{% assign blog_settings = article.metafields.custom.blog_settings.value %}
<script id="main-article-settings">
  {
      "tableSettings": "{{ blog_settings.table_settings.value | map: 'layout' | join: ',' }}",
      "chooseTitle": "{{ blog_settings.choose_size_title.value | join: ',' }}",
      "updates_history_sources": "{{ blog_settings.updates_history_sources.value | join: ',' }}",
      "best_product_insert": "{{ blog_settings.blog_best_product.value.insert_text | default: '' }}",
      "product_parameters_insert": "{{ blog_settings.product_parameters.value.insert_text | default: '' }}",
      "who_plans_bdsm_scenes": "{{ blog_settings.who_plans_bdsm_scenes.value | default: '' }}",
      "blog_single_product": "{{ blog_settings.blog_single_product.value | default: '' }}",
      "image_switch_insert_text": "{{ blog_settings.image_switch_insert_text | default: '' }}",
      "jb_tst_wrapper_insert_text": "{{ blog_settings.insert_comment | default: '' }}"
  }
</script>
<div class="article-section-page">
  <div class="article-section color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
    <div class="article-section-lt">
      <div id="toc" class="tocbox active"></div>
      {% render 'blog-email', section: section %}
    </div>

    <div class="article-section-mid">
      {% assign content_parts = article.content | split: '<img' %}
      {{ content_parts[0] }}

      {% for part in content_parts offset: 1 %}
        {% assign img_attrs = part | split: '>' | first %}
        {% assign after_img = part | remove_first: img_attrs | remove_first: '>' %}

        {% if img_attrs contains 'src="' and img_attrs contains 'cdn.shopify.com' %}
          {% assign src_split = img_attrs | split: 'src="' %}
          {% assign before_src = src_split[0] %}
          {% assign src_rest = src_split[1] %}
          {% assign img_src = src_rest | split: '"' | first %}
          {% assign after_src = src_rest | remove_first: img_src | remove_first: '"' %}

          {% if img_src contains '?' %}
            {% assign img_320 = img_src | append: '&width=320' %}
            {% assign img_480 = img_src | append: '&width=480' %}
            {% assign img_720 = img_src | append: '&width=720' %}
            {% assign img_900 = img_src | append: '&width=900' %}
            {% assign img_1200 = img_src | append: '&width=1200' %}
          {% else %}
            {% assign img_320 = img_src | append: '?width=320' %}
            {% assign img_480 = img_src | append: '?width=480' %}
            {% assign img_720 = img_src | append: '?width=720' %}
            {% assign img_900 = img_src | append: '?width=900' %}
            {% assign img_1200 = img_src | append: '?width=1200' %}
          {% endif %}

          <span class="article-img-loading">
            <img
              {{ before_src }}
              src="{{ img_720 }}"
              srcset="
                {{ img_320 }} 320w,
                {{ img_480 }} 480w,
                {{ img_720 }} 720w,
                {{ img_900 }} 900w,
                {{ img_1200 }} 1200w
              "
              sizes="(max-width: 767px) calc(100vw - 30px), min(100vw - 40px, 900px)"
              {% if img_attrs contains 'loading=' %}
              {% elsif forloop.index == 1 %}
                loading="eager"
                fetchpriority="high"
              {% else %}
                loading="lazy"
                fetchpriority="low"
              {% endif %}
              decoding="async"
              {{ after_src }}
            >
          </span>

          {{ after_img }}

        {% else %}
          <span class="article-img-loading">
            <img
              {{ img_attrs }}
              {% unless img_attrs contains 'loading=' %}
                loading="lazy"
              {% endunless %}
              decoding="async"
            >
          </span>

          {{ after_img }}
        {% endif %}
      {% endfor %}
      <div class="social-media-blog-seciton"></div>

      {%- render 'social-media-blog', article: article -%}

      {% render 'blog-recommended-products',
        article: article,
        product_random1: product_random11,
        product_random2: product_random21,
        product_random3: product_random31,
        product_random4: product_random41
      %}
      {% render 'blog-product', article: article %}
      {% render 'blog-single-product', article: article %}
      {% render 'blog-product-info', article: article, blog_settings: blog_settings %}
      {% render 'blog-best-product', article: article, blog_settings: blog_settings %}
      <!-- picture-products -->
      {% render 'picture-products',
        article: article,
        product_random1: product_random1,
        product_random2: product_random2,
        product_random3: product_random3,
        product_random4: product_random4,
        product_random5: product_random5,
        product_random6: product_random6
      %}
      <!-- blog-image-switch -->
      {% render 'blog-image-switch', article: article %}
    </div>
    <div class="article-section-rt">
      {% render 'blog-email', section: section %}

      {% assign current_blog = article.handle | split: '/' %}
      {% assign current_article_list = blogs[current_blog[0]].articles | sort: 'published_at' %}

      {% assign recommended_blogs = article.metafields.custom.recommended_blogs.value %}
      {% if recommended_blogs != blank %}
        {% render 'recommend-article', list: recommended_blogs.blogs.value %}
      {% else %}
        {% render 'recommend-article', list: current_article_list %}
      {% endif %}
      {% render 'recommend-article',
        class: 'article_recommended_blogs2',
        list: current_article_list,
        offset: 4,
        limit: 3
      %}
    </div>
  </div>
</div>

<script src="{{ 'gsap.min.js' | asset_url }}"></script>
