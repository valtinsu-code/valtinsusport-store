<style>
   :root{
       --blog-theme-default-text-color: {{ section.settings.default_text_color }};
       --blog-theme-active-text-color: {{ section.settings.active_text_color }};
       --blog-theme-block-color: {{ section.settings.blog_theme_block_color }};
       --blog-theme-background-color: {{ section.settings.background_color }};
       --blog-theme-color-fff: {{ section.settings.color_fff }};
       --blog-theme-table-thead-background-color: {{ section.settings.table_thead_background_color }};
       --blog-theme-table-thead-text-color: {{ section.settings.table_thead_text_color }};
       --blog-theme-table-tbody-odd: {{ section.settings.table_tbody_odd_background_color }};
       --blog-theme-table-tbody-even: {{ section.settings.table_tbody_even_background_color }};
       --blog-theme-table-tbody-td-nth-child2: {{ section.settings.table_tbody_td_nth_child2_background_color }};
       --section-vertical-spacing: {{ section.settings.section_vertical_spacing }}px;
   }
   .article-section-page{
        margin: 0 24px;
        margin-top: 60px;
   }
   .article-section{
       max-width: 1440px;
       display: flex;
       gap: 32px;
       margin: 0 auto;
   }
  .article-section .article-section-lt,.article-section .article-section-rt{
       width: 331px;
   }
   .article-section .article-section-lt{
       height: fit-content;
       position: sticky;
       top: calc(var(--header-bottom-position-desktop) + 15px);
       max-height: calc(100vh - 80px);
       padding-bottom: 50px;
   }
  .article-section .article-section-mid{
       flex: 1;
       overflow: hidden;
       padding-bottom: 80px;
   }
  .article-section .article-section-lt .footer-content-white-left{
       display: none;
       max-width: 100%;
   }
   /* .section-split__column--image img{
       border-radius: 0px !important;
   } */
   @media(max-width: 1440px){
       .article-section .article-section-lt, .article-section .article-section-rt{
           width: 306px;
       }

   }
   @media(max-width: 1300px){
       .article-section{
           gap: 24px;
       }
       .article-section .article-section-rt{
           display: none;
       }
       .article-section .article-section-rt .footer-content-white-left{
           display: none;
       }
       .article-section .article-section-lt .footer-content-white-left{
           display: flex;
           margin-top: 17px;
       }


   }

   @media(max-width: 1024px){
       .article-section-page{
           margin: 0 var(--container-gutter);
       }

   }
   @media(max-width: 768px){
    .article-section .article-section-mid{
      padding-left: 10px;
      padding-right: 10px;
    }
   }
     @media(max-width: 800px){
        .article-section .article-section-lt {
           display: none;
       }
       .article-section .article-section-mid{
               padding-bottom: 0px;
       }
   }
   @media(max-width: 767px){
    .article-section .article-section-mid{
      padding-left: 10px; 
      padding-right: 10px;
    }
   }
</style>
