{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top-pc:{{ section.settings.padding_top_pc }}px;
    --padding-bottom-pc:{{ section.settings.padding_bottom_pc }}px;
    --padding-top-ipad:{{ section.settings.padding_top_ipad }}px;
    --padding-bottom-ipad:{{ section.settings.padding_bottom_ipad }}px;
    --padding-top-mobile:{{ section.settings.padding_top_mobile }}px;
    --padding-bottom-mobile:{{ section.settings.padding_bottom_mobile}}px;
  }

  #shopify-section-{{ section.id }} .yt-banner-wrapper {
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .yt-banner-container {
    position: relative;
    width: 100%;
    border-radius: 25px;
    overflow: hidden;
    display: grid;
    place-items: center;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .yt-banner-media {
    position: relative;
    grid-area: 1 / 1;
    z-index: 0;
    display: block;
    width: 100%;
    min-width: 0;
    height: 100%;
    align-self: stretch;
    aspect-ratio: var(--banner-image-aspect-ratio);
  }

  #shopify-section-{{ section.id }} .yt-banner-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Overlay to improve text readability */
  #shopify-section-{{ section.id }} .yt-banner-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .yt-banner-content {
    position: relative;
    grid-area: 1 / 1;
    z-index: 2;
    width: 100%;
    max-width: 650px;
    min-width: 0;
    box-sizing: border-box;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-self: center;
    padding: 40px 20px;
  }

  #shopify-section-{{ section.id }} .yt-banner-heading {
    color: #ffffff;
    width: 100%;
    max-width: 100%;
    margin: 0 0 12px 0;
    text-align: center;
    overflow-wrap: break-word;
  }

  #shopify-section-{{ section.id }} .yt-banner-subheading {
    color: rgba(255, 255, 255, 0.9);
    width: 100%;
    margin: 0 0 24px 0;
    text-align: center;
    overflow-wrap: break-word;
    width: 80%;
  }

  #shopify-section-{{ section.id }} .yt-banner-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: {{ section.settings.btn_color }};
    color: #ffffff;
    padding: 10px 32px;
    border-radius: 50px;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .yt-banner-btn:hover {
    background-color: #e55a0f;
  }



  @media screen and (max-width: 1024px) {
    #shopify-section-{{ section.id }} .yt-banner-content {
      max-width: calc(100% - 40px);
    }
  }

  /* Mobile Responsive Styles (<= 767px) */
  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .yt-banner-container {
      border-radius: 25px;
    }

    #shopify-section-{{ section.id }} .yt-banner-media {
      aspect-ratio: var(--banner-mobile-image-aspect-ratio, var(--banner-image-aspect-ratio));
    }

    #shopify-section-{{ section.id }} .yt-banner-content {
      padding: 30px 20px;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .yt-banner-heading {
      margin-bottom: 14px;
    }

    #shopify-section-{{ section.id }} .yt-banner-subheading {
      margin-bottom: 24px;
      width:100%;
    }

    #shopify-section-{{ section.id }} .yt-banner-btn {
      width: 100%;
      max-width: 280px;
      padding: 12px 20px;
    }
  }
{%- endstyle -%}

<div class="yt-banner-wrapper page-width section-padding">
  <div class="yt-banner-container">
    {%- assign banner_image = section.settings.image_desktop | default: section.settings.image_mobile -%}
    {%- if banner_image != blank -%}
      <picture
        class="yt-banner-media"
        style="--banner-image-aspect-ratio: {{ banner_image.aspect_ratio }};{% if section.settings.image_mobile != blank %} --banner-mobile-image-aspect-ratio: {{ section.settings.image_mobile.aspect_ratio }};{% endif %}"
      >
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 767px)"
            srcset="{{ section.settings.image_mobile | image_url: width: 1000 }}"
          >
        {%- endif -%}
        <img
          src="{{ banner_image | image_url: width: 2000 }}"
          alt="{{ banner_image.alt | escape }}"
          width="{{ banner_image.width }}"
          height="{{ banner_image.height }}"
          loading="lazy"
        >
      </picture>
    {%- endif -%}
    <div class="yt-banner-overlay"></div>
    <div class="yt-banner-content">
      {%- if section.settings.heading != blank -%}
        <h2 class="yt-banner-heading font-h2 font-weight-500">{{ section.settings.heading }}</h2>
      {%- endif -%}
      
      {%- if section.settings.subheading != blank -%}
        <div class="yt-banner-subheading font-text-3">{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="yt-banner-btn font-button-1 font-weight-500">
          <span class="font-weight-500 font-button-1">{{ section.settings.button_label }}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="9" height="15" viewBox="0 0 9 14" fill="none">
        <path d="M1.59071 13.589L1.53409 13.6401C1.2395 13.8806 0.804746 13.8637 0.530054 13.589C0.255361 13.3143 0.238401 12.8795 0.478954 12.5849L0.530054 12.5283L6.5301 6.52826C6.823 6.23537 7.29787 6.23537 7.59076 6.52826C7.88366 6.82116 7.88366 7.29603 7.59076 7.58892L1.59071 13.589Z" fill="currentColor"></path>
        <path d="M0.539529 1.59031L0.487739 1.533C0.247784 1.23842 0.265054 0.804125 0.539529 0.52965C0.814004 0.255175 1.2483 0.237905 1.54288 0.47786L1.60019 0.52965L5.84283 4.77229C6.13572 5.06518 6.13572 5.54006 5.84283 5.83295C5.54994 6.12584 5.07506 6.12584 4.78217 5.83295L0.539529 1.59031Z" fill="currentColor"></path>
      </svg>
        </a>
      {%- endif -%}
    </div>
  </div> 
</div>

{% schema %}
{
  "name": "Media Promo Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "padding"
    },
    {
      "type": "number",
      "id": "padding_top_pc",
      "label": "padding top pc"
    },
    {
      "type": "number",
      "id": "padding_bottom_pc",
      "label": "padding bottom pc"
    },
    {
      "type": "number",
      "id": "padding_top_ipad",
      "label": "padding top ipad"
    },
    {
      "type": "number",
      "id": "padding_bottom_ipad",
      "label": "padding bottom ipad"
    },
    {
      "type": "number",
      "id": "padding_top_mobile",
      "label": "padding top mobile"
    },
    {
      "type": "number",
      "id": "padding_bottom_mobile",
      "label": "padding bottom mobile"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile background image (optional)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 15
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More Rides Drop Weekly"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Subscribe on YouTube for trail runs, honest reviews & behind-the-scenes builds."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe On YouTube"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button color",
      "default": "#FF6E1D"
    }
  ],
  "presets": [
    {
      "name": "Media Promo Banner"
    }
  ]
}
{% endschema %}
