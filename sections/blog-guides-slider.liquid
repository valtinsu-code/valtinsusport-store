
 <div class="guides-section page-width section-padding {% if section.settings.limit_width %}page-width-1530{%endif %}" data-guides-section>
  <div class="guides-header">
    <h2 class="guides-title font-h2">
      {% if section.settings.title != blank %}
        {{ section.settings.title | escape }}
      {% endif %}
    </h2>

    {% if section.settings.blog != blank %}
      {% assign blog_url = section.settings.blog.url %}
    {% else %}
      {% assign blog_url = routes.blogs_url %}
    {% endif %}

    <a href="{{ blog_url }}" class="explore-btn font-button-1">
      {% if section.settings.button_text != blank %}
        {{ section.settings.button_text | escape }}
      {% endif %}
      <svg xmlns="http://www.w3.org/2000/svg" width="9" height="15" viewBox="0 0 9 14" fill="none">
        <path d="M1.59071 13.589L1.53409 13.6401C1.2395 13.8806 0.804746 13.8637 0.530054 13.589C0.255361 13.3143 0.238401 12.8795 0.478954 12.5849L0.530054 12.5283L6.5301 6.52826C6.823 6.23537 7.29787 6.23537 7.59076 6.52826C7.88366 6.82116 7.88366 7.29603 7.59076 7.58892L1.59071 13.589Z" fill="currentColor"></path>
        <path d="M0.539529 1.59031L0.487739 1.533C0.247784 1.23842 0.265054 0.804125 0.539529 0.52965C0.814004 0.255175 1.2483 0.237905 1.54288 0.47786L1.60019 0.52965L5.84283 4.77229C6.13572 5.06518 6.13572 5.54006 5.84283 5.83295C5.54994 6.12584 5.07506 6.12584 4.78217 5.83295L0.539529 1.59031Z" fill="currentColor"></path>
      </svg>
    </a>
  </div>

  <div class="guides-slider" data-guides-slider>
    <div class="guider-swiper swiper">
      <div class="swiper-wrapper">
        {% if section.settings.blog != blank and section.settings.blog.articles_count > 0 %}
          {% for repeat in (1..3) %}
            {% for article in section.settings.blog.articles limit: section.settings.articles_limit %}
            <div class="swiper-slide">
              <article class="guide-card" data-guide-card>
                <a href="{{ article.url }}" class="card-image" aria-label="{{ article.title | escape }}">
                  {% if article.image != blank %}
                    {{ article.image | image_url: width: 1920,format: 'webp'| image_tag: loading: 'lazy' }}
                  {% else %}
                    <div class="card-image--placeholder" aria-hidden="true"></div>
                  {% endif %}
                </a>

                <div class="card-meta">
                  {%- assign tagList = blank -%}
                  {% if section.settings.is_show_manual_tags and section.settings.manual_tags != blank %}
                    {%- assign tagList = section.settings.manual_tags | split:','  -%}
                  {% else %}
                    {% if article.tags.size > 0 %}
                      {%- assign tagList = article.tags -%}
                    {% endif %}
                  {% endif %}

                  {% if tagList.size > 0 %}
                    {% for tag in tagList %}
                      <span class="card-tag font-text-5">{{ tag | escape }}</span>
                    {% endfor %}
                  {% endif %}
                </div>

                <div class="card-title font-text-2">
                  {{ article.title | escape }}
                </div>
                <span class="card-date font-text-5">
                  {{ article.published_at | date: "%b %d, %Y" | upcase }}
                </span>
              </article>
            </div>
          {% endfor %}
          {% endfor %}  
        {% endif %}
      </div>
    </div>

    <div class="guides-controls">
      <button class="slide-btn prev" data-guides-prev>
        <svg xmlns="http://www.w3.org/2000/svg" width="8" height="14" viewBox="0 0 8 14" fill="none">
          <path d="M0.75 6.75L6.75 12.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          <path d="M2.50391 4.99219L6.74655 0.749547" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
      </button>
      <button class="slide-btn next" data-guides-next>
        <svg xmlns="http://www.w3.org/2000/svg" width="9" height="15" viewBox="0 0 9 14" fill="none">
          <path d="M1.59071 13.589L1.53409 13.6401C1.2395 13.8806 0.804746 13.8637 0.530054 13.589C0.255361 13.3143 0.238401 12.8795 0.478954 12.5849L0.530054 12.5283L6.5301 6.52826C6.823 6.23537 7.29787 6.23537 7.59076 6.52826C7.88366 6.82116 7.88366 7.29603 7.59076 7.58892L1.59071 13.589Z" fill="currentColor"></path>
          <path d="M0.539529 1.59031L0.487739 1.533C0.247784 1.23842 0.265054 0.804125 0.539529 0.52965C0.814004 0.255175 1.2483 0.237905 1.54288 0.47786L1.60019 0.52965L5.84283 4.77229C6.13572 5.06518 6.13572 5.54006 5.84283 5.83295C5.54994 6.12584 5.07506 6.12584 4.78217 5.83295L0.539529 1.59031Z" fill="currentColor"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  {%- assign cardW = section.settings.card_width | append: 'px' -%}
  {%- assign cardW1440 = section.settings.card_width_1440 | append: 'vw' -%}
  {%- assign cardW1024 = section.settings.card_width_1024 | append: 'vw' -%}
  {%- assign cardW750 = section.settings.card_width_750 | append: 'vw' -%}

  #shopify-section-{{ section.id }} {
    --padding-top-pc:{{ section.settings.padding_top_pc }}px;
    --padding-bottom-pc:{{ section.settings.padding_bottom_pc }}px;
    --padding-top-ipad:{{ section.settings.padding_top_ipad }}px;
    --padding-bottom-ipad:{{ section.settings.padding_bottom_ipad }}px;
    --padding-top-mobile:{{ section.settings.padding_top_mobile }}px;
    --padding-bottom-mobile:{{ section.settings.padding_bottom_mobile}}px;
  }

  #shopify-section-{{ section.id }} {
    --guides-gap: 12px;
    --guides-card-radius: 12px;
    --guides-btn-bg: #FF6E1D;
    --guides-btn-text: #ffffff;
    --guides-title-size: 36px;
    --guides-container-max: 1530px;
    --guides-card-image-width: {{cardW}};
    --guides-card-title-max-with: {{cardW}};
    --guides-explore-link-width:224px;
    --guides-explore-link-height: 46px;
    --guides-card-meta-size: 12px;
    --guides-card-meta-line-height: 26px;
    & h2,& p{
      margin: 0;
    }
  }

 

  @media (max-width: 1440px) {
    #shopify-section-{{ section.id }} {
      --guides-container-max: 1360px;
      --guides-title-size: 32px;
      --guides-card-image-width: {{cardW1440}};
      --guides-card-title-max-with: {{cardW1440}};
    }
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} {
      --guides-container-max: 945px;
      --guides-title-size: 28px;
      --guides-card-image-width: {{cardW1024}};
      --guides-card-title-max-with: {{cardW1024}};
      --guides-gap: 16px;
    }
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      --guides-title-size: 24px;
      --guides-card-image-width: {{cardW750}};
      --guides-card-title-max-with: {{cardW750}};
    }
    #shopify-section-{{ section.id }} .guides-header{
      flex-direction: column;
      align-items: flex-start;
    }
    #shopify-section-{{ section.id }} .guides-controls{
      display: none;
    }
  }

  @media (max-width: 480px) {
    #shopify-section-{{ section.id }}{
      --guides-card-image-width: 55vw;
      --guides-card-title-max-with: 55vw;
    }
  }

  #shopify-section-{{ section.id }} * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .guides-section {
    margin: 0 auto;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .guides-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 25px;
  }

  #shopify-section-{{ section.id }} .explore-btn {
    background: var(--guides-btn-bg);
    color: var(--guides-btn-text);
    border: none;
    padding: 10px 30px;
    border-radius: 55px;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .explore-btn:hover {
    background-color: #e55a0f;
  }

  #shopify-section-{{ section.id }} .guides-slider {
    position: relative;
  }

  #shopify-section-{{ section.id }} .guider-swiper {
    overflow: hidden;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .swiper-slide {
    width: var(--guides-card-image-width);
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .guide-card {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .card-image {
    max-width: {{ section.settings.limit_image_width | append:"px" }};
    width: 100%;
    height: auto;
    border-radius: var(--guides-card-radius);
    overflow: hidden;
    position: relative;
    background: #eee;
    display: block;
  }

  #shopify-section-{{ section.id }} .card-image img,
  #shopify-section-{{ section.id }} .card-image--placeholder {
    width: 100%;
    height: auto;
    aspect-ratio: 4 /3;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .card-image--placeholder {
    background: repeating-linear-gradient(
      45deg,
      #f5f5f5,
      #f5f5f5 10px,
      #e0e0e0 10px,
      #e0e0e0 20px
    );
  }

  #shopify-section-{{ section.id }} .card-meta {
    margin-top: 16px;
    letter-spacing: 0%;
    color: #FF6E15;
    display: flex;
    align-items: center;
    text-transform: uppercase;
    flex-wrap: wrap;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .card-meta .card-tag{
    padding: 3px 8px;
    background: #FF6E151A;
    border-radius:4px;
  }

  #shopify-section-{{ section.id }} .card-title {
    margin: 8px 0;
    max-width: var(--guides-card-title-max-with);
    color: #333;
  }

  #shopify-section-{{ section.id }} .card-date{
    color: rgba(0,0,0,.4);
    display: block;
    margin-top: 4px;
  }

  #shopify-section-{{ section.id }} .guides-controls {
    position: absolute;
    inset-block: 0;
    inset-inline: 0;
    pointer-events: none;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .slide-btn {
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    width: 45px;
    height: 45px;
    font-size: 20px;
    border-radius: 12px;
    background: #000;
    color: #fff;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    pointer-events: auto;
  }
  #shopify-section-{{ section.id }} .slide-btn:hover{
    color: #000;
    background: #fff;
    transition: background-color .3s ease;
  }
  #shopify-section-{{ section.id }} .slide-btn.prev {
    left: 20px;
  }

  #shopify-section-{{ section.id }} .slide-btn.next {
    right: 20px;
  }
   @media (max-width: 1920px) and (min-width: 1441px){
    {% comment %} #shopify-section-{{ section.id }} .guide-card {
      {% unless section.settings.limit_width %}
        width: calc(100vw * ({{section.settings.card_width}}/1920));
      {% endunless %}  
    } {% endcomment %}

    {% comment %} #shopify-section-{{ section.id }} .card-image {
      {% unless section.settings.limit_width %}
         width: calc(100vw * ({{section.settings.card_width}}/1920));
      {% endunless %}  
    } {% endcomment %}
  }
  @media(max-width: 767px){
     #shopify-section-{{ section.id }} .guider-swiper{
       overflow: visible;
    }
  }
</style>

{% comment %} {% javascript %}
document.addEventListener('DOMContentLoaded', () => {
  const sections = document.querySelectorAll('[data-guides-section]');
  if (!sections.length) return;

  sections.forEach(section => {
    const swiperEl = section.querySelector('.guider-swiper');
    const prevBtn = section.querySelector('[data-guides-prev]');
    const nextBtn = section.querySelector('[data-guides-next]');

    if (!swiperEl) return;

    const swiper = new Swiper(swiperEl, {
      slidesPerView: 'auto',
      spaceBetween: 12,
      freeMode: false,
      watchOverflow: true,
      resistance: true,
      // 开启无限轮播
      loop: true,
      // 开启自动轮播
      autoplay: {
        delay: 3000,    // 停留 3 秒切换
        disableOnInteraction: false // 点击/滑动后不停止自动播放
      },
      breakpoints: {
        1024: { spaceBetween: 15,
          slidesPerView: 3
         },
        768: { spaceBetween: 12 ,
          slidesPerView: 2
        }
      }
    });

    nextBtn?.addEventListener('click', () => swiper.slideNext());
    prevBtn?.addEventListener('click', () => swiper.slidePrev());
  });
});
{% endjavascript %} {% endcomment %}
 {% javascript %}
document.addEventListener('DOMContentLoaded', () => {
  const sections = document.querySelectorAll('[data-guides-section]');
  if (!sections.length) return;

  sections.forEach(section => {
    const swiperEl = section.querySelector('.guider-swiper');
    const prevBtn = section.querySelector('[data-guides-prev]');
    const nextBtn = section.querySelector('[data-guides-next]');

    if (!swiperEl) return;

    const swiper = new Swiper(swiperEl, {
      slidesPerView: 'auto',
      spaceBetween: 12,
      freeMode: false,
      watchOverflow: true,
      resistance: true,
      loop: true,
      autoplay: {
        delay: 3000,
        disableOnInteraction: false
      },
      breakpoints: {
        1024: {
          spaceBetween: 15,
          slidesPerView: 3
        },
        768: {
          spaceBetween: 12,
          slidesPerView: 2
        }
      }
    });

    nextBtn?.addEventListener('click', () => swiper.slideNext());
    prevBtn?.addEventListener('click', () => swiper.slidePrev());

    // 鼠标移入暂停，移出恢复
    swiperEl.addEventListener('mouseenter', () => {
      swiper.autoplay.pause();
    });
    swiperEl.addEventListener('mouseleave', () => {
      swiper.autoplay.start();
    });
  });
});
{% endjavascript %}

{% schema %}
{
  "name": "Latest Dirt Bike Guides",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "background color", "default": "#fff" },
    { "type": "header", "content": "padding" },
    { "type": "number", "id": "padding_top_pc", "label": "padding top pc" },
    { "type": "number", "id": "padding_bottom_pc", "label": "padding bottom pc" },
    { "type": "number", "id": "padding_top_ipad", "label": "padding top ipad" },
    { "type": "number", "id": "padding_bottom_ipad", "label": "padding bottom ipad" },
    { "type": "number", "id": "padding_top_mobile", "label": "padding top mobile" },
    { "type": "number", "id": "padding_bottom_mobile", "label": "padding bottom mobile" },
    { "type": "header", "content": "Section Settings" },
    { "type": "text", "id": "title", "label": "Section Title", "default": "Latest dirt bike guides" },
    { "type": "checkbox", "id":"limit_width", "label": "limit width 1530", "default": true },
    { "type": "number", "id":"card_width", "label": "card width (px)", "default": 476 },
    { "type": "number", "id":"card_width_1440", "label": "card width 1440 (vw)", "default": 32 },
    { "type": "number", "id":"card_width_1024", "label": "card width 1024 (vw)", "default": 47 },
    { "type": "number", "id":"card_width_750", "label": "card width 750(vw)", "default": 57 },
    { "type":"number", "id": "limit_image_width", "label": "limit image width", "default": 500 },
    { "type": "blog", "id": "blog", "label": "Select Blog" },
    { "type":"checkbox", "id":"is_show_manual_tags", "label":"show manual tags", "default":false },
    { "type":"textarea", "id":"manual_tags", "label": "manual tags", "default":"initiation,news,sport", "visible_if": "{{section.settings.is_show_manual_tags }}" },
    { "type": "range", "id": "articles_limit", "label": "Number of Articles", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "Explore all" }
  ],
  "presets": [{ "name": "Latest Dirt Bike Guides" }]
}
{% endschema %}