{%- style -%}
#shopify-section-{{ section.id }} {
    --padding-top-pc:{{ section.settings.padding_top_pc }}px;
    --padding-bottom-pc:{{ section.settings.padding_bottom_pc }}px;
    --padding-top-ipad:{{ section.settings.padding_top_ipad }}px;
    --padding-bottom-ipad:{{ section.settings.padding_bottom_ipad }}px;
    --padding-top-mobile:{{ section.settings.padding_top_mobile }}px;
    --padding-bottom-mobile:{{ section.settings.padding_bottom_mobile}}px;
    --base-width: 375;
    padding: var(--padding-top-pc) 0 var(--padding-bottom-pc);
}
#shopify-section-{{ section.id }} .creator-carousel-section {
    overflow: hidden;
    text-align: center;
    background: {{ section.settings.bg_color }};
}

#shopify-section-{{ section.id }} .section-title {
    max-width: 833px;
    width: fit-content;
    text-align: center;
    color: #333;
    margin: 0 auto 32px;
}

#shopify-section-{{ section.id }} .carousel-wrapper {
    width: 100%;
    overflow: hidden;
    margin-bottom: 30px;
}

/* Swiper 基础覆盖，不改动卡片原有样式 */
#shopify-section-{{ section.id }} .swiper {
    width: 100%;
}
#shopify-section-{{ section.id }} .swiper-wrapper {
    display: flex;
    gap: 12px;
    align-items: stretch;
}
#shopify-section-{{ section.id }} .swiper-slide {
    width: auto;
    flex-shrink: 0;
}

#shopify-section-{{ section.id }} .clip-card {
    border-radius: 15px;
    position: relative;
    max-width: 352px;
    width: 352px;
    height: auto;
    aspect-ratio: 352 / 529;
    transform: translateZ(0);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    
    overflow:hidden;
}
/* 透明蒙层：初始隐藏，播放时显示 */
#shopify-section-{{ section.id }} .video-mask {
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 30%;
    background: transparent;
    z-index: 10;
    cursor: pointer;
    transform: translateY(-50%);
    display: none;
}
#shopify-section-{{ section.id }} .video-mask.active {
    display: block;
}

#shopify-section-{{ section.id }} .clip-card .deferred-media__poster{
    border-radius: 15px;
}
#shopify-section-{{ section.id }} .clip-card .deferred-media__poster img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
}
#shopify-section-{{ section.id }} .clip-card video,
#shopify-section-{{ section.id }} .clip-card iframe {
    left: 0;
    width: 100%;
    height: auto;
    aspect-ratio: 352 / 529;
    object-fit: contain;
    border-radius: 15px;
}
#shopify-section-{{ section.id }} .card-info {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
}
#shopify-section-{{ section.id }} .card-info .date{
    color: rgba(49,49,49,.7);
}
#shopify-section-{{ section.id }} .card-info .footer-left{
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
}
#shopify-section-{{ section.id }} .card-info .footer-left .creator-name{
    margin: 0;
}
#shopify-section-{{ section.id }} .card-info::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9), rgba(0, 0, 0.5) 70%, transparent 100%);
    z-index: 0;
    pointer-events: none;
    border-radius: 0 0 15px 15px;
}
#shopify-section-{{ section.id }} .clip-title {
    position: relative;
    margin: 0 auto;
    color: #ffffff;
    padding: 18px 20px;
    text-align: left;
}
#shopify-section-{{ section.id }} .clip-title p{
    margin: 0;
}

#shopify-section-{{ section.id }} .card-footer {
    position: relative;
    top: 1px;
    display: flex;
    justify-content: space-between;
    padding: 10px 10px 10px 22px;
    align-items: center;
    color: #313131;
    background: #f5f5f5;
    border-radius: 15px;
    box-shadow: 0 0 0 1px #f5f5f5;
    pointer-events: none;
}
#shopify-section-{{ section.id }} .card-footer .custom-product-link{
    pointer-events: auto;
}
#shopify-section-{{ section.id }} .card-footer .platform-icon{
    width: 24px;
    height: 24px;
    pointer-events: auto;
}

#shopify-section-{{ section.id }} .custom-product-link{
    width: 60px;
    height: 60px;
    background-color: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 15px;
    flex-shrink:0;
}
#shopify-section-{{ section.id }} .custom-product-link img{
    width: 45px;
    height: 45px;
    flex-shrink:0;
}

@media (max-width: 1440px){
    #shopify-section-{{ section.id }} .clip-card{
      width: 352px;
    }
}
@media (max-width: 1024px){
    #shopify-section-{{ section.id }} .section-title {
       max-width: 673px;
    }
    #shopify-section-{{ section.id }} .clip-card{
      width: 352px;
    }
}

@media (max-width: 767px){
    #shopify-section-{{ section.id }} .section-title {
       max-width: 621px;
    }
    #shopify-section-{{ section.id }} .clip-card{
      aspect-ratio: 458 / 700;
      width: 62vw;
      height: auto;
      max-width: 458px;
    }
    #shopify-section-{{ section.id }} .clip-title {
      padding: 25px 29px;
    }
    #shopify-section-{{ section.id }} .card-footer{
      padding: 10px 10px 10px 25px;
    }
    #shopify-section-{{ section.id }} .card-footer .platform-icon{
      width: 36px;
      height: 36px;
    }
    #shopify-section-{{ section.id }} .custom-product-link{
      width: calc(100vw * 80 / var(--base-width));
      height: calc(100vw * 80 / var(--base-width));
    }
    #shopify-section-{{ section.id }} .custom-product-link img{
      width: calc(100vw * 60 / var(--base-width));
      height: calc(100vw * 60 / var(--base-width));
    }
}
@media (max-width: 480px) {
    #shopify-section-{{ section.id }} .section-title{
      max-width: 80vw;
    }
    #shopify-section-{{ section.id }} .clip-card  {
      aspect-ratio: 458 / 700;
      max-width: 50vw;
      height: auto;
    }
    #shopify-section-{{ section.id }} .clip-title {
      padding: 10px 16px;
    }
    #shopify-section-{{ section.id }} .card-footer{
      padding: 10px 10px 10px 16px;
    }
    #shopify-section-{{ section.id }} .card-footer .platform-icon{
      width: 20px;
      height: 20px;
    }
}

#shopify-section-{{ section.id }} .explore-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 10px 30px;
    background: {{ section.settings.button_bg_color }};
    color: #fff;
    border-radius: 55px;
    text-decoration: none;
    transition: background 0.3s ease;
}
#shopify-section-{{ section.id }} .explore-btn:hover{
    background-color:#e55a0f;
}
{%- endstyle -%}

<div id="shopify-section-{{ section.id }}" class="creator-carousel-section page-width">
  {% if section.settings.heading != blank %}
    <h2 class="section-title font-h2">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="carousel-wrapper">
    <!-- Swiper 标准结构 -->
    <div class="swiper creator-swiper-{{ section.id }}">
      <div class="swiper-wrapper">
        {% for repeat in (1..3) %}
           {% for block in section.blocks %}
          <div class="swiper-slide">
            <div class="clip-card">
              <div class="video-mask"></div>
              {% render 'video-snippet',
                video: block.settings.video,
                video_url: block.settings.video_url,
                cover_image: block.settings.cover_image,
                description: block.settings.title,
                enable_video_looping: false,
                full_width: true,
                color_scheme: 'scheme-1',
                padding_top: 0,
                padding_bottom: 0,
                heading: '',
                heading_size: 'h2',
                section_id: section.id
              %}
              <div class="card-info">
                <div class="clip-title font-text-4">{{ block.settings.title }}</div>
                <div class="card-footer">
                  <div class="footer-left">
                    <p class="creator-name font-text-2">@{{ block.settings.creator }}</p>
                    <span class="date font-text-5">{{ block.settings.date }}</span>
                  </div>
                  {% assign custom_product = block.settings.single_feature_product %}
                  {% if custom_product != blank %}
                    <a class="custom-product-link" href="{{ custom_product.url }}">
                      <img 
                        src="{{ custom_product.featured_image | image_url: width: 120 }}" 
                        loading="lazy" 
                        alt="{{ custom_product.title | escape }}"
                        width="60"
                        height="60"
                      >
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
        {%  endfor %}  
      </div>
    </div>
  </div>

  {% if section.settings.button_text != blank %}
    <a href="{{ section.settings.button_link }}" class="explore-btn font-button-1">
      {{ section.settings.button_text }}
      {% if section.settings.button_icon != blank %}
        {{ section.settings.button_icon | inline_asset_content }}
      {% else %}
       <svg xmlns="http://www.w3.org/2000/svg" width="9" height="15" viewBox="0 0 9 14" fill="none">
                  <path d="M1.59071 13.589L1.53409 13.6401C1.2395 13.8806 0.804746 13.8637 0.530054 13.589C0.255361 13.3143 0.238401 12.8795 0.478954 12.5849L0.530054 12.5283L6.5301 6.52826C6.823 6.23537 7.29787 6.23537 7.59076 6.52826C7.88366 6.82116 7.88366 7.29603 7.59076 7.58892L1.59071 13.589Z" fill="currentColor"></path>
                  <path d="M0.539529 1.59031L0.487739 1.533C0.247784 1.23842 0.265054 0.804125 0.539529 0.52965C0.814004 0.255175 1.2483 0.237905 1.54288 0.47786L1.60019 0.52965L5.84283 4.77229C6.13572 5.06518 6.13572 5.54006 5.84283 5.83295C5.54994 6.12584 5.07506 6.12584 4.78217 5.83295L0.539529 1.59031Z" fill="currentColor"></path>
                </svg>
      {% endif %}
    </a>
  {% endif %}
</div>
<script>
(function() {
  const sectionId = "{{ section.id }}";
  const sectionSelector = '#shopify-section-' + sectionId;
  const swiperEl = document.querySelector(`${sectionSelector} .creator-swiper-${sectionId}`);
  let swiperInstance = null;

  // 暂停所有视频
  function pauseAllVideos() {
    document.querySelectorAll('video').forEach(vid => {
      try { vid.pause(); } catch (e) {}
    });
    document.querySelectorAll('.js-youtube').forEach(iframe => {
      try {
        iframe.contentWindow.postMessage(
          JSON.stringify({ event: 'command', func: 'pauseVideo' }),
          '*'
        );
      } catch (e) {}
    });
    document.querySelectorAll('.js-vimeo').forEach(iframe => {
      try {
        iframe.contentWindow.postMessage(
          JSON.stringify({ method: 'pause' }),
          '*'
        );
      } catch (e) {}
    });
  }

  // 恢复封面状态
  function showPoster(mediaEl) {
    if (!mediaEl) return;
    mediaEl.classList.remove('loaded');
    const poster = mediaEl.querySelector('.deferred-media__poster');
    if (poster) {
      poster.style.display = 'block';
      poster.style.zIndex = 3;
    }
  }

  // 触发播放
  function triggerPlay(mediaEl) {
    if (!mediaEl) return;
    mediaEl.classList.add('loaded');
    const posterBtn = mediaEl.querySelector('.deferred-media__poster');
    if (posterBtn) posterBtn.click();

    const youtubeIframe = mediaEl.querySelector('.js-youtube');
    const vimeoIframe = mediaEl.querySelector('.js-vimeo');
    const nativeVideo = mediaEl.querySelector('video');

    if (youtubeIframe) {
      youtubeIframe.contentWindow.postMessage(
        JSON.stringify({ event: 'command', func: 'playVideo' }),
        '*'
      );
    }
    if (vimeoIframe) {
      vimeoIframe.contentWindow.postMessage(
        JSON.stringify({ method: 'play' }),
        '*'
      );
    }
    if (nativeVideo) {
      nativeVideo.play().catch(() => {});
    }
  }

  // 重置所有蒙层
  function resetAllMask() {
    document.querySelectorAll(`${sectionSelector} .video-mask`).forEach(mask => {
      mask.classList.remove('active');
    });
  }

  // 判断是否有视频正在播放，控制swiper自动播放
  function checkVideoPlayingState() {
    const allMasks = document.querySelectorAll(`${sectionSelector} .video-mask`);
    let hasActive = false;
    allMasks.forEach(mask => {
      if (mask.classList.contains('active')) hasActive = true;
    });
    if (!swiperInstance) return;
    if (hasActive) {
      swiperInstance.autoplay.stop();
    } else {
      swiperInstance.autoplay.start();
    }
  }

  // 视口监听
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!swiperInstance) return;
      if (entry.isIntersecting) {
        checkVideoPlayingState();
      } else {
        swiperInstance.autoplay.stop();
        pauseAllVideos();
        resetAllMask();
        document.querySelectorAll(`${sectionSelector} .clip-card`).forEach(card => {
          showPoster(card.querySelector('deferred-media'));
          const info = card.querySelector('.card-info');
          if (info) info.style.display = 'block';
        });
      }
    });
  }, { threshold: 0.1 });

  document.addEventListener('DOMContentLoaded', () => {
    if (!swiperEl || !window.Swiper) return;

    // 初始化Swiper：speed改为8000提速，完善拖拽标记
    swiperInstance = new Swiper(swiperEl, {
      slidesPerView: 'auto',
      spaceBetween: 12,
      loop: true,
      autoplay: {
        delay: 0,
        disableOnInteraction: false,
      },
      speed: 8000, // 数值越小滚动越快，原15000→8000提速
      allowTouchMove: true,
      on: {
        touchStart() {
          this.isDragging = false;
        },
        touchMove() {
          this.isDragging = true;
        },
        touchEnd() {
          // 拖拽结束延迟重置标记，防止松手瞬间触发click
          setTimeout(() => {
            this.isDragging = false;
          }, 100)
        }
      }
    });

    observer.observe(swiperEl);

    // 修复：鼠标移入强制停止自动滚动
    swiperEl.addEventListener('mouseenter', () => {
      if (swiperInstance.autoplay.running) {
        swiperInstance.autoplay.stop();
      }
    });
    // 鼠标移出恢复自动滚动
    swiperEl.addEventListener('mouseleave', () => {
      checkVideoPlayingState();
    });

    // 绑定卡片视频点击事件
    const allCards = swiperEl.querySelectorAll('.clip-card');
    allCards.forEach(card => {
      const posterBtn = card.querySelector('.deferred-media__poster');
      const mask = card.querySelector('.video-mask');
      if (!posterBtn || !mask) return;

      // 封面点击播放视频：拖拽拦截
      posterBtn.addEventListener('click', (e) => {
        if (swiperInstance.isDragging) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        pauseAllVideos();
        resetAllMask();
        allCards.forEach(item => {
          const dm = item.querySelector('deferred-media');
          const info = item.querySelector('.card-info');
          const poster = dm?.querySelector('.deferred-media__poster');
          const itemMask = item.querySelector('.video-mask');
          if (item !== card) {
            showPoster(dm);
            if (info) info.style.display = 'block';
          } else {
            if (poster) {
              poster.style.display = 'block';
              poster.style.zIndex = 0;
            }
            if (info) info.style.display = 'none';
            triggerPlay(dm);
            itemMask.classList.add('active');
          }
        });
        checkVideoPlayingState();
      });

      // 蒙层点击关闭视频
      mask.addEventListener('click', (e) => {
        e.stopPropagation();
        if (swiperInstance.isDragging) return;
        pauseAllVideos();
        mask.classList.remove('active');
        const dm = card.querySelector('deferred-media');
        const info = card.querySelector('.card-info');
        showPoster(dm);
        if (info) info.style.display = 'block';
        checkVideoPlayingState();
      });
    });
  });
})();
</script>

{% schema %}
