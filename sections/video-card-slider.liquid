<script>
document.addEventListener('DOMContentLoaded', () => {
  const section = document.querySelector('#shopify-section-{{ section.id }}');
  if (!section) return;

  const slider = section.querySelector('.featureSwiper');
  const prevBtn = section.querySelector('.prev-btn');
  const nextBtn = section.querySelector('.next-btn');
  if (!slider) return;

  const swiper = new Swiper(slider, {
    slidesPerView: 'auto',
    slidesPerGroup: 1,
    spaceBetween: 16,
    speed: 400,
    allowTouchMove: true,
    centeredSlides: true,
    watchSlidesProgress: true,
    virtualTranslate: false,
    threshold: 20,
    resistance: true,
    loop: true,
    navigation: {
      prevEl: prevBtn,
      nextEl: nextBtn
    },
    pauseOnMouseEnter: false,
    breakpoints: {
      768: { spaceBetween: 15 },
      480: { spaceBetween: 13 },
      300: { spaceBetween: 12 }
    }
  });

  let allowAutoSlide = true;
  let isHovering = false;
  let autoSlideTimer = null;
  const AUTO_SLIDE_DELAY = 3000;

  const updateAutoSlideTimer = () => {
    if (autoSlideTimer) {
      clearInterval(autoSlideTimer);
      autoSlideTimer = null;
    }
    if (allowAutoSlide === true && isHovering === false) {
      autoSlideTimer = setInterval(() => {
        if (allowAutoSlide === true && isHovering === false) {
          swiper.slideNext();
        }
      }, AUTO_SLIDE_DELAY);
    }
  };

  slider.addEventListener('mouseenter', () => {
    isHovering = true;
    updateAutoSlideTimer();
  });

  slider.addEventListener('mouseleave', () => {
    isHovering = false;
    globalCheckAllVideoState();
  });

  const getAllVideoElements = () => Array.from(section.querySelectorAll('video'));
  const getAllIframeMedia = () => Array.from(section.querySelectorAll('deferred-media iframe'));

  const nativeVideoIsPlaying = () => {
    return getAllVideoElements().some(v => !v.paused && !v.ended);
  };

  const iframeHasActiveVideo = () => {
    const allIframes = getAllIframeMedia();
    return allIframes.some(iframe => {
      const src = iframe.getAttribute('src') || '';
      return src.includes('autoplay=1') && src.length > 10;
    });
  };

  const updateAutoSlideState = (anyPlaying) => {
    allowAutoSlide = !anyPlaying;
    updateAutoSlideTimer();
  };

  const resetDeferredMediaToCover = (deferred) => {
    if (!deferred) return;

    deferred.querySelectorAll('video, iframe').forEach(media => {
      media.remove();
    });
    deferred.removeAttribute('loaded');

    const poster = deferred.querySelector('.deferred-media__poster');
    if (poster) poster.style.display = '';
  };

  let youtubeApiReady = null;
  const loadYouTubeApi = () => {
    if (window.YT && window.YT.Player) return Promise.resolve();
    if (youtubeApiReady) return youtubeApiReady;

    youtubeApiReady = new Promise(resolve => {
      const previousCallback = window.onYouTubeIframeAPIReady;

      window.onYouTubeIframeAPIReady = () => {
        if (typeof previousCallback === 'function') previousCallback();
        resolve();
      };

      if (!document.querySelector('script[src="https://www.youtube.com/iframe_api"]')) {
        const script = document.createElement('script');
        script.src = 'https://www.youtube.com/iframe_api';
        document.head.appendChild(script);
      }
    });

    return youtubeApiReady;
  };

  const bindYouTubeIframeEvents = (iframe) => {
    if (iframe.dataset._eventsBound === 'true') return;
    iframe.dataset._eventsBound = 'true';

    if (!iframe.id) {
      iframe.id = `video-card-youtube-{{ section.id }}-${Date.now()}-${Math.round(Math.random() * 1000)}`;
    }

    loadYouTubeApi().then(() => {
      if (!document.body.contains(iframe)) return;

      new YT.Player(iframe.id, {
        events: {
          onStateChange(event) {
            if (event.data === YT.PlayerState.PLAYING) {
              updateAutoSlideState(true);
            }
            if (event.data === YT.PlayerState.PAUSED || event.data === YT.PlayerState.ENDED) {
              resetDeferredMediaToCover(iframe.closest('deferred-media'));
              globalCheckAllVideoState();
            }
          }
        }
      });
    });
  };

  const bindVimeoIframeEvents = (iframe) => {
    if (iframe.dataset._eventsBound === 'true') return;
    iframe.dataset._eventsBound = 'true';

    const addListener = (eventName) => {
      if (!document.body.contains(iframe) || !iframe.contentWindow) return;

      iframe.contentWindow.postMessage(JSON.stringify({
        method: 'addEventListener',
        value: eventName
      }), '*');
    };

    const addVimeoListeners = () => {
      addListener('play');
      addListener('pause');
      addListener('finish');
    };

    iframe.addEventListener('load', addVimeoListeners);
    setTimeout(addVimeoListeners, 300);
  };

  const bindIframeEvents = () => {
    getAllIframeMedia().forEach(iframe => {
      if (iframe.classList.contains('js-youtube')) {
        bindYouTubeIframeEvents(iframe);
      } else if (iframe.classList.contains('js-vimeo')) {
        bindVimeoIframeEvents(iframe);
      }
    });
  };

  window.addEventListener('message', event => {
    let data = event.data;
    if (typeof data === 'string') {
      try {
        data = JSON.parse(data);
      } catch (error) {
        return;
      }
    }

    if (!data || !data.event) return;

    const iframe = getAllIframeMedia().find(media => media.contentWindow === event.source);
    if (!iframe || !iframe.classList.contains('js-vimeo')) return;

    if (data.event === 'play') {
      updateAutoSlideState(true);
    }
    if (data.event === 'pause' || data.event === 'finish') {
      resetDeferredMediaToCover(iframe.closest('deferred-media'));
      globalCheckAllVideoState();
    }
  });

  // 全局检测视频状态，只控制自动轮播，不影响手动滑动
  const globalCheckAllVideoState = () => {
    const anyPlaying = nativeVideoIsPlaying() || iframeHasActiveVideo();
    updateAutoSlideState(anyPlaying);
  };

  const bindVideoEvents = () => {
    const allVideos = getAllVideoElements();
    allVideos.forEach(video => {
      if (video.dataset._eventsBound === 'true') return;
      video.dataset._eventsBound = 'true';
      video.addEventListener('play', globalCheckAllVideoState);
      video.addEventListener('playing', globalCheckAllVideoState);
      // 暂停、结束事件立即恢复封面和自动轮播
      video.addEventListener('pause', () => {
        resetDeferredMediaToCover(video.closest('deferred-media'));
        globalCheckAllVideoState();
      });
      video.addEventListener('ended', () => {
        resetDeferredMediaToCover(video.closest('deferred-media'));
        globalCheckAllVideoState();
      });
    });
  };

  bindVideoEvents();
  bindIframeEvents();
  updateAutoSlideTimer();

  const deferredMedias = section.querySelectorAll('deferred-media');
  deferredMedias.forEach(deferred => {
    const playTrigger = deferred.querySelector('.deferred-media__poster, button');
    if (playTrigger) {
      playTrigger.addEventListener('click', () => {
        updateAutoSlideState(true);
        setTimeout(() => {
          bindVideoEvents();
          bindIframeEvents();
          globalCheckAllVideoState();
        }, 300);
      });
    }

    // 关闭按钮点击，立刻执行状态检测，恢复自动轮播
    const closeBtn = deferred.querySelector('[data-deferred-media-close]');
    if (closeBtn) {
      closeBtn.addEventListener('click', globalCheckAllVideoState);
    }

    deferred.addEventListener('click', () => {
      setTimeout(globalCheckAllVideoState, 300);
    });
  });

  // 兜底轮询仅作保险，不影响手动滑动
  setInterval(globalCheckAllVideoState, 5000);

  const touchElements = section.querySelectorAll('.feature-card, .feature-card *');
  touchElements.forEach(el => {
    el.style.touchAction = 'pan-x pan-y';
    el.addEventListener('touchstart', () => {}, { passive: true });
  });

  const cards = section.querySelectorAll('.feature-card');
  if (cards.length) {
    gsap.set(cards, { y: 30, opacity: 0 });
    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        gsap.to(cards, {
          y: 0,
          opacity: 1,
          duration: 0.8,
          ease: 'power2.out',
          stagger: 0.15
        });
        observer.unobserve(section);
      }
    }, { threshold: 0.2 });
    observer.observe(section);
  }
});
</script>
