<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.querySelector('#shopify-section-{{ section.id }}');
    const compareData = JSON.parse(document.getElementById('CompareData-{{ section.id }}').textContent);
    const viewMoreBtn = section.querySelector('.btn-view-more');
    const mobileContainer = section.querySelector('.mobile-scroll-container');
    const desktopGrid = section.querySelector('.comp-desktop-only .comp-grid');
    let stickyOffsetFrame;

    function updateComparisonStickyOffset() {
      window.updateHeaderBottomPosition?.();

      const header = document.querySelector('.header-valtinsu');
      const headerSection = document.querySelector('.section-header');
      const headerRect = header?.getBoundingClientRect();
      let offset = 0;

      if (!headerSection?.classList.contains('shopify-section-header-hidden') && headerRect && headerRect.height > 0 && headerRect.bottom > 0) {
        offset = Math.ceil(headerRect.bottom) - 2;
      }

      section.style.setProperty('--comparison-sticky-offset', `${offset}px`);
    }

    function requestComparisonStickyOffsetUpdate() {
      window.cancelAnimationFrame(stickyOffsetFrame);
      stickyOffsetFrame = window.requestAnimationFrame(updateComparisonStickyOffset);
    }

    updateComparisonStickyOffset();
    window.addEventListener('scroll', requestComparisonStickyOffsetUpdate, { passive: true });
    window.addEventListener('resize', requestComparisonStickyOffsetUpdate);

    function setHoveredColumn(colIndex) {
      section.querySelectorAll('.comp-desktop-only .comp-cell[data-col]').forEach((cell) => {
        cell.classList.toggle('is-column-hover', cell.getAttribute('data-col') === colIndex);
      });
    }

    function clearHoveredColumn() {
      section.querySelectorAll('.comp-desktop-only .comp-cell.is-column-hover').forEach((cell) => {
        cell.classList.remove('is-column-hover');
      });
    }

    if (desktopGrid) {
      desktopGrid.addEventListener('mouseover', (event) => {
        const cell = event.target.closest('.comp-cell[data-col]');
        if (!cell || !desktopGrid.contains(cell)) return;
        setHoveredColumn(cell.getAttribute('data-col'));
      });

      desktopGrid.addEventListener('mouseleave', clearHoveredColumn);
      desktopGrid.addEventListener('focusin', (event) => {
        const cell = event.target.closest('.comp-cell[data-col]');
        if (!cell || !desktopGrid.contains(cell)) return;
        setHoveredColumn(cell.getAttribute('data-col'));
      });
      desktopGrid.addEventListener('focusout', (event) => {
        if (desktopGrid.contains(event.relatedTarget)) return;
        clearHoveredColumn();
      });
    }

    if (viewMoreBtn && mobileContainer) {
      viewMoreBtn.addEventListener('click', function (e) {
        e.preventDefault();
        const isExpanded = mobileContainer.classList.toggle('is-expanded');
        
        if (isExpanded) {
          this.textContent = 'View Less';
          this.classList.add('active');
        } else {
          this.textContent = 'View More';
          this.classList.remove('active');
          
          const offsetTop = section.offsetTop;
          window.scrollTo({
            top: offsetTop - 50,
            behavior: 'smooth'
          });
        }
      });
    }

    // 修复滚动：阻止冒泡
    function enablePanelScroll() {
      const panels = section.querySelectorAll('.dropdown-panel');
      panels.forEach((panel) => {
        panel.addEventListener('wheel', (e) => e.stopPropagation(), { passive: true });
        panel.addEventListener('touchmove', (e) => e.stopPropagation(), { passive: true });
      });
    }

    function updateColumn(colIndex, productId, priceEl, comparePriceEl) {
      const data = compareData[productId];
      if (!data) return;

      // 更新名称
      section.querySelectorAll(`.js-dropdown[data-col="${colIndex}"]`).forEach(dropdown => {
        dropdown.querySelector('.js-current-name').textContent = data.title;
        dropdown.querySelectorAll('.js-dropdown-option').forEach(opt => {
          opt.classList.toggle('is-selected', opt.getAttribute('data-product-id') == productId);
        });
      });

      // 更新主图
      section.querySelectorAll(`.js-comp-img[data-col="${colIndex}"]`).forEach(img => {
        img.src = data.image;
      });

      // ===================== 核心：更新价格（从 data 属性读取） =====================
      const priceCell = section.querySelector(`.price-row .js-comp-val[data-col="${colIndex}"]`);
      if (priceCell) {
        const currentPrice = priceCell.querySelector('.price-text');
        const comparePrice = priceCell.querySelector('.price-text-compare');
        if (currentPrice) currentPrice.textContent = priceEl || '';
        if (comparePrice) {
          comparePrice.textContent = comparePriceEl || '';
          comparePrice.style.display = comparePriceEl ? 'inline-block' : 'none';
        }
      }

      // 更新参数
      section.querySelectorAll(`.js-comp-val[data-col="${colIndex}"]`).forEach((container) => {
        const label = container.getAttribute('data-label');
        if (label === 'Price') return;
        
        const spec = data.specs[label];
        const iconImg = container.querySelector('.js-spec-icon');
        const textSpan = container.querySelector('.js-spec-text');

        if (spec) {
          if (iconImg) {
            iconImg.src = spec.icon || '';
            iconImg.style.display = spec.icon ? 'block' : 'none';
          }
          if (textSpan) textSpan.textContent = spec.value || '-';
        } else {
          if (iconImg) iconImg.style.display = 'none';
          if (textSpan) textSpan.textContent = '-';
        }
      });
    }

    // 事件委托
    section.addEventListener('click', (e) => {
      const trigger = e.target.closest('.js-dropdown-trigger');
      const option = e.target.closest('.js-dropdown-option');
      const closeBtn = e.target.closest('.js-close-modal');

      if (trigger) {
        const d = trigger.closest('.js-dropdown');
        const isOpen = d.classList.contains('is-open');
        section.querySelectorAll('.js-dropdown').forEach(el => el.classList.remove('is-open'));
        if (!isOpen) {
          d.classList.add('is-open');
          if (window.innerWidth <= 767) document.body.classList.add('modal-open');
        } else {
          document.body.classList.remove('modal-open');
        }
      } else if (option) {
        const container = option.closest('.js-dropdown');
        const colIndex = container.getAttribute('data-col');
        const productId = option.getAttribute('data-product-id');
        
        // ===================== 读取点击项的价格 =====================
        const price = option.getAttribute('data-price');
        const comparePrice = option.getAttribute('data-compare-price');

        // 传入价格进行更新
        updateColumn(colIndex, productId, price, comparePrice);

        container.classList.remove('is-open');
        document.body.classList.remove('modal-open');
      } else if (closeBtn || !e.target.closest('.dropdown-panel')) {
        section.querySelectorAll('.js-dropdown').forEach(el => el.classList.remove('is-open'));
        document.body.classList.remove('modal-open');
      }
    });

    enablePanelScroll();

    // 手机端 Slider & Tabs 联动
    const slider = section.querySelector('.mobile-specs-slider');
    const tabs = section.querySelectorAll('.tab-btn');
    const nav = section.querySelector('.mobile-tabs-nav');
    if (slider) {
      slider.addEventListener('scroll', () => {
        const index = Math.round(slider.scrollLeft / slider.offsetWidth);
        tabs.forEach((tab, i) => {
          tab.classList.toggle('active', i === index);
          if (i === index && nav) {
            nav.scrollTo({ left: tab.offsetLeft - nav.offsetWidth/2 + tab.offsetWidth/2, behavior: 'smooth' });
          }
        });
      });
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => slider.scrollTo({ left: slider.offsetWidth * i, behavior: 'smooth' }));
      });
    }
  });
</script>

