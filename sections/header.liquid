<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link
  rel="stylesheet"
  href="{{ 'component-cart-notification.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>

{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{%- if section.settings.menu_type_desktop == 'mega' -%}
  <link rel="stylesheet" href="{{ 'component-mega-menu.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

<style>
  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 990px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  summary.list-menu__item {
    padding-right: 2.7rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }
</style>

{%- style -%}
  .header {
    padding: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px 3rem {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px 3rem;
  }

  .section-header {
    position: sticky; /* This is for fixing a Safari z-index issue. PR #2147 */
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  .section-header.shopify-section-header-fixed-on-scroll.shopify-section-header-sticky {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    width: 100%;
    margin-bottom: 0;
    z-index: 20;
  }

  .section-header.shopify-section-header-fixed-on-scroll.shopify-section-header-hidden {
    top: calc(-1 * var(--header-height));
  }

  .section-header.shopify-section-header-fixed-on-scroll.shopify-section-header-hidden.menu-open {
    top: 0;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}   

{%- liquid
  assign header_white_logo = settings.logo
  if settings.white_background_logo != blank
    assign header_white_logo = settings.white_background_logo
  endif

  assign header_floating_style = 'none'
  case request.page_type
    when 'index'
      assign header_floating_style = section.settings.floating_header_home_style
    when 'product'
      assign header_floating_style = section.settings.floating_header_products_style
    when 'collection'
      assign header_floating_style = section.settings.floating_header_collections_style
    when 'page'
      assign header_floating_style = section.settings.floating_header_pages_style
    when 'blog'
      assign header_floating_style = section.settings.floating_header_blogs_style
    when 'article'
      assign header_floating_style = section.settings.floating_header_articles_style
  endcase

  if header_floating_style == blank
    if request.page_type == 'index'
      assign header_floating_style = 'transparent'
    else
      assign header_floating_style = 'none'
    endif
  endif

  if request.page_type == 'page' and section.settings.floating_header_transparent_page_names != blank and page.title != blank
    assign current_page_title = page.title | strip | downcase
    assign transparent_page_names = section.settings.floating_header_transparent_page_names | split: ','

    for transparent_page_name in transparent_page_names
      assign transparent_page_title = transparent_page_name | strip | downcase
      if transparent_page_title == current_page_title
        assign header_floating_style = 'transparent'
        break
      endif
    endfor
  endif

  assign header_floating_enabled = false
  if header_floating_style != 'none'
    assign header_floating_enabled = true
  endif

  assign header_transparent_enabled = false
  if header_floating_style == 'transparent'
    assign header_transparent_enabled = true
  endif

  assign header_home_transparent_logo = blank
  if header_transparent_enabled and settings.home_transparent_logo != blank
    assign header_home_transparent_logo = settings.home_transparent_logo
  endif
-%}

{% liquid
  assign header_tag = 'div'

  if section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif
%}

<{{ header_tag }}
  {% if header_tag == 'sticky-header' %}
    data-sticky-type="{{ section.settings.sticky_header_type }}"
  {% endif %}
  class="header-valtinsu-wrapper header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}{% if header_floating_enabled %} header-valtinsu-wrapper--floating{% endif %}{% if header_transparent_enabled %} header-valtinsu-wrapper--home{% endif %}"
>
  {%- liquid
    assign social_links = false
    assign localization_forms = false

    if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank
      assign social_links = true
    endif

    if localization.available_countries.size > 1 and section.settings.enable_country_selector or section.settings.enable_language_selector and localization.available_languages.size > 1
      assign localization_forms = true
    endif
  -%}
  <header class="header-valtinsu header{% if header_transparent_enabled %} header-valtinsu--home{% endif %} header--{{ section.settings.logo_position }} header--mobile-{{ section.settings.mobile_logo_position }} page-width{% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}{% if social_links %} header--has-social{% endif %}{% if shop.customer_accounts_enabled %} header--has-account{% endif %}{% if localization_forms %} header--has-localizations{% endif %}">


    {%- if section.settings.logo_position != 'middle-center' -%}
    
      <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
        {%- if header_white_logo != blank or header_home_transparent_logo != blank -%}
          <div class="header__heading-logo-wrapper{% if header_home_transparent_logo != blank %} header__heading-logo-wrapper--has-transparent-home-logo{% endif %}{% if header_white_logo == blank %} header__heading-logo-wrapper--transparent-home-only{% endif %}">
            {% capture sizes %}(max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px{% endcapture %}
            {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
            {%- if header_white_logo != blank -%}
              {%- assign logo_alt = header_white_logo.alt | default: shop.name | escape -%}
              {%- assign logo_height = settings.logo_width | divided_by: header_white_logo.aspect_ratio -%}
              {%- assign white_logo_class = 'header__heading-logo header__heading-logo--white-background motion-reduce' -%}
              {%- if settings.white_background_logo == blank and header_home_transparent_logo == blank -%}
                {%- assign white_logo_class = white_logo_class | append: ' header__heading-logo--invert-on-home' -%}
              {%- endif -%}
              {{
                header_white_logo
                | image_url: width: 600
                | image_tag:
                  class: white_logo_class,
                  widths: widths,
                  height: logo_height,
                  width: settings.logo_width,
                  alt: logo_alt,
                  sizes: sizes,
                  preload: true
              }}
            {%- endif -%}
            {%- if header_home_transparent_logo != blank -%}
              {%- assign home_logo_alt = header_home_transparent_logo.alt | default: shop.name | escape -%}
              {%- assign home_logo_height = settings.logo_width | divided_by: header_home_transparent_logo.aspect_ratio -%}
              {{
                header_home_transparent_logo
                | image_url: width: 600
                | image_tag:
                  class: 'header__heading-logo header__heading-logo--transparent-home motion-reduce',
                  widths: widths,
                  height: home_logo_height,
                  width: settings.logo_width,
                  alt: home_logo_alt,
                  sizes: sizes,
                  preload: true
              }}
            {%- endif -%}
          </div>
        {%- else -%}
          <span class="h2">{{ shop.name }}</span>
        {%- endif -%}
      </a>
   
    {%- endif -%}

    {%- liquid
      if section.settings.menu != blank
        render 'header-drawer'
      endif

      if section.settings.logo_position == 'top-center' or section.settings.menu == blank
        render 'header-search', input_id: 'Search-In-Modal-1'
      endif
    -%}

    {%- liquid
      if section.settings.menu != blank
        if section.settings.menu_type_desktop == 'dropdown'
          render 'header-dropdown-menu'
        elsif section.settings.menu_type_desktop != 'drawer'
          render 'header-mega-menu'
        endif
      endif
    %}

    {%- if section.settings.logo_position == 'middle-center' -%}
      
      <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
        {%- if header_white_logo != blank or header_home_transparent_logo != blank -%}
          <div class="header__heading-logo-wrapper{% if header_home_transparent_logo != blank %} header__heading-logo-wrapper--has-transparent-home-logo{% endif %}{% if header_white_logo == blank %} header__heading-logo-wrapper--transparent-home-only{% endif %}">
            {% capture sizes %}(min-width: 750px) {{ settings.logo_width }}px, 50vw{% endcapture %}
            {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
            {%- if header_white_logo != blank -%}
              {%- assign logo_alt = header_white_logo.alt | default: shop.name | escape -%}
              {%- assign logo_height = settings.logo_width | divided_by: header_white_logo.aspect_ratio -%}
              {%- assign white_logo_class = 'header__heading-logo header__heading-logo--white-background' -%}
              {%- if settings.white_background_logo == blank and header_home_transparent_logo == blank -%}
                {%- assign white_logo_class = white_logo_class | append: ' header__heading-logo--invert-on-home' -%}
              {%- endif -%}
              {{
                header_white_logo
                | image_url: width: 600
                | image_tag:
                  class: white_logo_class,
                  widths: widths,
                  height: logo_height,
                  width: settings.logo_width,
                  alt: logo_alt,
                  sizes: sizes,
                  preload: true
              }}
            {%- endif -%}
            {%- if header_home_transparent_logo != blank -%}
              {%- assign home_logo_alt = header_home_transparent_logo.alt | default: shop.name | escape -%}
              {%- assign home_logo_height = settings.logo_width | divided_by: header_home_transparent_logo.aspect_ratio -%}
              {{
                header_home_transparent_logo
                | image_url: width: 600
                | image_tag:
                  class: 'header__heading-logo header__heading-logo--transparent-home',
                  widths: widths,
                  height: home_logo_height,
                  width: settings.logo_width,
                  alt: home_logo_alt,
                  sizes: sizes,
                  preload: true
              }}
            {%- endif -%}
          </div>
        {%- else -%}
          <span class="h2">{{ shop.name }}</span>
        {%- endif -%}
      </a>
  
    {%- endif -%}

    <div class="header__icons{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header__icons--localization header-localization{% endif %}">
      <div class="desktop-localization-wrapper">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form class="small-hide medium-hide" data-prevent-hide>
            {%- form 'localization', id: 'HeaderCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="HeaderCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'HeaderCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {% endif %}

        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form class="small-hide medium-hide" data-prevent-hide>
            {%- form 'localization', id: 'HeaderLanguageForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="HeaderLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                {%- render 'language-localization', localPosition: 'HeaderLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>
      {% render 'header-search', input_id: 'Search-In-Modal' %}

      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="header__icon header__icon--account link focus-inset{% if section.settings.menu != blank %} small-hide{% endif %}"
          rel="nofollow"
        >
          {%- if section.settings.enable_customer_avatar -%}
            <account-icon>
              {%- if customer and customer.has_avatar? -%}
                {{ customer | avatar }}
              {%- else -%}
                <span class="svg-wrapper">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <path d="M10 7.66797C11.6569 7.66797 13 6.32482 13 4.66797C13 3.01111 11.6569 1.66797 10 1.66797C8.34315 1.66797 7 3.01111 7 4.66797C7 6.32482 8.34315 7.66797 10 7.66797Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M3 18C3.13725 15.3333 4.72941 10 10 10C15.2706 10 16.8627 15.3333 17 18" stroke="currentColor" stroke-linecap="round"/>
                  </svg>
                </span>
              {%- endif -%}
            </account-icon>
          {%- else -%}
            <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
          {%- endif -%}
          <span class="visually-hidden">
            {%- liquid
              if customer
                echo 'customer.account_fallback' | t
              else
                echo 'customer.log_in' | t
              endif
            -%}
          </span>
        </a>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}

      <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
        {% if cart == empty %}
          <span class="svg-wrapper"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
<path d="M13.125 4.5H4.875C4.25368 4.5 3.75 5.00368 3.75 5.625V14.625C3.75 15.2463 4.25368 15.75 4.875 15.75H13.125C13.7463 15.75 14.25 15.2463 14.25 14.625V5.625C14.25 5.00368 13.7463 4.5 13.125 4.5Z" stroke="currentColor" stroke-linejoin="round"/>
<path d="M11.25 6.75V3.75C11.25 2.50736 10.2426 1.5 9 1.5C7.75736 1.5 6.75 2.50736 6.75 3.75V6.75" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
</svg></span>
        {% else %}
          <span class="svg-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
<path d="M13.125 4.5H4.875C4.25368 4.5 3.75 5.00368 3.75 5.625V14.625C3.75 15.2463 4.25368 15.75 4.875 15.75H13.125C13.7463 15.75 14.25 15.2463 14.25 14.625V5.625C14.25 5.00368 13.7463 4.5 13.125 4.5Z" stroke="currentColor" stroke-linejoin="round"/>
<path d="M11.25 6.75V3.75C11.25 2.50736 10.2426 1.5 9 1.5C7.75736 1.5 6.75 2.50736 6.75 3.75V6.75" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
          </span>
        {% endif %}
        <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
        {%- if cart != empty -%}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>
    </div>
  </header>
</{{ header_tag }}>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification',
    color_scheme: section.settings.color_scheme,
    desktop_menu_type: section.settings.menu_type_desktop
  -%}
{%- endif -%}

{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.header = document.querySelector('.section-header');
      this.headerIsAlwaysSticky =
        this.getAttribute('data-sticky-type') === 'always' ||
        this.getAttribute('data-sticky-type') === 'reduce-logo-size';
      this.headerIsFixedOnScroll = this.getAttribute('data-sticky-type') === 'on-scroll-up';
      this.headerBounds = {};

      this.setHeaderHeight();

      window.matchMedia('(max-width: 990px)').addEventListener('change', this.setHeaderHeight.bind(this));

      if (this.headerIsAlwaysSticky) {
        this.header.classList.add('shopify-section-header-sticky');
      }

      if (this.headerIsFixedOnScroll) {
        this.header.classList.add('shopify-section-header-fixed-on-scroll');
      }

      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.predictiveSearch = this.querySelector('predictive-search');

      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => (this.preventReveal = true);

      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);

      this.createObserver();
    }

    setHeaderHeight() {
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`);
    }

    disconnectedCallback() {
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      let observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });

      observer.observe(this.header);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (this.predictiveSearch && this.predictiveSearch.isOpen) return;

      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        requestAnimationFrame(this.hide.bind(this));
      } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);

          this.isScrolling = setTimeout(() => {
            this.preventReveal = false;
          }, 66);

          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        this.header.classList.remove('scrolled-past-header');
        requestAnimationFrame(this.reset.bind(this));
      }

      this.currentScrollTop = scrollTop;
    }

    hide() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
      this.closeMenuDisclosure();
      this.closeSearchModal();
    }

    reveal() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
    }

    reset() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
    }

    closeMenuDisclosure() {
      this.disclosures = this.disclosures || this.header.querySelectorAll('header-menu');
      this.disclosures.forEach((disclosure) => disclosure.close());
    }

    closeSearchModal() {
      this.searchModal = this.searchModal || this.header.querySelector('details-modal');
      this.searchModal.close(false);
    }
  }

  customElements.define('sticky-header', StickyHeader);

  const headerMenuDesktop = window.matchMedia('(min-width: 990px)');
  const headerHoverDetails = Array.from(document.querySelectorAll('.header-valtinsu .header__inline-menu details'));
  let headerBottomPositionFrame;

  const updateHeaderBottomPosition = () => {
    const header = document.querySelector('.header-valtinsu');
    const headerRect = header?.getBoundingClientRect();
    const headerBottom = headerRect && headerRect.width > 0 && headerRect.height > 0 ? headerRect.bottom : 68;

    document.documentElement.style.setProperty(
      '--header-bottom-position-desktop',
      `${Math.ceil(Math.max(headerBottom, 0))}px`
    );
  };

  const requestHeaderBottomPositionUpdate = () => {
    window.cancelAnimationFrame(headerBottomPositionFrame);
    headerBottomPositionFrame = window.requestAnimationFrame(updateHeaderBottomPosition);
  };

  window.updateHeaderBottomPosition = updateHeaderBottomPosition;

  const getHeaderDetailsSummary = (details) => details.querySelector('summary');

  const closeHeaderDetails = (details, animateSuperMenu = true) => {
    const summary = getHeaderDetailsSummary(details);

    window.clearTimeout(details.headerHoverCloseTimer);
    window.clearTimeout(details.headerHoverRemoveOpenTimer);
    summary?.setAttribute('aria-expanded', false);

    if (details.classList.contains('header-super-menu-details') && animateSuperMenu) {
      details.classList.remove('header-super-menu--open');
      details.classList.add('header-super-menu--closing');

      details.headerHoverRemoveOpenTimer = window.setTimeout(() => {
        details.removeAttribute('open');
        details.classList.remove('header-super-menu--closing');
      }, 560);
      return;
    }

    details.removeAttribute('open');
    details.classList.remove('header-super-menu--open', 'header-super-menu--closing');
  };

  const closeOtherHeaderDetails = (activeDetails) => {
    headerHoverDetails.forEach((details) => {
      if (details === activeDetails || details.contains(activeDetails) || activeDetails.contains(details)) return;
      closeHeaderDetails(details, false);
    });
  };

  const openHeaderDetails = (details) => {
    const summary = getHeaderDetailsSummary(details);

    window.clearTimeout(details.headerHoverCloseTimer);
    window.clearTimeout(details.headerHoverRemoveOpenTimer);
    closeOtherHeaderDetails(details);
    updateHeaderBottomPosition();

    details.classList.remove('header-super-menu--closing');
    details.setAttribute('open', '');
    summary?.setAttribute('aria-expanded', true);

    if (details.classList.contains('header-super-menu-details')) {
      window.requestAnimationFrame(() => {
        updateHeaderBottomPosition();
        details.classList.add('header-super-menu--open');
      });
    }
  };

  headerHoverDetails.forEach((details) => {
    const summary = getHeaderDetailsSummary(details);

    details.addEventListener('mouseenter', () => {
      if (!headerMenuDesktop.matches) return;
      openHeaderDetails(details);
    });

    details.addEventListener('mouseleave', () => {
      if (!headerMenuDesktop.matches) return;
      details.headerHoverCloseTimer = window.setTimeout(() => {
        closeHeaderDetails(details);
      }, 120);
    });

    summary?.addEventListener('click', (event) => {
      if (!headerMenuDesktop.matches) return;
      event.preventDefault();
      openHeaderDetails(details);
    });

    details.addEventListener('toggle', () => {
      if (!details.classList.contains('header-super-menu-details')) return;

      if (details.open) {
        window.requestAnimationFrame(() => {
          details.classList.add('header-super-menu--open');
        });
      } else {
        details.classList.remove('header-super-menu--open', 'header-super-menu--closing');
      }
    });
  });

  const setMenuProductSuperMenuPanel = (container, tabIndex) => {
    const tabs = container.querySelectorAll('[data-menu-product-tab]');
    const panels = container.querySelectorAll('[data-menu-product-panel]');

    tabs.forEach((tab) => {
      const isActive = tab.dataset.menuProductTab === tabIndex;
      tab.classList.toggle('header-super-menu-sidebar__item--active', isActive);
      tab.classList.toggle('header-menu-product-super-menu-sidebar__item--active', isActive);
    });

    panels.forEach((panel) => {
      const isActive = panel.dataset.menuProductPanel === tabIndex;
      panel.classList.toggle('header-menu-product-super-menu-products__panel--active', isActive);
      panel.hidden = !isActive;
    });
  };

  document.querySelectorAll('.header-menu-product-super-menu-details, .header-menu-product-super-menu-drawer').forEach((container) => {
    container.querySelectorAll('[data-menu-product-tab]').forEach((tab) => {
      const tabIndex = tab.dataset.menuProductTab;

      tab.addEventListener('mouseenter', () => setMenuProductSuperMenuPanel(container, tabIndex));
      tab.addEventListener('focus', () => setMenuProductSuperMenuPanel(container, tabIndex));
      tab.addEventListener('click', (event) => {
        if (!tab.hasAttribute('data-menu-product-drawer-tab')) return;

        event.preventDefault();
        setMenuProductSuperMenuPanel(container, tabIndex);
      });
    });
  });

  headerMenuDesktop.addEventListener('change', (event) => {
    if (event.matches) {
      updateHeaderBottomPosition();
      return;
    }
    headerHoverDetails.forEach((details) => closeHeaderDetails(details, false));
  });

  window.addEventListener('resize', requestHeaderBottomPositionUpdate);
  window.addEventListener('scroll', requestHeaderBottomPositionUpdate, { passive: true });

  const sectionHeader = document.querySelector('.section-header');
  if (sectionHeader) {
    new MutationObserver(requestHeaderBottomPositionUpdate).observe(sectionHeader, {
      attributes: true,
      attributeFilter: ['class', 'style'],
    });
  }

  updateHeaderBottomPosition();
{% endjavascript %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if header_white_logo %}
      "logo": {{ header_white_logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

