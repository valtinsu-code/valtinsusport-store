{%- style -%}
#shopify-section-{{ section.id }}{
  background-color: {{section.settings.bg_color}};
  & h2,& p{
    margin: 0;
  }
  
}
#shopify-section-{{ section.id }} .gfb__footer .description{
  display:none;
}
#shopify-section-{{ section.id }} .panels,
#shopify-section-{{ section.id }} .gfb__footer,
#shopify-section-{{ section.id }} .gfb__footer .description{
  background-color: {{section.settings.bg_color}};
}
#shopify-section-{{ section.id }} .checkbox-wrapper{
  text-align: center;
}


  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .globo-form-control .checkbox-wrapper .checkbox-input~.checkbox-label:before,
  #shopify-section-{{ section.id }}  .globo-form-control .checkbox-wrapper .checkbox-input~.checkbox-label:after,
  #shopify-section-{{ section.id }} .globo-form-control .radio-wrapper .radio-input~.radio-label:before,
  #shopify-section-{{ section.id }} .globo-form-control .radio-wrapper .radio-input~.radio-label:after{
    border-radius: 3px;
    border-color: #000;
    width: 17px;
    height: 17px;
  }
  #shopify-section-{{ section.id }} input,
  #shopify-section-{{ section.id }} .flat-input,
  #shopify-section-{{ section.id }} .gfb__dropzone,
  #shopify-section-{{ section.id }} select,
  #shopify-section-{{ section.id }}  textarea{
    background-color: {{section.settings.input_bg_color}};
    border-radius: 15px;
  }

  
  #shopify-section-{{ section.id }} .flat-input{
    height: 69px;
  }
  #shopify-section-{{ section.id }} textarea.flat-input{
    min-height: {{section.settings.textarea_min_height}}px;
  }
  #shopify-section-{{ section.id }} .flat-button.submit{
    border-radius: 55px;
    background-color: #FF6E1D;
    height: 46px;
    font-size: 16px;
    line-height: 26px;
    border:none;
  }
  #shopify-section-{{ section.id }} .gfb__footer .action:hover{
    filter: none;
  }
  #shopify-section-{{ section.id }} .submit:hover{
     background-color: #e55a0f;
     color: #fff;
     
  }
  #shopify-section-{{ section.id }} .help-text.globo-description{
    color: #000;
    opacity: 0.1;
  }
  #shopify-section-{{ section.id }} .form-title{
    text-align: center;
    margin-bottom: 10px;
    text-transform: capitalize;
  }
  #shopify-section-{{ section.id }} .form-desc{
    color: #000;
    opacity: 0.4;
    text-align: center;
    margin: 0 auto 40px;
    max-width:800px;
  }
  #shopify-section-{{ section.id }} .gfb__dropzone{
    border:none;
  }
  #shopify-section-{{ section.id }} .label-content{
    font-family: var(--body-font-family);
    color: #000;
    opacity:0.4;
    font-size:12px;
    line-height:14px;

  }
  #shopify-section-{{ section.id }} .gfb__dropzone--placeholder--title,
  #shopify-section-{{ section.id }} .gfb__dropzone--placeholder--description{
    font-family: var(--body-font-family);
    color: #000;
    opacity:0.1;
    font-size:14px;
    line-height:20px;
  }
  #shopify-section-{{ section.id }} select.flat-input{
    appearance: none;
  -webkit-appearance: none;
  -moz-appearance: none;
  padding-right: 44px;
  background-image: url("data:image/svg+xml,%3Csvg width='17' height='10' viewBox='0 0 17 10' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath opacity='0.5' d='M0.683594 0.734375L8.18359 7.73437L15.6836 0.734375' stroke='%23FF6E1D' stroke-width='2'/%3E%3C/svg%3E") !important;
  background-repeat: no-repeat;
  background-position: right 16px center;
  background-size: 17px 10px;
  }
  #shopify-section-{{ section.id }} select.flat-input:focus {
    background-image: url("data:image/svg+xml,%3Csvg width='17' height='10' viewBox='0 0 17 10' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath opacity='0.5' d='M0.683594 7.73438L8.18359 0.734375L15.6836 7.73438' stroke='%23FF6E1D' stroke-width='2'/%3E%3C/svg%3E") !important;
  }
  #shopify-section-{{ section.id }} .gfb__dropzone--placeholder--button{
     font-family: var(--body-font-family);
    color: rgba(0,0,0,.4);
    background-color: {{section.settings.dropzone_button_bg_color}};
    border-radius: 15px;
    font-size:12px;
    line-height:20px;
    border: none;
    padding: 8px 30px;
  }
  #shopify-section-{{ section.id }} .flat-input::placeholder,
  #shopify-section-{{ section.id }} .flat-input::-webkit-input-placeholder {
     font-family: var(--body-font-family);
    color: #000;
    opacity:0.4;
    font-size:14px;
  }
   /* 只有当禁用占位项处于选中状态时，文字变浅 */
#shopify-section-{{ section.id }} .flat-input option[disabled]:checked {
  color: rgba(0,0,0,0.4);
}
/* 下拉框整体文字继承该颜色 */
#shopify-section-{{ section.id }} .flat-input:has(option[disabled]:checked) {
  color: rgba(0, 0, 0, 0.4);
  font-size: 14px;
  font-family: var(--body-font-family);
}
/* 选完正常选项后恢复黑色 */
#shopify-section-{{ section.id }} .flat-input:not(:has(option[disabled]:checked)) {
  color: #000;
  font-size: 14px;
  line-height: 20px;
}
#shopify-section-{{ section.id }} .globo-form-id-142645 .globo-form-app .globo-form-control .radio-wrapper .globo-option,
#shopify-section-{{ section.id }} .globo-form-control .checkbox-wrapper .globo-option{
  font-family: var(--body-font-family);
  color: rgba(0,0,0,.4);
   font-size:12px;
    line-height:20px;
}
  #shopify-section-{{ section.id }} .text-danger{
    color: #000;
    opacity:0.4;
  }
  @media screen and (max-width: 767px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    #shopify-section-{{ section.id }}  .globo-form-row{
      display:flex;
      gap: 10px;
    }
      #shopify-section-{{ section.id }} .globo-form-control .checkbox-wrapper .checkbox-input~.checkbox-label:before,
    #shopify-section-{{ section.id }}  .globo-form-control .checkbox-wrapper .checkbox-input~.checkbox-label:after,
    #shopify-section-{{ section.id }} .globo-form-control .radio-wrapper .radio-input~.radio-label:before,
    #shopify-section-{{ section.id }} .globo-form-control .radio-wrapper .radio-input~.radio-label:after{
      left: calc(-1 * 100vw * 28/var(--base-font));
      width: calc(100vw * 20/var(--base-font));
      height:calc(100vw * 20/var(--base-font));
    }
      #shopify-section-{{ section.id }} .label-content{
        
          font-size:calc(100vw * 20/var(--base-font));
          line-height:calc(100vw * 28/var(--base-font));

      }
       #shopify-section-{{ section.id }} .flat-input{
        height: calc(100vw * 80/var(--base-font));
      }
      #shopify-section-{{ section.id }} .flat-input::placeholder,
      #shopify-section-{{ section.id }} .flat-input::-webkit-input-placeholder,
      #shopify-section-{{ section.id }} .text-danger {
        font-size:calc(100vw * 22/var(--base-font));
      }
    #shopify-section-{{ section.id }} .flat-button.submit{
      height: calc(100vw * 70/var(--base-font));
      min-height: 36px;
      max-height: 70px;
      font-size: calc(100vw * 24/var(--base-font));
      line-height: calc(100vw * 32/var(--base-font));
    }
    #shopify-section-{{ section.id }} .globo-form-id-142645 .globo-form-app .globo-form-control .radio-wrapper .globo-option,
    #shopify-section-{{ section.id }} .globo-form-control .checkbox-wrapper .globo-option{
      
      font-size:calc(100vw * 20/var(--base-font));
          line-height:calc(100vw * 28/var(--base-font));
    }
    #shopify-section-{{ section.id }} .flat-input:has(option[disabled]:checked) {
     
      font-size:calc(100vw * 22/var(--base-font));
     
    }
    #shopify-section-{{ section.id }} .globo-form-app .panel{
      gap:10px;
    }
    #shopify-section-{{ section.id }} .gfb__dropzone--placeholder--title,
    #shopify-section-{{ section.id }} .gfb__dropzone--placeholder--description{
      font-size:calc(100vw * 22/var(--base-font));
      line-height: calc(100vw * 30/var(--base-font));
      text-align: center;
    }
    #shopify-section-{{ section.id }} .gfb__dropzone{
      min-height: 200px;
    }
    #shopify-section-{{ section.id }} .globo-form-id-142645 .globo-form-app .globo-form-control .radio-wrapper .globo-option{
      font-size:calc(100vw * 20/var(--base-font));
      line-height:calc(100vw * 28/var(--base-font));
    }
    #shopify-section-{{ section.id }} .globo-form-control .radio-wrapper .radio-input~.radio-label:before,
    #shopify-section-{{ section.id }} .globo-form-control .radio-wrapper .radio-input~.radio-label:after{
      width: calc(100vw * 20/var(--base-font));
      height: calc(100vw * 20/var(--base-font));
      min-width: 12px;
      min-height: 12px;
    }
    #shopify-section-{{ section.id }} .globo-form-input{
      margin-top: 10px;
    }
    #shopify-section-{{ section.id }} .globo-list-control{
      margin-bottom: 10px;
    }
    #shopify-section-{{ section.id }} .help-text.globo-description{
      font-size:calc(100vw * 22/var(--base-font));
      line-height:calc(100vw * 30/var(--base-font));
    }
    #shopify-section-{{ section.id }} .globo-form-control .radio-wrapper,
    #shopify-section-{{ section.id }} .globo-form-control .checkbox-wrapper{
      padding-left:calc(100vw * 22/var(--base-font));
    }
    #shopify-section-{{ section.id }} select.flat-input{
      background-size: calc(100vw * 22/var(--base-font)) calc(100vw * 11/var(--base-font));
    }
    #shopify-section-{{ section.id }} .flat-input:not(:has(option[disabled]:checked)) {
     
     font-size:calc(100vw * 22/var(--base-font));
      line-height:calc(100vw * 30/var(--base-font));
    }
    #shopify-section-{{ section.id }} .gfb__dropzone--placeholder--button{
      font-size:calc(100vw * 20/var(--base-font));
      line-height:calc(100vw * 28/var(--base-font));
      padding: calc(100vw * 8/var(--base-font)) calc(100vw * 30/var(--base-font));
    }
  }
 @media(max-width: 480px){
   #shopify-section-{{ section.id }} .form-desc{
    margin: 0 auto 20px;
   }
    #shopify-section-{{ section.id }} .globo-form-app .panel{
      gap:0px;
    }
    #shopify-section-{{ section.id }}  .globo-form-row{
      display:flex;
      gap: 0px;
    }
    #shopify-section-{{ section.id }} .globo-form-control[data-type="file2"]{
      margin-bottom: 5px;
    }
    #shopify-section-{{ section.id }} .globo-form-control[data-type="radio"]{
      margin-bottom: 5px;
    }
    #shopify-section-{{ section.id }} .globo-form-control[data-type="radio"] .globo-list-control{
      margin-bottom: 5px;
    }
 }
 
{%- endstyle -%}

<div class="section-{{ section.id }}-padding isolate{% if section.settings.include_margins %} page-width{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">

  {% if section.settings.main_title != blank %}
    <div class="form-header">
      <h2 class="form-title font-h2">{{ section.settings.main_title }}</h2>
      {% if section.settings.desc_text != blank %}
        <div class="form-desc font-text-4">{{ section.settings.desc_text }}</div>
      {% endif %}
    </div>
  {% endif %}


  {%- for block in section.blocks -%}
    {% render block %}
  {%- endfor -%}
</div>
<script>
document.addEventListener('change', function(e) {

  const sectionWrap = document.querySelector('#shopify-section-{{ section.id }}');
  if (!sectionWrap) return;

  if (sectionWrap.contains(e.target) && e.target.classList.contains('flat-input')) {
    e.target.blur();
  }
})
</script>
{% schema %}
{
  "name": "Video Submit Form",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Header Text Settings"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Title",
      "default": "Submit Your Video For Review"
    },
    {
      "type": "richtext",
      "id": "desc_text",
      "label": "Description Text",
      "default": "<p>Paste your public video link and upload a screenshot of your video analytics. We'll review your submission and verify the reward tier based on eligible views.</p>"
    },
    {
      "type": "header",
      "content": "Layout Margin Control"
    },
    {
      "type": "checkbox",
      "id": "include_margins",
      "default": true,
      "label": "Add page width left & right margins"
    },
    {
      "type": "header",
      "content": "Section Vertical Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Bottom Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Top Padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Bottom Padding",
      "default": 32
    },
    {
      "type":"color",
      "id":"bg_color",
      "label": "section bg color",
      "default":"#fff"
    },
     {
      "type":"color",
      "id":"input_bg_color",
      "label": "input bg color",
      "default":"#F7F7F7"
    },
    {
      "type":"color",
      "id":"dropzone_button_bg_color",
      "label": "dropzone button bg_color",
      "default":"#fff"
    },
    {
      "type":"number",
      "id":"textarea_min_height",
      "label":"textarea min height",
      "default": 69
    },
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Video Submit Form"
    }
  ]
}
{% endschema %}