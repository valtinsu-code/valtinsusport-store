
 <div class="product-feature-slide section-padding">
  <div class=" page-width fetaure-container">
    <div class="feature-header {% if section.settings.limit_width_1530 %}page-width-1530{% endif %}">
      <h2 class="feature-header__title font-h2">{{ section.settings.title }}</h2>
    </div>

    <div class="swiper featureSwiper {% if section.settings.limit_width_1530 %}page-width-1530{% endif %}">
      <div class="swiper-wrapper">
        
         {% for repeat in (1..3) %}
  {% assign useH3 = forloop.first %}
  {% for block in section.blocks %}
    {% if block.type == 'card' %}
      <div class="swiper-slide">
        <div class="feature-card">
          <picture>
            {% if block.settings.image_mobile != blank %}
              <source srcset="{{ block.settings.image_mobile | image_url:width: 600 }}" media="(max-width: 767px)">
            {% endif %}
            {% if block.settings.image_ipad != blank %}
              <source srcset="{{ block.settings.image_ipad | image_url:width: 600 }}" media="(max-width: 1024px)">
            {% endif %}
            <img
              src="{{ block.settings.image | image_url:width: 600 }}"
              alt="{{ block.settings.card_title }}"
              class="feature-card__img"
              width="{{  block.settings.image.width }}"
              height="{{  block.settings.image.height }}"
              loading="lazy"
            >
          </picture>
          <div class="feature-card__content">
            {% if block.settings.tag != blank and section.settings.show_tag %}
              <span class="feature-card__tag">{{ block.settings.tag }}</span>
            {% endif %}

            {% if useH3 %}
              <h3 class="feature-card__title font-h3">{{ block.settings.card_title }}</h3>
            {% else %}
              <div class="feature-card__title font-h3">{{ block.settings.card_title }}</div>
            {% endif %}

            {% if block.settings.desc != blank %}
              <div class="feature-card__desc font-text-5">{{ block.settings.desc }}</div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endif %}
  {% endfor %}
{% endfor %}
      </div>
    </div>

    <div class="feature-controls">
      <button class="feature-controls__btn prev-btn">
        <svg width="7" height="12" viewBox="0 0 7 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0.609375 5.59375L5.59309 10.5775" stroke="currentColor" stroke-width="1.21987" stroke-linecap="round"/>
          <path d="M2.07031 4.13281L5.59433 0.608795" stroke="currentColor" stroke-width="1.21987" stroke-linecap="round"/>
        </svg>
      </button>
      <button class="feature-controls__btn next-btn">
        <svg width="7" height="12" viewBox="0 0 7 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M5.59375 5.59375L0.610036 10.5775" stroke="currentColor" stroke-width="1.21987" stroke-linecap="round"/>
          <path d="M4.13281 4.13281L0.608795 0.608795" stroke="currentColor" stroke-width="1.21987" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
</div>
{% style %}
  #shopify-section-{{ section.id }} {
    --grid-gap: 15px;
    --text-dark: #333;
    --text-light: rgba(51,51,51,.6);
    --tag-bg: rgba(255, 110, 21, 0.1);
    --tag-color: #FF6E15;
    --btn-bg: #000;
    --btn-color: #fff;
    --btn-active-bg: #F3F3F3;
    --btn-active-color: #000;
    --card-radius: 15px;

    --padding-top-pc: {{ section.settings.padding_top_pc }}px;
    --padding-bottom-pc: {{ section.settings.padding_bottom_pc }}px;
    --padding-top-ipad: {{ section.settings.padding_top_ipad }}px;
    --padding-bottom-ipad: {{ section.settings.padding_bottom_ipad }}px;
    --padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile}}px;
  }
  #shopify-section-{{ section.id }} picture{
    display: flex;
      align-items: center;
      justify-content: center;
  }
  #shopify-section-{{ section.id }} .fetaure-container{
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .product-feature-slide {
    width: 100%;
    margin: 0 auto;
    background: {{ section.settings.bg_color }};
    overflow: clip;
  }
  #shopify-section-{{ section.id }} .feature-header {
    text-align: center;
    margin-bottom: 40px;
  }
  #shopify-section-{{ section.id }} .swiper{
    overflow: visible;
  }
  #shopify-section-{{ section.id }} .swiper-slide{
    max-width: 603px;
    width: 603px;
  }
  #shopify-section-{{ section.id }} .feature-header__title {
    max-width: 527px;
    width: fit-content;
    margin: 0 auto;
    color: var(--text-dark);
  }

  #shopify-section-{{ section.id }} .feature-card {
    display: flex;
    flex-direction: column;
    gap:var(--grid-gap);
    width: 100%;
  }
  #shopify-section-{{ section.id }} .feature-card__img {
    width: 100%;
    aspect-ratio: 603 / 437;
    height: auto;
    object-fit: cover;
    border-radius: var(--card-radius);
  }
  #shopify-section-{{ section.id }} .feature-card__content {
    display: flex;
    flex-direction: column;
    gap: 10px;
    justify-content: flex-start;
    align-items: flex-start;
  }
  #shopify-section-{{ section.id }} .feature-card__tag {
    background: var(--tag-bg);
    color: var(--tag-color);
    font-size: 12px;
    line-height: 14px;
    letter-spacing: 0%;
    padding: 0px 4px;
    border-radius: 4px;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .feature-card__title {
    color: var(--text-dark);
    text-transform: capitalize;
    margin:0;
    & p{ margin:0; }
  }
  #shopify-section-{{ section.id }} .feature-card__desc {
    color: var(--text-light);
    max-width: 80%;
    letter-spacing: 0%;
    & p{ margin:0; }
  }

  #shopify-section-{{ section.id }} .feature-controls {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 40px;
  }
  #shopify-section-{{ section.id }} .feature-controls__btn {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: none;
    background: var(--btn-bg);
    color: var(--btn-color);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  #shopify-section-{{ section.id }} .feature-controls__btn:hover{
    color: #000;
    background: #f3f3f3;
    transition: background-color 0.3s ease;
  }

  #shopify-section-{{ section.id }} .feature-controls__btn.active {

  }

  #shopify-section-{{ section.id }} .feature-controls__btn:disabled {
    background-color: rgba(0,0,0,.1);
    pointer-events: all;
    cursor: not-allowed;
    color: #000;
  }
      #shopify-section-{{ section.id }} .page-width-1530{

       padding-left: 0;
       padding-right: 0;
     }

  @media(max-width: 1440px){
    #shopify-section-{{ section.id }} .feature-card__tag{
      padding: 3px 14px;
    }
    #shopify-section-{{ section.id }} .feature-card__content{
      gap: 8px;
    }
  }

  @media (max-width: 1024px) {
        #shopify-section-{{ section.id }} .swiper{
    overflow: visible;
  }
    #shopify-section-{{ section.id }} {
    --grid-gap: 12px;
    }
    #shopify-section-{{ section.id }} .feature-card{
      gap:var(--grid-gap);
    }
    #shopify-section-{{ section.id }} .swiper-slide{
      max-width: 464px;
      width: 50%;
    }
    #shopify-section-{{ section.id }} .feature-card__img{
      aspect-ratio: 464 / 336;
      border-radius: 12px;
    }
    #shopify-section-{{ section.id }} .feature-card__content{
      gap: 5px;
    }

  }
  @media (max-width: 767px) {
     #shopify-section-{{ section.id }} .swiper{
    overflow: visible;
  }
    #shopify-section-{{ section.id }} .feature-header__title{
      max-width: 74%;
    }
    #shopify-section-{{ section.id }} .swiper-slide{
      max-width: 557px;
      width: 81%;
    }
    #shopify-section-{{ section.id }} .feature-card__img{
      aspect-ratio: 557 / 404;
      border-radius: 12px;
    }
    #shopify-section-{{ section.id }} .feature-card__tag {
      font-size: 20px;
      line-height: 28px;
    }
    #shopify-section-{{ section.id }} .feature-card__tag{
      padding: 3px 18px;
    }
    #shopify-section-{{ section.id }} .feature-card{
      gap: 30px;
    }
    #shopify-section-{{ section.id }} .feature-card__content{
      gap: 14px;
    }
    #shopify-section-{{ section.id }} .feature-card__desc{
      max-width: 92%;
    }
    #shopify-section-{{ section.id }} .feature-controls__btn {
    width: 67px;
    height: 67px;
    border-radius:18px;
    }


     #shopify-section-{{ section.id }} .feature-card__tag{
      padding: 3px 10px;
    }
  }
  @media(max-width: 480px){
    #shopify-section-{{ section.id }} .feature-header__title{
      max-width: 80%;
    }
    #shopify-section-{{ section.id }} .feature-card{
      gap: 10px;
    }
    #shopify-section-{{ section.id }} .feature-header {
      margin-bottom: 20px;
    }
    #shopify-section-{{ section.id }} .feature-controls__btn {
      width: 32px;
      height: 32px;
      border-radius: 6px;
    }
    #shopify-section-{{ section.id }} .feature-card__tag {
        font-size: 12px;
          line-height: 14px;
          padding: 3px 6px;
      }
       #shopify-section-{{ section.id }} .feature-card__content{
          gap: 10px;
        }
    #shopify-section-{{ section.id }} .feature-controls {
      margin-top: 20px;
    }
  }
{% endstyle %}

