<script>
document.addEventListener('DOMContentLoaded', () => {
  const section = document.querySelector('#shopify-section-{{ section.id }}');
  if (!section) return;

  const swiperEl = section.querySelector('.featureSwiper');
  const prevBtn = section.querySelector('.prev-btn');
  const nextBtn = section.querySelector('.next-btn');
  let isClickNav = false;

  // 按钮点击样式逻辑
  prevBtn.addEventListener('click', () => {
    isClickNav = true;
    prevBtn.classList.add('active');
    nextBtn.classList.remove('active');
  });
  nextBtn.addEventListener('click', () => {
    isClickNav = true;
    nextBtn.classList.add('active');
    prevBtn.classList.remove('active');
  });

  // 初始化 Swiper
  const swiper = new Swiper(swiperEl, {
    slidesPerView: 3,
    spaceBetween: 16,
    speed: 400,
    allowTouchMove: true,
    navigation: { prevEl: prevBtn, nextEl: nextBtn },
    slidesOffsetBefore: 0,
    slidesOffsetAfter: 0,

    loop: true,
    snapOnRelease: true,
    resistance: true,
    resistanceRatio: 0,
    slidesPerGroup: 1,

    autoplay: {
      delay: 3000,
      disableOnInteraction: false
    },
    // 彻底注释/删除原生属性，避免冲突
    // pauseOnMouseEnter: true,

    breakpoints: {
      1300: {
        slidesPerView: 3,
        spaceBetween: 16,
      },
      1024: {
        slidesPerView: 2,
        spaceBetween: 15,
      },
      768: {
        slidesPerView: 2,
        spaceBetween: 12,
      },
      480: {
        slidesPerView: 1.3,
        spaceBetween: 14,
      },
      300: {
        slidesPerView: 1.3,
        spaceBetween: 10,
      },
    },

    on: {
      init: function() {
        prevBtn.disabled = false;
        nextBtn.disabled = false;
      },
      slideChangeTransitionEnd: function () {
        if (!isClickNav) {
          prevBtn.classList.remove('active');
          nextBtn.classList.remove('active');
        }
        isClickNav = false;
      },
    },
  });

  // 初始化完成后再绑定鼠标事件（关键修复点）
  swiperEl.addEventListener('mouseenter', function() {
    swiper.autoplay.pause();
  });
  swiperEl.addEventListener('mouseleave', function() {
    swiper.autoplay.start();
  });

  // 入场动画
  const cards = section.querySelectorAll('.feature-card');
  gsap.set(cards, { y: 30, opacity: 0 });
  const observer = new IntersectionObserver(
    (entries) => {
      if (entries[0].isIntersecting) {
        gsap.to(cards, { y: 0, opacity: 1, duration: 0.8, ease: 'power2.out', stagger: 0.15 });
        observer.unobserve(section);
      }
    },
    { threshold: 0.2 }
  );
  observer.observe(section);
});
</script>

{% schema %}
{
  "name": "Product Feature Slide",
  
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#fff" },
    { "type": "header", "content": "Padding" },
    { "type": "number", "id": "padding_top_pc", "label": "Padding Top (PC)", "default": 40 },
    { "type": "number", "id": "padding_bottom_pc", "label": "Padding Bottom (PC)", "default": 40 },
    { "type": "number", "id": "padding_top_ipad", "label": "Padding Top (iPad)", "default": 30 },
    { "type": "number", "id": "padding_bottom_ipad", "label": "Padding Bottom (iPad)", "default": 30 },
    { "type": "number", "id": "padding_top_mobile", "label": "Padding Top (Mobile)", "default": 20 },
    { "type": "number", "id": "padding_bottom_mobile", "label": "Padding Bottom (Mobile)", "default": 20 },
    { "type": "text", "id": "title", "label": "Section Title", "default": "Made For Your First Dirt Season" },
    { "type": "checkbox", "id": "show_tag", "label": "card show tag", "default": true },
    { "type": "checkbox", "id": "limit_width_1530", "label": "limit width 1530", "default": true }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Feature Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Card Image" },
        { "type": "image_picker", "id": "image_ipad", "label": "Card Image ipad" },
        { "type": "image_picker", "id": "image_mobile", "label": "Card Image mobile" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "INITIATION" },
        { "type": "text", "id": "card_title", "label": "Card Title", "default": "Ease Into Dirt Riding" },
        {
          "type": "richtext",
          "id": "desc",
          "label": "Description",
          "default": "<p>Start with a bike that feels serious, but not overwhelming.</p>"
        }
      ]
    }
  ],
  "presets": [
    { "name": "Product Feature Slide", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }] }
  ]
}
{% endschema %}
