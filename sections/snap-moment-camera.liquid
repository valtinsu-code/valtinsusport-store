    {
      "type": "number",
      "id": "padding_top_mobile",
      "label": "顶部间距(手机)",
      "default": 40
    },
    {
      "type": "number",
      "id": "padding_bottom_mobile",
      "label": "底部间距(手机)",
      "default": 40
    },
    {
      "type": "header",
      "content": "文案配置"
    },
    {
      "type": "text",
