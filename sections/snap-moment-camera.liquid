<script>
document.addEventListener('DOMContentLoaded', () => {
  const section = document.querySelector('#shopify-section-{{ section.id }}');
  const cards = section?.querySelectorAll('.polaroid-card') || [];
  const shutterBtn = section?.querySelector('.camera-shutter-btn');
  const bgPaths = section?.querySelectorAll('.section-svg-bg path') || [];
  const arrowPaths = section?.querySelectorAll('.callout-arrow path') || [];

  // 初始化：组件正常显示，只隐藏卡片
  gsap.set(cards, { scale: 0, opacity: 0, transformOrigin: 'center' });

  // 背景 SVG
  bgPaths.forEach(p => {
    const len = p.getTotalLength();
    gsap.set(p, { strokeDasharray: len, strokeDashoffset: -len, opacity: 1 });
  });
  gsap.to(bgPaths, {
    strokeDashoffset: 0,
    scrollTrigger: { trigger: section, scrub: true }
  });

  // 箭头 SVG
  arrowPaths.forEach(p => {
    const len = p.getTotalLength();
    gsap.set(p, { strokeDasharray: len, strokeDashoffset: len });
  });

  // ——————————————————————————————————
  // ✅ 真实相机快门音效（更自然）
  // ——————————————————————————————————
  function playCameraShutterSound() {
    try {
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      const audioCtx = new AudioContext();
      const now = audioCtx.currentTime;

      // 快门机械声
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(800, now);
      osc.frequency.exponentialRampToValueAtTime(200, now + 0.08);
      gain.gain.setValueAtTime(0, now);
      gain.gain.linearRampToValueAtTime(0.3, now + 0.01);
      gain.gain.linearRampToValueAtTime(0, now + 0.15);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start(now);
      osc.stop(now + 0.2);

      // 快门反光板噪声
      const bufferSize = audioCtx.sampleRate * 0.2;
      const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) {
        data[i] = (Math.random() * 2 - 1) * (1 - i / bufferSize) * 0.4;
      }
      const noiseSource = audioCtx.createBufferSource();
      const noiseGain = audioCtx.createGain();
      noiseSource.buffer = buffer;
      noiseGain.gain.setValueAtTime(0, now);
      noiseGain.gain.linearRampToValueAtTime(0.5, now + 0.02);
      noiseGain.gain.linearRampToValueAtTime(0, now + 0.2);
      noiseSource.connect(noiseGain);
      noiseGain.connect(audioCtx.destination);
      noiseSource.start(now);
      noiseSource.stop(now + 0.25);
    } catch (e) {}
  }

  // 进入视口：箭头动画 + 卡片依次慢动作出现
  function enterViewAnimation() {
    const tl = gsap.timeline();
    // 第一步：画主曲线
    tl.to(arrowPaths[0], {
      strokeDashoffset: 0,
      duration: 1,
      ease: "power2.out"
    })
    // 第二步：画两个箭头小尾巴
    .to([arrowPaths[1], arrowPaths[2]], {
      strokeDashoffset: 0,
      duration: 0.4,
      ease: "power2.out"
    }, "+=0.1");

    // 卡片依次慢动作
    gsap.to(cards, {
      scale: 1,
      opacity: 1,
      duration: 3,
      ease: 'back.out(1.2)',
      stagger: 0.22,
      delay: 0.3
    });
  }

  // ——————————————————————————————————
  // ✅ 点击拍照：全部放慢 + 依次动画
  // ——————————————————————————————————
  function takePhotoAnimation() {
    // 1. 快门音效
    playCameraShutterSound();

    // 2. 替换图片
    cards.forEach(c => {
      const img = c.querySelector('img');
      if (img?.dataset.src) img.src = img.dataset.src;
    });

    // 3. 组件透明度动画（放慢）
    gsap.set(section, { opacity: 0 });
    gsap.to(section, {
      opacity: 1,
      duration: 3, // 更慢
      ease: 'power2.out'
    });

    // 4. 卡片再次动画：超慢 + 一张一张
    gsap.set(cards, { scale: 0, opacity: 0 });
    gsap.to(cards, {
      scale: 1,
      opacity: 1,
      duration: 1.4,    // 动画更慢
      ease: 'back.out(1.2)',
      stagger: 0.25      // 一张一张间隔更明显
    });
  }

  // hover
  cards.forEach(c => {
    c.addEventListener('mouseenter', () => {
      gsap.to(c, { zIndex: 99, scale: 1.05, duration: 0.4 });
    });
    c.addEventListener('mouseleave', () => {
      gsap.to(c, { zIndex: 1, scale: 1, duration: 0.4 });
    });
  });

  // 点击拍照
  shutterBtn?.addEventListener('click', takePhotoAnimation);

  // 进入视口
  new IntersectionObserver((e) => {
    if (e[0].isIntersecting) {
      enterViewAnimation();
    }
  }, { threshold: 0.25 }).observe(section);
});
</script>

