document.addEventListener('DOMContentLoaded', () => {
  const section = document.querySelector('#shopify-section-{{ section.id }}');
  const wrapper = section?.querySelector('.cards-wrapper');
  const cards = wrapper ? Array.from(wrapper.querySelectorAll('.polaroid-card')) : [];

  const svg = section?.querySelector('.section-svg-bg svg');
  const bgPaths = svg ? Array.from(svg.querySelectorAll('path')) : [];
  const arrowSvg = section?.querySelector('.callout-arrow svg');
  const arrowPaths = arrowSvg ? Array.from(arrowSvg.querySelectorAll('path')) : [];

  const shutterBtn = section?.querySelector('.camera-shutter-btn');

  let initialWrapperWidth = wrapper?.offsetWidth || 1;

  // 保存每张卡片的【相对百分比】（永久不变）
  const cardInfos = cards.map(card => {
    const l = parseFloat(getComputedStyle(card).left) || 0;
    const t = parseFloat(getComputedStyle(card).top) || 0;
    const w = parseFloat(getComputedStyle(card).width) || 1;

    return {
      el: card,
      leftRatio: l / initialWrapperWidth,   // left 相对比例
      topRatio: t / initialWrapperWidth,    // top 相对比例
      widthRatio: w / initialWrapperWidth,  // 宽度相对比例
    };
  });

  // ==============================
  // ✅ 核心：永远按当前容器宽度重算
  // 尺寸 + 定位 同步等比缩放
  // ==============================
  function updateResponsiveCards() {
    if (!wrapper || !cards.length) return;

    // 🔥 永远取当前最新的容器宽度（完全灵活）
    const currentWrapperWidth = wrapper.offsetWidth;

    cardInfos.forEach(info => {
      const newWidth = currentWrapperWidth * info.widthRatio;
      const newLeft = currentWrapperWidth * info.leftRatio;
      const newTop = currentWrapperWidth * info.topRatio;

      gsap.set(info.el, {
        width: newWidth,
        left: newLeft,
        top: newTop,
        height: 'auto',
        overwrite: true
      });
    });
  }

  function updateCardPosition() {
    initialWrapperWidth = wrapper.offsetWidth;
    updateResponsiveCards();
  }

  // 初始化布局（不碰卡片动画状态）
  updateResponsiveCards();

  if (bgPaths.length > 0) {
    bgPaths.forEach(path => {
      const len = path.getTotalLength();
      gsap.set(path, { strokeDasharray: len, strokeDashoffset: -len, opacity: 1 });
    });
  }
  if (arrowPaths.length > 0) {
    arrowPaths.forEach(path => {
      const len = path.getTotalLength();
      gsap.set(path, { strokeDasharray: len, strokeDashoffset: len });
    });
  }

  // ==============================
  // 🔥 🔥 🔥 关键：图片全部加载完再初始化卡片状态
  // ==============================
  const images = cards.map(card => card.querySelector('img')).filter(Boolean);
  let loadedImages = 0;

  function onAllImagesLoaded() {
    // ✅ 所有图片加载完成 → 现在才能设置卡片隐藏
    gsap.set(cards, { scale: 0, opacity: 0, transformOrigin: 'center center' });
  }

  function onImageLoad() {
    loadedImages++;
    if (loadedImages === images.length) {
      onAllImagesLoaded();
    }
  }

  if (images.length === 0) {
    onAllImagesLoaded();
  } else {
    images.forEach(img => {
      if (img.complete && img.naturalHeight > 0) {
        onImageLoad();
      } else {
        img.addEventListener('load', onImageLoad);
        img.addEventListener('error', onImageLoad);
      }
    });
  }

  // hover 不变
  cards.forEach(card => {
    card.addEventListener('mouseenter', () => {
      gsap.to(card, { zIndex: 99, scale: 1.08, duration: 0.4 });
    });
    card.addEventListener('mouseleave', () => {
      gsap.to(card, { zIndex: 1, scale: 1, duration: 0.4 });
    });
  });

  function playCameraSound() {
    try {
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      const audioCtx = new AudioContext();
      const now = audioCtx.currentTime;

      function shutterClick(startTime, frequency, volume, duration) {
        const oscillator = audioCtx.createOscillator();
        const gainNode = audioCtx.createGain();
        oscillator.type = 'square';
        oscillator.frequency.setValueAtTime(frequency, startTime);
        oscillator.frequency.exponentialRampToValueAtTime(frequency * 0.45, startTime + duration);
        gainNode.gain.setValueAtTime(0.0001, startTime);
        gainNode.gain.exponentialRampToValueAtTime(volume, startTime + 0.008);
        gainNode.gain.exponentialRampToValueAtTime(0.0001, startTime + duration);
        oscillator.connect(gainNode);
        gainNode.connect(audioCtx.destination);
        oscillator.start(startTime);
        oscillator.stop(startTime + duration + 0.02);
      }

      function shutterNoise(startTime) {
        const bufferSize = audioCtx.sampleRate * 0.12;
        const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
        const output = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          output[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / bufferSize, 2.2);
        }
        const source = audioCtx.createBufferSource();
        const filter = audioCtx.createBiquadFilter();
        const gainNode = audioCtx.createGain();
        source.buffer = buffer;
        filter.type = 'highpass';
        filter.frequency.setValueAtTime(1200, startTime);
        gainNode.gain.setValueAtTime(0.0001, startTime);
        gainNode.gain.exponentialRampToValueAtTime(0.09, startTime + 0.012);
        gainNode.gain.exponentialRampToValueAtTime(0.0001, startTime + 0.12);
        source.connect(filter);
        filter.connect(gainNode);
        gainNode.connect(audioCtx.destination);
        source.start(startTime);
      }

      shutterClick(now, 1450, 0.12, 0.055);
      shutterNoise(now + 0.035);
      shutterClick(now + 0.105, 720, 0.18, 0.075);
    } catch (e) {}
  }

  // ==============================
  // ✅ 点击拍照：组件透明→不透明
  // ==============================
  function playCardAnimation() {
    gsap.set(cards, { scale: 0, opacity: 0 });
    gsap.set(section, { opacity: 0 });
    gsap.to(section, {
      opacity: 1,
      duration: 1.2,
      ease: 'power2.out'
    });
    gsap.to(cards, {
      scale: 1,
      opacity: 1,
      duration: 1,
      ease: 'back.out(1.2)',
      stagger: 0.15
    });
  }

  if (shutterBtn) {
    shutterBtn.addEventListener('click', () => {
      playCameraSound();
      updateCardPosition();

      cards.forEach(card => {
        const img = card.querySelector('img');
        if (img && img.dataset.src) img.src = img.dataset.src;
      });

      playCardAnimation();
    });

    shutterBtn.addEventListener('touchstart', (e) => {
      e.preventDefault();
      shutterBtn.click();
    });
  }

  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      updateResponsiveCards();
    }, 50);
  });

  const observer = new IntersectionObserver(entries => {
    if (entries[0].isIntersecting) {
      if (arrowPaths.length) {
        gsap.to(arrowPaths, { strokeDashoffset: 0, duration: 1, delay: 0.5 });
      }
      playCardAnimation();
      observer.unobserve(section);

      if (bgPaths.length) {
        gsap.to(bgPaths, {
          strokeDashoffset: 0,
          ease: "none",
          scrollTrigger: { trigger: section, start: "top 10%", end: "bottom 10%", scrub: 0.3 }
        });
      }
    }
  }, { threshold: 0.3 });
  observer.observe(section);
});
