    position: absolute;
    flex-direction: column;
    top: {{ section.settings.arrow_top | default: 40 }}%;
    left: {{ section.settings.arrow_right | default: 0 }}%;
    z-index: 10;
    display: flex;
  }
  #shopify-section-{{ section.id }} .callout-text {
    position: relative;
    right: 50%;
    color: #FF6E1D;
    font-size: 30px;
    white-space: nowrap;
    transform: rotate(-15deg);
  }

  #shopify-section-{{ section.id }} .cards-wrapper {
    position: relative;
    z-index: 1;
    width: min(100%, 1920px);
    margin: -10% auto 0;
    aspect-ratio: 1840 / 972;
    height: auto;
  }

  #shopify-section-{{ section.id }} .polaroid-card {
    position: absolute;
    box-sizing: content-box;
    background: #fff;
    padding: clamp(8px, 0.85vw, 12px);
    padding-bottom: clamp(10px, 1.05vw, 15px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    border-radius: 6px;
    transform-origin: center center;
    transform: rotate(var(--card-rotate, 0deg)) translate(var(--tx,0),var(--ty,0))!important;
    will-change: transform, box-shadow;
    cursor: pointer;
