<style>
  #shopify-section-{{ section.id }} {
    background-color: #000000;
    color: #ffffff;
    font-family: var(--body-font-family);
    padding: 60px 0 30px 0;
    overflow: hidden;
  }


  /* 顶部 4 列网格布局 */
  #shopify-section-{{ section.id }} .footer-top-grid {
    justify-content: space-between;
    display: flex;
    gap: 20px;
    margin-bottom: 60px;
    max-width: 1530px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .footer-column-menu {
    display: flex;
    flex-direction: column;
    flex: 1 1 0;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .footer-column-newsletter {
    flex: 0.7 0 0;
    min-width: 0;
    {% comment %} margin-left: 32px; {% endcomment %}
  }

  /* 菜单样式 */
  #shopify-section-{{ section.id }} .accordion-trigger {
    background: none;
    border: none;
    color: #ffffff;
    text-align: left;
    padding: 0;
    margin-bottom: 20px;
    cursor: default;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .accordion-trigger .icon-arrow {
    display: none; /* 电脑端隐藏箭头 */
  }

  #shopify-section-{{ section.id }} .footer-menu-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .footer-menu-links li {
    margin-bottom: 6px;
  }

  #shopify-section-{{ section.id }} .footer-menu-links a {
    opacity: 0.8;
    text-decoration: none;
    transition: color 0.2s ease;
    color: #ffffff;
    letter-spacing: 0%;
  }

  #shopify-section-{{ section.id }} .footer-menu-links a:hover {
    opacity: 1;
  }

  /* 订阅部分 */
  #shopify-section-{{ section.id }} .newsletter-heading {
    margin-top: 0;
    margin-bottom: 8px;
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .newsletter-subheading {
    /* color: #a3a3a3; */
    margin-bottom: 20px;
    opacity: 0.8;
  }

  #shopify-section-{{ section.id }} .footer-newsletter-form {
    margin-bottom: 24px;
  }

  #shopify-section-{{ section.id }} .footer-newsletter-message {
    margin-bottom: 12px;
    color: #ffffff;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .footer-newsletter-message--success {
    color: #9ee6b3;
  }

  #shopify-section-{{ section.id }} .footer-newsletter-message--error {
    color: #ffb4a8;
  }

  #shopify-section-{{ section.id }} .input-wrapper {
    position: relative;
    display: flex;
    background-color: #262626;
    border-radius: 50px;
    padding: 4px;
    margin-bottom: 12px;
  }

  #shopify-section-{{ section.id }} .input-wrapper input[type="email"] {
    background: transparent;
    border: none;
    color: #ffffff;
    padding: 12px 20px;
    width: 100%;
    outline: none;
  }

  #shopify-section-{{ section.id }} .input-wrapper button[type="submit"] {
    background-color: transparent;
    border: none;
    color: #ffffff;
    padding: 0 24px;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .input-wrapper button[type="submit"]:hover {
    opacity: 0.8;
  }

  /* 同意选择框 */
  #shopify-section-{{ section.id }} .newsletter-agreement {
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgba(255, 255, 255, 0.8);
  }

  #shopify-section-{{ section.id }} .newsletter-agreement input[type="checkbox"] {
    margin-top: 2px;
    accent-color: #ffffff;
  }

  #shopify-section-{{ section.id }} .newsletter-agreement a {
    color: #ffffff;
    text-decoration: underline;
  }

  /* 社交媒体图标 */
  #shopify-section-{{ section.id }} .footer-social-icons {
    display: flex;
    gap: 12px;
    margin-top: 24px;
  }

  #shopify-section-{{ section.id }} .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 39px;
    height: 39px;
    background-color: #ffffff;
    color: #000000;
    border-radius: 8px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .social-icon:hover {
    opacity: 0.9;
  }

  #shopify-section-{{ section.id }} .social-icon svg {
    width: 20px;
    height: 20px;
  }

  /* 中间大 Logo */
  #shopify-section-{{ section.id }} .footer-brand-logo {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 60px auto 40px ;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .footer-brand-logo img {
    display: block;
    height: auto;
    object-fit: contain;
    width: 100%;
    transform-origin: center center;
    will-change: transform, opacity;
  }

  #shopify-section-{{ section.id }} .footer-logo-animate-part {
    display: inline-block;
    transform-origin: center center;
    will-change: transform, opacity;
  }

  #shopify-section-{{ section.id }} .fallback-logo {
    font-size: 8vw;
    letter-spacing: -2px;
    text-align: center;
    line-height: 1;
  }

  /* 底部横向样式 */
  #shopify-section-{{ section.id }} .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #fff;
    gap: 20px;
    max-width: 1530px;
  }

  #shopify-section-{{ section.id }} .footer-meta-and-payment {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  #shopify-section-{{ section.id }} .footer-meta-links {
    display: flex;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .footer-meta-links a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .footer-meta-links a:hover {
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .footer-payment-icons {
    display: flex;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .payment-icon {
    width: 38px;
    height: 24px;
  }
  #shopify-section-{{ section.id }} .footer-menu-content{
    display: flex;
    width: 60%;
  }

  #shopify-section-{{ section.id }} .footer-copyright-box{
    flex: 1;
    display: flex;
    justify-content: space-between;
    gap: 7px;
    flex-wrap: wrap;
  }

  /* 响应式媒体查询：移动设备 */
  @media screen and (max-width: 1024px) {
    #shopify-section-{{ section.id }} .footer-column-menu{
      & .accordion-trigger{
        margin-bottom: 0;
        padding: 15px 0;
        border-top:1px solid rgba(255,255,255,.3);
      }
    }
    #shopify-section-{{ section.id }} .footer-column-newsletter{
      width: 100%;
      flex: 1;
      margin-left: 0;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 55px;
    }
    #shopify-section-{{ section.id }} .footer-top-grid{
       flex-direction: column;
               gap: 46px;
    }
    #shopify-section-{{ section.id }} .footer-newsletter-form {
      margin-bottom: 0;
    }
    #shopify-section-{{ section.id }} .footer-menu-content{
       flex-direction: column;
       width: 100%;
       border-bottom: 1px solid rgba(255, 255, 255, .3);
    }
     #shopify-section-{{ section.id }} .accordion-trigger .icon-arrow {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 34px;
      height: 34px;
      background-color: #fff;
      border-radius: 10px;
      color: #000;
      & svg{
        width: 14px;
        height:14px;
      }
    }
    #shopify-section-{{ section.id }} .accordion-trigger[aria-expanded="true"] .icon-arrow {
      transform: rotate(180deg);
    }
    #shopify-section-{{ section.id }} .footer-bottom{
      align-items: flex-end;
    }
    #shopify-section-{{ section.id }} .accordion-content{
      max-height: 0;
      overflow: hidden;
    }
  }
  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      padding: 35px 0 25px 0;
    }
    #shopify-section-{{ section.id }} .input-wrapper{
      margin-bottom: 20px;
    }
    #shopify-section-{{ section.id }} .footer-menu-content{
      width: 100%;
      display: block;
    }

    #shopify-section-{{ section.id }} .footer-top-grid {
      flex-direction: column;

      margin-bottom: 40px;
    }

    /* 移动端风琴菜单线和间距 */
    #shopify-section-{{ section.id }} .footer-column-menu {
      border-bottom: 1px solid #1a1a1a;
    }

    #shopify-section-{{ section.id }} .footer-column-menu:first-child {
      border-top: 1px solid #1a1a1a;
    }

    #shopify-section-{{ section.id }} .accordion-trigger {
      padding: 16px 0;
      margin-bottom: 0;
      cursor: pointer;
    }

    #shopify-section-{{ section.id }} .accordion-trigger .icon-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #ffffff;
      color: #000000;
      width: calc(100vw * 40 / var(--base-width));
      height: calc(100vw * 40 / var(--base-width));
      border-radius: 4px;
      /* transition: transform 0.3s ease; */
    }

    #shopify-section-{{ section.id }} .accordion-trigger .icon-arrow svg {
      width: 14px;
      height: 14px;
    }

    #shopify-section-{{ section.id }} .accordion-trigger[aria-expanded="true"] .icon-arrow {
      transform: rotate(180deg);
    }

    #shopify-section-{{ section.id }} .accordion-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease-out;
    }

    #shopify-section-{{ section.id }} .footer-menu-links {
      padding: 8px 0 20px 0;
    }

    /* 订阅区移动端排版 */
    #shopify-section-{{ section.id }} .footer-column-newsletter {
      /* padding-top: 40px; */
      margin-left: 0;
      flex-direction: column;
      align-items: center;
      order: -1;
      gap: 0;
    }

    #shopify-section-{{ section.id }} .footer-newsletter-header-form{
       width: 100%;
    }
    #shopify-section-{{ section.id }} .newsletter-heading {
      text-align: left;
    }

    #shopify-section-{{ section.id }} .newsletter-subheading {
      text-align: left;
    }

    #shopify-section-{{ section.id }} .footer-social-icons {
      justify-content: center;
      margin-bottom: 0;
      /* margin: 30px; */
      width: 100%;
    }

    /* Logo 移动端 */
    #shopify-section-{{ section.id }} .footer-brand-logo {
      margin: 20px 0 40px 0;
      border-bottom: none;
      padding-bottom: 0;
    }

    /* 底部内容垂直堆叠排版 */
    #shopify-section-{{ section.id }} .footer-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 20px;
    }

    #shopify-section-{{ section.id }} .footer-meta-and-payment {
      flex-direction: column;
      gap: 20px;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .footer-meta-links {
      justify-content: center;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .footer-payment-icons {
      justify-content: center;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .footer-copyright-box{
      justify-content: center;
      gap: 25px;
      margin-bottom: 7px;
    }

    #shopify-section-{{ section.id }} .footer-copyright {
      order: 3; /* 将版权信息放在最下边 */
    }
    #shopify-section-{{ section.id }} .social-icon{
      max-width: 110px;
      max-height: 110px;
      min-width: 34px;
      min-height: 34px;
      border-radius:calc(100vw * (20/750));
      width:calc(100vw * (110/750));
      height:calc(100vw * (110/750));
      & svg{
       width: calc(100vw * (35/750));
       height: calc(100vw * (35/750));
       min-width: 20px;
       min-height: 20px;
      }
    }
    #shopify-section-{{ section.id }} .footer-copyright {
      order: initial;
    }
  }

  @media(max-width:480px){
    #shopify-section-{{ section.id }} .footer-social-icons {
      justify-content: center;
      margin-top: 60px;
      margin-bottom: 30px;
      width: 100%;

    }
    #shopify-section-{{ section.id }} .footer-top-grid{
      gap: 30px;
    }
    #shopify-section-{{ section.id }} .social-icon{
      max-width: 50px;
      max-height: 50px;
      min-width: 30px;
      min-height: 34px;
      border-radius: calc(100vw * (15 / 480));
      & svg{
       width: calc(100vw * (26/480));
       height: calc(100vw * (26/480));
       min-width: 20px;
       min-height: 20px;
      }
    }
  }
</style>
<footer class="custom-footer">
  <div class="footer-container">
    <!-- 顶部布局：链接列表与订阅区域 -->
    <div class="footer-top-grid page-width">
      <!-- 动态菜单列 (电脑端并排，手机端自动变为折叠菜单) -->
      <div class="footer-menu-content">
        {%- for block in section.blocks -%}
          {%- if block.type == 'link_list' -%}
            <div class="footer-column footer-column-menu" {{ block.shopify_attributes }}>
              <button class="accordion-trigger font-h3" aria-expanded="false">
                <span>{{ block.settings.heading | escape }}</span>
                <span class="icon-arrow">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </button>
              <div class="accordion-content">
                <ul class="footer-menu-links">
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a href="{{ link.url }}" class="font-text-3">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <!-- 邮件订阅与社交媒体列 -->
      <div class="footer-column footer-column-newsletter">
        <div class="footer-newsletter-header-form">
          <div class="newsletter-heading font-h3">{{ section.settings.newsletter_heading }}</div>
          <p class="newsletter-subheading font-text-3">{{ section.settings.newsletter_subheading }}</p>

          {%- form 'customer', class: 'footer-newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">

            {%- if form.posted_successfully? -%}
              <div class="footer-newsletter-message footer-newsletter-message--success font-text-4" role="status" tabindex="-1">
                Thank you for subscribing.
              </div>
            {%- elsif form.errors -%}
              <div class="footer-newsletter-message footer-newsletter-message--error font-text-4" role="alert">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </div>
            {%- endif -%}
 
            <div class="input-wrapper">
              <input
                type="email"
                name="contact[email]"
                class="font-text-4"
                placeholder="Email"
                aria-label="Email Address"
                required
              >
              <button type="submit" name="commit" class="font-button-1 font-weight-500">Submit</button>
            </div>
            <div class="newsletter-agreement">
              <input type="checkbox" id="FooterAgree-{{ section.id }}" required>
              <label for="FooterAgree-{{ section.id }}" class="font-text-4">
                By Signing Up, You Agree To Our <a href="{{ section.settings.privacy_link }}">Privacy Policy</a>
              </label>
            </div>
          {%- endform -%}
        </div>

        <!-- 社交媒体图标 -->
        <div class="footer-social-icons">
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" class="social-icon" aria-label="Facebook">
              {{- 'icon-facebook.svg' | inline_asset_content -}}
            </a>
          {%- endif -%}
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" class="social-icon" aria-label="Instagram">
              {{- 'icon-instagram.svg' | inline_asset_content -}}
            </a>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <a href="{{ settings.social_youtube_link }}" class="social-icon" aria-label="YouTube">
              {{- 'icon-youtube.svg' | inline_asset_content -}}
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <a href="{{ settings.social_tiktok_link }}" class="social-icon" aria-label="TikTok">
              {{- 'icon-tiktok.svg' | inline_asset_content -}}
            </a>
          {%- endif -%}
          {%- if settings.social_twitter_link != blank -%}
            <a href="{{ settings.social_twitter_link }}" class="social-icon" aria-label="X (Twitter)">
              {{- 'icon-twitter.svg' | inline_asset_content -}}
            </a>
          {%- endif -%}
          {%- if settings.social_pinterest_link != blank -%}
            <a href="{{ settings.social_pinterest_link }}" class="social-icon" aria-label="Pinterest">
              {{- 'icon-pinterest.svg' | inline_asset_content -}}
            </a>
          {%- endif -%}
          {%- if settings.social_snapchat_link != blank -%}
            <a href="{{ settings.social_snapchat_link }}" class="social-icon" aria-label="Snapchat">
              {{- 'icon-snapchat.svg' | inline_asset_content -}}
            </a>
          {%- endif -%}
          {%- if settings.social_tumblr_link != blank -%}
            <a href="{{ settings.social_tumblr_link }}" class="social-icon" aria-label="Tumblr">
              {{- 'icon-tumblr.svg' | inline_asset_content -}}
            </a>
          {%- endif -%}
          {%- if settings.social_vimeo_link != blank -%}
            <a href="{{ settings.social_vimeo_link }}" class="social-icon" aria-label="Vimeo">
              {{- 'icon-vimeo.svg' | inline_asset_content -}}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>

    <!-- 中间：巨大的品牌 Logo -->
    <div class="footer-brand-logo page-width-1530 page-width">
      {%- if section.settings.logo_image != blank -%}
        <img
          src="{{ section.settings.logo_image | image_url: width: 1400 }}"
          alt="{{ shop.name }}"
          loading="lazy"
          style="max-width: {{ section.settings.logo_width }}%;"
        >
      {%- else -%}
        <div class="fallback-logo caveat-brush-font-family">VALTINSU</div>
      {%- endif -%}
    </div>

    <!-- 底部：版权、协议政策、支付方式 -->
    <div class="footer-bottom font-text-4 page-width">
      <div class="footer-copyright-box">
        <div class="footer-copyright">
          Copyright &copy; {{ 'now' | date: '%Y' }}
          {{ shop.name }}. All Rights Reserved. Powered by COREXPAND.
        </div>
        <div class="footer-meta-links">
          <a href="{{ section.settings.terms_link }}">Terms & Conditions</a>
          <a href="{{ section.settings.privacy_link }}">Privacy Policy</a>
        </div>
      </div>
      <div class="footer-meta-and-payment">
        {% comment %}
          <div class="footer-meta-links">
            <a href="{{ section.settings.terms_link }}">Terms & Conditions</a>
            <a href="{{ section.settings.privacy_link }}">Privacy Policy</a>
          </div>
        {% endcomment %}
        {%- if section.settings.show_payment_icons -%}
          <div class="footer-payment-icons">
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag: class: 'payment-icon' }}
            {%- endfor -%}
           <svg xmlns="http://www.w3.org/2000/svg" role="img" width="38" height="24" viewBox="0 0 38 24" aria-labelledby="pi-klarna" fill="none"><title id="pi-klarna">Klarna</title><rect width="38" height="24" rx="2" fill="#FFA8CD"></rect><rect x=".5" y=".5" width="37" height="23" rx="1.5" stroke="#000" stroke-opacity=".07"></rect><path d="M30.62 14.755c-.662 0-1.179-.554-1.179-1.226 0-.673.517-1.226 1.18-1.226.663 0 1.18.553 1.18 1.226 0 .672-.517 1.226-1.18 1.226zm-.33 1.295c.565 0 1.286-.217 1.686-1.068l.04.02c-.176.465-.176.742-.176.81v.11h1.423v-4.786H31.84v.109c0 .069 0 .346.175.81l-.039.02c-.4-.85-1.121-1.068-1.687-1.068-1.355 0-2.31 1.088-2.31 2.522 0 1.433.955 2.521 2.31 2.521zm-4.788-5.043c-.643 0-1.15.228-1.56 1.068l-.039-.02c.175-.464.175-.741.175-.81v-.11h-1.423v4.787h1.462V13.4c0-.662.38-1.078.995-1.078.614 0 .917.356.917 1.068v2.532h1.462v-3.046c0-1.088-.838-1.869-1.989-1.869zm-4.963 1.068l-.039-.02c.176-.464.176-.741.176-.81v-.11h-1.424v4.787h1.463l.01-2.304c0-.673.35-1.078.926-1.078.156 0 .282.02.429.06v-1.464c-.644-.139-1.22.109-1.54.94zm-4.65 2.68c-.664 0-1.18-.554-1.18-1.226 0-.673.516-1.226 1.18-1.226.662 0 1.179.553 1.179 1.226 0 .672-.517 1.226-1.18 1.226zm-.332 1.295c.565 0 1.287-.217 1.687-1.068l.038.02c-.175.465-.175.742-.175.81v.11h1.424v-4.786h-1.424v.109c0 .069 0 .346.175.81l-.038.02c-.4-.85-1.122-1.068-1.687-1.068-1.356 0-2.311 1.088-2.311 2.522 0 1.433.955 2.521 2.31 2.521zm-4.349-.128h1.463V9h-1.463v6.922zM10.136 9H8.644c0 1.236-.751 2.343-1.892 3.134l-.448.317V9h-1.55v6.922h1.55V12.49l2.564 3.43h1.892L8.293 12.64c1.121-.82 1.852-2.096 1.843-3.639z" fill="#0B051D"></path></svg>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sectionId = 'shopify-section-{{ section.id }}';
    const footer = document.getElementById(sectionId);
    if (!footer) return;

    const accordionTriggers = footer.querySelectorAll('.accordion-trigger');
    const socialIcons = footer.querySelector('.footer-social-icons');
    const newsletterColumn = footer.querySelector('.footer-column-newsletter');
    const brandLogo = footer.querySelector('.footer-brand-logo');
    const socialPlaceholder = document.createComment('footer-social-icons-original-position');
    const copyright = footer.querySelector('.footer-copyright');
    const copyrightBox = footer.querySelector('.footer-copyright-box');
    const metaAndPayment = footer.querySelector('.footer-meta-and-payment');
    const copyrightPlaceholder = document.createComment('footer-copyright-original-position');

    if (socialIcons && newsletterColumn && brandLogo) {
      socialIcons.parentNode.insertBefore(socialPlaceholder, socialIcons);
    }

    if (copyright && copyrightBox && metaAndPayment) {
      copyright.parentNode.insertBefore(copyrightPlaceholder, copyright);
    }

    function updateFooterSocialPosition() {
      if (!socialIcons || !newsletterColumn || !brandLogo) return;

      if (window.innerWidth <= 767) {
        if (socialIcons.nextElementSibling !== brandLogo) {
          brandLogo.parentNode.insertBefore(socialIcons, brandLogo);
        }
      } else if (socialPlaceholder.parentNode) {
        socialPlaceholder.parentNode.insertBefore(socialIcons, socialPlaceholder.nextSibling);
      }
    }

    function updateFooterCopyrightPosition() {
      if (!copyright || !copyrightBox || !metaAndPayment) return;

      if (window.innerWidth <= 767) {
        if (metaAndPayment.nextElementSibling !== copyright) {
          metaAndPayment.parentNode.insertBefore(copyright, metaAndPayment.nextSibling);
        }
      } else if (copyrightPlaceholder.parentNode) {
        copyrightPlaceholder.parentNode.insertBefore(copyright, copyrightPlaceholder.nextSibling);
      }
    }

    updateFooterSocialPosition();
    updateFooterCopyrightPosition();

    accordionTriggers.forEach((trigger) => {
      trigger.addEventListener('click', function () {
        // 仅在移动端屏幕（小于768px）生效

        if (window.innerWidth >= 1025) return;
        const content = this.nextElementSibling;
        const isExpanded = this.getAttribute('aria-expanded') === 'true';

        // 切换属性
        this.setAttribute('aria-expanded', !isExpanded);

        if (!isExpanded) {
          content.style.maxHeight = content.scrollHeight + 'px';
        } else {
          content.style.maxHeight = '0px';
        }
      });
    });

    // 窗口尺寸改变时，重置折叠菜单的状态，避免影响桌面端布局
    window.addEventListener('resize', function () {
      updateFooterSocialPosition();
      updateFooterCopyrightPosition();

      if (window.innerWidth >= 768) {
        accordionTriggers.forEach((trigger) => {
          trigger.removeAttribute('aria-expanded');
          const content = trigger.nextElementSibling;
          if (content) content.style.maxHeight = '';
        });
      }
    });

    function splitDirectTextNodes(element) {
      const childNodes = Array.from(element.childNodes);
      const fragment = document.createDocumentFragment();

      childNodes.forEach((node) => {
        if (node.nodeType !== Node.TEXT_NODE) {
          fragment.appendChild(node);
          return;
        }

        const text = node.textContent || '';
        Array.from(text).forEach((char) => {
          if (char.trim() === '') {
            fragment.appendChild(document.createTextNode(char));
            return;
          }

          const span = document.createElement('span');
          span.className = 'footer-logo-animate-part';
          span.textContent = char;
          fragment.appendChild(span);
        });
      });

      element.textContent = '';
      element.appendChild(fragment);
    }

    function initFooterBrandLogoAnimation() {
      const logo = footer.querySelector('.footer-brand-logo');
      if (!logo || logo.dataset.gsapLogoReady === 'true') return;

      const fallbackLogo = logo.querySelector('.fallback-logo');
      const logoImage = logo.querySelector('img');
      let animationTargets = [];

      if (fallbackLogo) {
        splitDirectTextNodes(fallbackLogo);
        animationTargets = Array.from(fallbackLogo.querySelectorAll('.footer-logo-animate-part'));
      } else if (logoImage) {
        animationTargets = [logoImage];
      }

      if (!animationTargets.length) return;

      logo.dataset.gsapLogoReady = 'true';

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || typeof gsap === 'undefined') {
        animationTargets.forEach((target) => {
          target.style.opacity = '1';
          target.style.visibility = 'visible';
        });
        return;
      }

      gsap.set(animationTargets, { autoAlpha: 0 });

      const animateLogo = () => {
        gsap.fromTo(
          animationTargets,
          {
            autoAlpha: 0,
          },
          {
            autoAlpha: 1,
            stagger: fallbackLogo ? 0.08 : 0,
            duration: 4,
            ease: 'power2.out',
            clearProps: 'transform,opacity,visibility',
          }
        );
      };

      if (typeof ScrollTrigger !== 'undefined') {
        ScrollTrigger.create({
          trigger: logo,
          start: 'top 80%',
          once: true,
          onEnter: animateLogo,
        });
        return;
      }

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries[0].isIntersecting) return;
            observer.disconnect();
            animateLogo();
          },
          { threshold: 0.2 }
        );
        observer.observe(logo);
      } else {
        animateLogo();
      }
    }

    initFooterBrandLogoAnimation();
  });
</script>
