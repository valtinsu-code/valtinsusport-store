      if (currentFilter === 'all') return allCards;
      return allCards.filter(card => card.dataset.filter === currentFilter);
    };

    const getPaginationItems = (pageCount) => {
      const maxItems = mobileMedia.matches ? 5 : 7;
      const items = [];
      if (pageCount <= maxItems) {
        for (let page = 1; page <= pageCount; page += 1) items.push(page);
        return items;
      }
      if (mobileMedia.matches) {
        if (currentPage <= 3) return [1, 2, 3, 'ellipsis', pageCount];
        if (currentPage >= pageCount - 2) return [1, 'ellipsis', pageCount - 2, pageCount - 1, pageCount];
        return [1, 'ellipsis', currentPage, 'ellipsis', pageCount];
      }
      if (currentPage <= 4) return [1, 2, 3, 4, 5, 'ellipsis', pageCount];
      if (currentPage >= pageCount - 3) return [1, 'ellipsis', pageCount - 4, pageCount - 3, pageCount - 2, pageCount - 1, pageCount];
      return [1, 'ellipsis', currentPage - 1, currentPage, currentPage + 1, 'ellipsis', pageCount];
    };

    const renderVideoList = (needScroll = false) => {
      const cards = getFilteredCards();
      const pageSize = getPageSize();
      const pageCount = Math.ceil(cards.length / pageSize);

      if (previousPageSize && previousPageSize !== pageSize) currentPage = 1;
      previousPageSize = pageSize;
      currentPage = Math.min(Math.max(currentPage, 1), Math.max(pageCount, 1));

      // 1、先全部隐藏所有卡片
      const allCards = Array.from(container.querySelectorAll('.video-card'));
      allCards.forEach(card => {
        card.hidden = true;
        card.style.display = 'none';
      });

      // 2、仅展示当前筛选+当前页码范围内的卡片
      const start = (currentPage - 1) * pageSize;
      const end = currentPage * pageSize;
      cards.forEach((card, index) => {
        if (index >= start && index < end) {
          card.hidden = false;
          card.style.display = '';
        }
      });

      pagination.hidden = pageCount <= 1;
      pageNumbers.innerHTML = '';
      if (pageCount <= 1) {
        if (needScroll) scrollToFilterBar();
        return;
      }

      prevButton.disabled = currentPage === 1;
      nextButton.disabled = currentPage === pageCount;

      getPaginationItems(pageCount).forEach((page) => {
        if (page === 'ellipsis') {
          const ellipsis = document.createElement('span');
          ellipsis.className = 'pagination-ellipsis font-text-5';
          ellipsis.textContent = '...';
          ellipsis.setAttribute('aria-hidden', 'true');
