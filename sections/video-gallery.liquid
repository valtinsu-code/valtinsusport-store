    if (!container || !pagination || !prevButton || !nextButton || !pageNumbers || !tabButtons || !filterNav) return;

    // 滚动到筛选栏公共方法
    const scrollToFilterBar = () => {
      const rect = filterNav.getBoundingClientRect();
      const offsetTop = window.scrollY + rect.top - 80;
      window.scrollTo({
        top: offsetTop,
        left: 0,
        behavior: 'smooth'
      });
    };

    // Tab切换：只修改过滤条件，不再切换两套网格
    tabButtons.forEach(tab => {
