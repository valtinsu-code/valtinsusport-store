          return;
        }
        const button = document.createElement('button');
        button.type = 'button';
        button.className = `pagination-number font-text-5${page === currentPage ? ' font-weight-700 is-active' : ''}`;
        button.textContent = page;
        button.setAttribute('aria-label', `Page ${page}`);
        if (page === currentPage) button.setAttribute('aria-current', 'page');
        button.addEventListener('click', () => {
          currentPage = page;
          renderVideoList(true);
        });
        pageNumbers.appendChild(button);
      });

      // 渲染完成执行滚动
      if (needScroll) scrollToFilterBar();
    };

    prevButton.addEventListener('click', () => {
      currentPage -= 1;
      renderVideoList(true);
    });
    nextButton.addEventListener('click', () => {
      currentPage += 1;
      renderVideoList(true);
    });

    // 初始化渲染
    renderVideoList();
    [mobileMedia, ipadMedia].forEach((query) => {
      if (query.addEventListener) {
        query.addEventListener('change', renderVideoList);
      } else if (query.addListener) {
        query.addListener(renderVideoList);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Video Gallery",
  "settings": [
    {
      "type": "header",
      "content": "Spacing Settings"
    },
    {
      "type": "number",
      "id": "padding_top_pc",
      "label": "Padding top (Desktop)",
      "default": 40
    },
    {
      "type": "number",
      "id": "padding_bottom_pc",
      "label": "Padding bottom (Desktop)",
      "default": 40
    },
    {
