                <path d="M13.1846 6.55469L11.9297 11.3173" stroke="currentColor" stroke-width="1.42877" stroke-linecap="round"/>
              </svg>
            {% when '6' %}
              <svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8.125 8.75H3.75C3.05964 8.75 2.5 9.30963 2.5 10V20C2.5 20.6904 3.05964 21.25 3.75 21.25H8.125" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
