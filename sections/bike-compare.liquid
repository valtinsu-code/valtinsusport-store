                <path d="M26.25 12.5H27.5C28.1904 12.5 28.75 13.0596 28.75 13.75V16.25C28.75 16.9404 28.1904 17.5 27.5 17.5H26.25V12.5Z" fill="currentColor"/>
              </svg>
          {% endcase %}
        </div>
        <div class="spec-tag__text font-text-3">
          <span class="spec-tag__label">{{ block.settings.label | capitalize }}</span>
          <span class="spec-tag__value">{{ block.settings.value }}</span>
        </div>
      </div>
      {% endif %}
    {% endfor %}
  </div>
  </div>
</div>

{% style %}
#shopify-section-{{ section.id }} {
  --card-bg: #fff;
  --divider-color: #e5e5e5;
  --grid-gap: 20px;
  --radius: 12px;
  --tag-bg: rgba(0,0,0,0.4);
  --text-white: #ffffff;
  --params-radius: 20px;
  --icon-color: #fff;

  --padding-top-pc: {{ section.settings.padding_top_pc }}px;
  --padding-bottom-pc: {{ section.settings.padding_bottom_pc }}px;
  --padding-top-ipad: {{ section.settings.padding_top_ipad }}px;
  --padding-bottom-ipad: {{ section.settings.padding_bottom_ipad }}px;
  --padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
  --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  & h3,& p{
    margin: 0;
  }
}

#shopify-section-{{ section.id }} .bike-compare-section {
  background: #f5f5f5;
}

/* 双产品卡片布局 */
#shopify-section-{{ section.id }} .bike-compare-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--grid-gap);
  margin-bottom: 60px;
}

#shopify-section-{{ section.id }} .bike-card {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 30px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

#shopify-section-{{ section.id }} .bike-card__image-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
}

#shopify-section-{{ section.id }} .bike-card__img {
  width: 100%;
  aspect-ratio: 750/500;
  height: auto;
  object-fit: contain;
  display: block;
  mix-blend-mode: multiply
}

#shopify-section-{{ section.id }} .bike-card__title {

}

#shopify-section-{{ section.id }} .bike-card__sub-title {
  letter-spacing: 0%;
  color: rgba(51,51,51,.8);
}

#shopify-section-{{ section.id }} .bike-card__link_text{
  display: flex;
  align-items: center;
  justify-content: space-between;
  & .bike-card__link{
    flex-shrink: 0;
  }
  & .bike-card__desc{
    max-width: 350px;
    letter-spacing: 0%;
    text-align: right;
    color: rgba(51,51,51,.8);
  }
}

/* 参数标签栏 */
#shopify-section-{{ section.id }} .bike-spec-tags {
  display: flex;
  gap: 8px;
  justify-content: space-between;
  align-items: center;
  padding: calc(60px - 18px) 0 0;
  border-top: 1px solid rgba(0, 0, 0, .1);
}
#shopify-section-{{ section.id }} .spec-tag__text{
  gap: 6px;
}
#shopify-section-{{ section.id }} .spec-tag {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 6px;
  padding: 16px 0;
  width: 17%;
  border-radius: var(--params-radius);
  text-align: center;
  color: #333;
}

#shopify-section-{{ section.id }} .spec-tag__icon {
  width: 27px;
  height: 27px;

  display: flex;
  align-items: center;
  justify-content: center;
}

#shopify-section-{{ section.id }} .spec-tag__icon svg {
  width: 100%;
  height: 100%;
}

#shopify-section-{{ section.id }} .spec-tag__text {
  display: flex;
  flex-direction: column;
}

#shopify-section-{{ section.id }} .spec-tag__label {
  color: rgba(51,51,51,.4);
}

@media(max-width: 900px){
  #shopify-section-{{ section.id }} .bike-card{
    padding: 20px;
  }
  #shopify-section-{{ section.id }} .bike-card__link_text .bike-card__desc{
    text-align:center;
  }
  #shopify-section-{{ section.id }} .bike-card__link_text{
    flex-direction: column-reverse;
    gap: 15px;
  }
  
}

/* 平板适配 */
@media (max-width: 1024px) {

  #shopify-section-{{ section.id }} .bike-compare-row{
    margin-bottom: 40px;
  }
 #shopify-section-{{ section.id }} .bike-spec-tags {
    padding: 29px 0 0;
 }
  #shopify-section-{{ section.id }} .spec-tag__icon {
    width: 20px;
    height: 20px;
  }
  #shopify-section-{{ section.id }} .spec-tag {
    padding: 11px 0;
    border-radius: 14px;
  }
  #shopify-section-{{ section.id }} .bike-card__link_text{
    gap: 10px;
  }
}

/* 移动端适配 */
@media (max-width: 767px) {

  /* 双产品卡片布局 */
  #shopify-section-{{ section.id }} .bike-compare-row {
    grid-template-columns: 1fr;
  }
  #shopify-section-{{ section.id }} .bike-card__link_text .bike-card__desc{
    max-width: 100%;
    text-align: left;
  }
  #shopify-section-{{ section.id }} .hero-btn,
  #shopify-section-{{ section.id }} .bike-card__link{
    width: 100%;
  }
  /* #shopify-section-{{ section.id }} .bike-card__link svg{
     width: 7px;
     height: 12px;
  } */
  #shopify-section-{{ section.id }} .bike-card__link_text{
    gap: 30px;
    flex-direction: column-reverse;
  }
  #shopify-section-{{ section.id }} .bike-spec-tags {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    padding:0;
    border:none;
  }
  #shopify-section-{{ section.id }} .spec-tag {
    width: 100%;
    padding: 15px 0;
    gap: 10px;
    border-radius: 30px;
  } 
  #shopify-section-{{ section.id }} .spec-tag__icon {
    max-width: 55px;
    max-height: 55px;
    width: calc(100vw * 55/750);
    height: calc(100vw * 55/750);
  }
}
@media (max-width: 480px) {
  #shopify-section-{{ section.id }} .bike-card{
    padding: 20px;
    gap:8px;
  }
  #shopify-section-{{ section.id }} .bike-card__link_text{
    gap: 10px;
  }
  #shopify-section-{{ section.id }} .bike-compare-row{
    margin-bottom: 15px;
  }
}
{% endstyle %}

{% schema %}
{
  "name": "Bike Compare & Specs",
  "settings": [
    {
      "type": "header",
      "content": "Global Settings"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "number",
      "id": "padding_top_pc",
      "label": "Padding Top (Desktop)",
      "default": 40
    },
    {
      "type": "number",
      "id": "padding_bottom_pc",
      "label": "Padding Bottom (Desktop)",
      "default": 40
    },
    {
      "type": "number",
      "id": "padding_top_ipad",
      "label": "Padding Top (Ipad)",
      "default": 30
    },
    {
      "type": "number",
      "id": "padding_bottom_ipad",
      "label": "Padding Bottom (Ipad)",
      "default": 30
    },
    {
      "type": "number",
      "id": "padding_top_mobile",
      "label": "Padding Top (Mobile)",
      "default": 20
    },
    {
      "type": "number",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom (Mobile)",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "bike_card",
      "name": "Product Card",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Product Title"
        },
        {
          "type": "text",
          "id": "sub_title",
          "label": "Sub Title",
          "info": "Optional subtitle"
        },
        {
          "type": "richtext",
          "id": "card_desc",
          "label": "Card Description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image"
        },
        {
            "type": "text",
            "id": "btn_text",
            "label": "Button Text",
            "default": "View Details"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "spec_tag",
      "name": "Spec Tag",
      "settings": [
        {
          "type": "select",
          "id": "svg_icon",
          "label": "SVG Icon",
          "options": [
            {"value":"1","label":"Seat Hgeight"},
            {"value":"2","label":"Protection"},
            {"value":"3","label":"Age Grade"},
            {"value":"4","label":"Max Load"},
            {"value":"5","label":"Battery"},
            {"value":"6","label":"Charging"}
          ],
          "default": "1"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Parameter"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "Data"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bike Compare & Specs",
      "blocks": [
        { "type": "bike_card" },
        { "type": "bike_card" },
        { "type": "spec_tag" },
        { "type": "spec_tag" },
        { "type": "spec_tag" },
        { "type": "spec_tag" },
        { "type": "spec_tag" },
        { "type": "spec_tag" }
      ]
    }
  ]
}
{% endschema %}