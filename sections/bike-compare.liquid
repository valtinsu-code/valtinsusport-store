{% comment %} Bike Compare & Specs Component {% endcomment %}
<div class="bike-compare-section section-padding" id="shopify-section-{{ section.id }}">
  {% comment %} Two Product Cards {% endcomment %}
  <div class="page-width">
    <div class="bike-compare-row">
    {% for block in section.blocks %}
      {% if block.type == 'bike_card' %}
      <div class="bike-card">
        <h3 class="bike-card__title font-h3">
          {{ block.settings.title }}
        </h3>
        {% if block.settings.sub_title != blank %}
        <div class="bike-card__sub-title font-text-3">
          {{ block.settings.sub_title }}
        </div>
        <div class="bike-card__image-wrap">
          {% if block.settings.image %}
            {{ block.settings.image | image_url: width: 1920, format: 'webp' | image_tag: class: 'bike-card__img', alt: block.settings.title, loading: 'lazy' }}
          {% endif %}
        </div>
        
        {% endif %}
        
        <div class="bike-card__link_text">
          <div class="bike-card__link">
            {% comment %} <a href="{{ block.settings.link }}">{{ section.settings.btn_text }}</a> {% endcomment %}
            {%- render 'feature-hero-button',
                      button_text: block.settings.btn_text,
                      button_link: block.settings.link,
                      button_style: 'primary',
                      button_bg_color: '#FF6E1D',
                      button_text_color: '#fff',
                      button_hover_bg_color: '#e55a0f',
                      button_hover_text_color: '#fff'
                    -%}
          </div>
          <div class="bike-card__desc font-text-4">
            {{ block.settings.card_desc }}
          </div>
        </div>
      </div>
      {% endif %}
    {% endfor %}
  </div>

  {% comment %} Spec Tags Row {% endcomment %}
  <div class="bike-spec-tags">
    {% for block in section.blocks %}
      {% if block.type == 'spec_tag' %}
      <div class="spec-tag">
        <div class="spec-tag__icon">
