
<div class="page-width" >
  <div class="feature-slider-section">
  <div class="section-padding feature-container">
    {% if section.settings.title != blank or section.settings.subtitle  != blank %}
       <div class="section-header">
         {% if section.settings.title != blank %}
            <h2 class="feature-slider-section__title font-h2">{{ section.settings.title }}</h2>
         {% endif %}
         {% if section.settings.subtitle != blank %}
            <div class="feature-slider-section__subtitle font-text-2">{{ section.settings.subtitle }}</div>
         {% endif %}
       </div>
    {% endif %}
    <div class="feature-slider-section__slider swiper">
        <div class="swiper-wrapper">
        {% for repeat in (1..3) %}
          {% assign useH3 = forloop.first %}
          {% assign useH4 = forloop.first %}
          {% for block in section.blocks %}
            <div class="swiper-slide feature-card">
            <div class="feature-card__image-wrap">
                {% if block.settings.image %}
                {{ block.settings.image | image_url: width:3840, crop: 'center' | image_tag: alt: block.settings.image.alt }}
                {% endif %}
                <div class="feature-card__overlay"></div>
                <div class="feature-card__text">
                 
                  {% if block.settings.number != blank and block.settings.unit != blank %}
                  <div class="feature-card__value-wrap">
                    {% if useH3 %}
                    <h3 class="feature-card__num font-h2">{{ block.settings.number }}{{ block.settings.unit }}</h3>
                    {% else %}
                      <div class="feature-card__num font-h2">{{ block.settings.number }}{{ block.settings.unit }}</div>
                    {% endif %}
                  </div>
                  {% endif %}

                {% if block.settings.label %}
                    {% if useH4 %}
                      <h4 class="feature-card__label font-h3">{{ block.settings.label }}</h4>
                    {% else %}
                      <div class="feature-card__label font-h3">{{ block.settings.label }}</div>
                    {% endif %}
                {% endif %}
                {% if block.settings.desc %}
                    <div class="feature-card__desc font-text-4">{{ block.settings.desc }}</div>
                {% endif %}
                </div>
            </div>
            </div>
        {% endfor %}
      {% endfor %}
        </div>
    </div>

    <div class="feature-slider-section__controls">
        <div class="feature-slider-section__prev">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 18l-6-6 6-6"/>
        </svg>
        </div>
        <div class="feature-slider-section__next">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6"/>
        </svg>
        </div>
    </div>
  </div>
</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const sectionEl = document.querySelector('#shopify-section-{{ section.id }}');
  if (!sectionEl) return;

  const sliderEl = sectionEl.querySelector('.feature-slider-section__slider');
  const btnPrev = sectionEl.querySelector('.feature-slider-section__prev');
  const btnNext = sectionEl.querySelector('.feature-slider-section__next');

  if (!sliderEl) return;

  const swiper = new Swiper(sliderEl, {
    slidesPerView: 'auto',
    spaceBetween:15,
    freeMode: false,
    allowTouchMove: true,
    watchOverflow: true,
    loop: true, // 无限循环
    autoplay:{
      delay: 3000,        // 3秒自动切换
      disableOnInteraction: false // 手动点击后继续轮播
    },
    initialSlide: 0,
    breakpoints: {
      0: {
        slidesPerView: 'auto',
        centeredSlides: true,
        initialSlide: 1,
        centeredSlidesBounds: true
      },
      768: {
        slidesPerView: 2,
        centeredSlides: false,
        centeredSlidesBounds: false
      },
      1025: {
        slidesPerView: 3,
        centeredSlides: false,
        centeredSlidesBounds: false
      }
    }
  });

  if (window.SwiperHelper) {
      window.SwiperHelper.bind(swiper);
    }

  if (btnPrev) {
    btnPrev.addEventListener('click', () => swiper.slidePrev());
  }
  if (btnNext) {
    btnNext.addEventListener('click', () => swiper.slideNext());
  }

  // 鼠标移入暂停轮播，移出恢复
  sliderEl.addEventListener('mouseenter', () => {
    swiper.autoplay.pause();
  });
  sliderEl.addEventListener('mouseleave', () => {
    swiper.autoplay.start();
  });
  
});
</script>

{% style %}
#shopify-section-{{ section.id }} {
  --padding-top-pc:{{ section.settings.padding_top_pc }}px;
  --padding-bottom-pc:{{ section.settings.padding_bottom_pc }}px;
  --padding-top-ipad:{{ section.settings.padding_top_ipad }}px;
  --padding-bottom-ipad:{{ section.settings.padding_bottom_ipad }}px;
  --padding-top-mobile:{{ section.settings.padding_top_mobile }}px;
  --padding-bottom-mobile:{{ section.settings.padding_bottom_mobile}}px;
  --card-aspect-ratio: 4 / 5;
  background: {{ section.settings.bg_color }};
  & h4, & h3,& p,& h2{
    margin: 0;
  }
}

#shopify-section-{{ section.id }} .feature-slider-section{
    overflow: hidden;
   
}
#shopify-section-{{ section.id }} .section-header{
  margin: 0 auto 40px;
}
#shopify-section-{{ section.id }} .feature-slider-section__title {
  margin: 0 auto 15px;
  text-align: center;

}
#shopify-section-{{ section.id }} .feature-slider-section__subtitle{
  margin: 0 auto;
  text-align: center;
  max-width: 830px;
 color: #333333;
 opacity: 0.8;
}

#shopify-section-{{ section.id }} .feature-slider-section__slider {
  overflow: visible;
}

#shopify-section-{{ section.id }} .feature-card {
  width: 32vw;
  max-width: 600px;
}

#shopify-section-{{ section.id }} .feature-card__image-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: var(--card-aspect-ratio);
  border-radius: 12px;
  overflow: hidden;
}

#shopify-section-{{ section.id }} .feature-card__image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

#shopify-section-{{ section.id }} .feature-card__overlay {
  position: absolute;
  inset: 0;
  /* background: linear-gradient(180deg, rgba(0, 0, 0, 0) 34.35%, #000000 93.43%); */
}

#shopify-section-{{ section.id }} .feature-card__text {
  position: absolute;
  left: 24px;
  right: 24px;
  bottom: 24px;
  color: #fff;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* 数字+单位 横向布局，用gap控制间距 */
#shopify-section-{{ section.id }} .feature-card__value-wrap {
  display: flex;
  align-items: baseline;
  gap: 8px;
}

#shopify-section-{{ section.id }} .feature-card__num {
   color:#fff;
   background-color: transparent;
} 

#shopify-section-{{ section.id }} .feature-card__unit {
  font-size: calc(100vw * 50/1920);
  line-height: calc(100vw * 90/1920);
  letter-spacing: -3%;
   font-weight: 600;
   background: linear-gradient(180deg, #FFFFFF 11.11%, #999999 85.56%);
background-clip: text;
-webkit-background-clip: text;
color: transparent; 
}

#shopify-section-{{ section.id }} .feature-card__label {
  color: #fff;
}

#shopify-section-{{ section.id }} .feature-card__desc {
  opacity: 0.6;
}

#shopify-section-{{ section.id }} .feature-slider-section__controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin-top: 32px;
}

#shopify-section-{{ section.id }} .feature-slider-section__prev,
#shopify-section-{{ section.id }} .feature-slider-section__next {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: #000;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}
#shopify-section-{{ section.id }} .feature-slider-section__prev:hover,
#shopify-section-{{ section.id }} .feature-slider-section__next:hover{
  background: #FFF;
  color: #000;
}
@media(max-width: 1024px){
  #shopify-section-{{ section.id }} .feature-card__text {
    gap: 5px;
  }
}
@media(max-width: 767px){
  #shopify-section-{{ section.id }} .feature-card {
    width: 75vw;
    max-width: 556px;
  }
  #shopify-section-{{ section.id }} .feature-slider-section__prev,
  #shopify-section-{{ section.id }} .feature-slider-section__next{
           width: 40px;
        height: 40px;
        border-radius: 12px;
  }
  /* #shopify-section-{{ section.id }} .feature-card__num {
  font-size: calc(100vw * 90/750);
  line-height: calc(100vw * 90/750);
  letter-spacing: -3%;
  font-weight: 600;
  background: linear-gradient(180deg, #FFFFFF 11.11%, #999999 85.56%);
 background-clip: text;
-webkit-background-clip: text; 
color: transparent; 
} */

#shopify-section-{{ section.id }} .feature-card__unit {
  font-size: calc(100vw * 50/750);
  line-height: calc(100vw * 90/750);
  letter-spacing: -3%;
   font-weight: 600;
   background: linear-gradient(180deg, #FFFFFF 11.11%, #999999 85.56%);
background-clip: text;
-webkit-background-clip: text;
color: transparent; 
}
}
{% endstyle %}

{% schema %}
{
  "name": "Feature Slider",
  "settings": [
    { "type": "text", "id": "title", "label": "Section Title" },
    { "type": "richtext", "id": "subtitle", "label": "Section Subtitle Title" },
    {
      "type": "color",
      "id": "bg_color",
      "label": "background color",
      "default": "#f5f5f5"
    },
    {
      "type": "header",
      "content": "padding"
    },
    {
      "type": "number",
      "id": "padding_top_pc",
      "label": "padding top pc"
    },
    {
      "type": "number",
      "id": "padding_bottom_pc",
      "label": "padding bottom pc"
    },
    {
      "type": "number",
      "id": "padding_top_ipad",
      "label": "padding top ipad"
    },
    {
      "type": "number",
      "id": "padding_bottom_ipad",
      "label": "padding bottom ipad"
    },
    {
      "type": "number",
      "id": "padding_top_mobile",
      "label": "padding top mobile"
    },
    {
      "type": "number",
      "id": "padding_bottom_mobile",
      "label": "padding bottom mobile"
    }
  ],
  "blocks": [
    {
      "type": "feature_item",
      "name": "Feature Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Card Image" },
        { "type": "text", "id": "number", "label": "value" },
        { "type": "text", "id": "unit", "label": "unit" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "richtext", "id": "desc", "label": "Description" }
      ]
    }
  ],
  "presets": [
    { "name": "Feature Slider" }
  ]
}
{% endschema %}
