        { "type": "text", "id": "title", "label": "Detail Title" },
        { "type": "richtext", "id": "description", "label": "Detail Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bike Hotspot Feature",
      "blocks": [{"type":"hotspot"},{"type":"hotspot"},{"type":"hotspot"}]
    }
  ]
}
