<script>
  document.addEventListener('DOMContentLoaded', () => {
  const swiperWrap = document.querySelector('#shopify-section-{{ section.id }} .challenge-swiper');
  if (!swiperWrap) return;

  const swiper = new Swiper(swiperWrap, {
    spaceBetween: 14,
    allowTouchMove: true,
    grabCursor: true,
    slidesPerView: "auto",
    breakpoints: {
      1025: { slidesPerView: 4 },
      769: { slidesPerView: 3.1 },
      767:{slidesPerView: 2.5},
      0: { slidesPerView: 1.3 }
    }
  });

  // 核心等高逻辑
  const syncAllCardHeight = () => {
    const allCards = Array.from(document.querySelectorAll('#shopify-section-{{ section.id }} .challenge-step-card'));
    if (allCards.length === 0) return;

    // 1. 先清空固定高度，读取原生内容高度
    allCards.forEach(card => card.style.height = 'auto');

    // 2. 计算所有卡片里最大的高度值
    let maxHeight = 0;
    allCards.forEach(card => {
      const cardHeight = card.offsetHeight;
      if (cardHeight > maxHeight) maxHeight = cardHeight;
    });

    // 3. 全部卡片统一设置为最高高度
    allCards.forEach(card => card.style.height = `${maxHeight}px`);
  };

  // 初始化执行
  syncAllCardHeight();

  // 窗口缩放时重新计算（响应式适配）
  window.addEventListener('resize', syncAllCardHeight);

  // swiper切换后兜底刷新（防止动态内容高度变化）
  swiper.on('slideChange', syncAllCardHeight);
});
</script> {% endcomment %}
