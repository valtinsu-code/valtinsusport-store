{% comment %} <div class="challenge-step-wrap page-width">
  <div class="section-padding">
    <h2 class="challenge-step-title font-h2">How To Join The Challenge</h2>
    <div class="swiper challenge-swiper">
        <div class="swiper-wrapper">
        {% for block in section.blocks %}
            {% if block.type == 'step_card' %}
            <div class="swiper-slide">
                <div class="challenge-step-card">
                  <div class="challenge-card-img">
                  {% if block.settings.step_image != blank %}
                      {{ block.settings.step_image | image_url: width:800 | image_tag: class:'card-img', loading:'lazy', alt:block.settings.step_title | escape }}
                  {% endif %}
                  </div>
                  <div class="challenge-card-text">
                  <span class="step-tag">STEP {{ forloop.index }}</span>
                  <h3 class="step-title font-h3">{{ block.settings.step_title }}</h3>
                  <p class="step-desc font-text-5">{{ block.settings.step_desc }}</p>
                  </div>
              </div>
            </div>
            {% endif %}
        {% endfor %}
        </div>
  </div>
  </div>

  {% if section.blocks.size == 0 %}
    <div class="empty-tip">Add step card blocks in section sidebar</div>
  {% endif %}
</div>

<style>
/* 全部样式带section唯一前缀，不污染全局 */
#shopify-section-{{ section.id }} {
     --padding-top-pc:{{ section.settings.padding_top_pc }}px;
   --padding-bottom-pc:{{ section.settings.padding_bottom_pc }}px;
   --padding-top-ipad:{{ section.settings.padding_top_ipad }}px;
   --padding-bottom-ipad:{{ section.settings.padding_bottom_ipad }}px;
   --padding-top-mobile:{{ section.settings.padding_top_mobile }}px;
   --padding-bottom-mobile:{{ section.settings.padding_bottom_mobile}}px;
  background: {{ section.settings.bg_color }};

}
#shopify-section-{{ section.id }} .challenge-step-wrap{
  overflow: hidden;
}
#shopify-section-{{ section.id }} .challenge-step-title {
  text-align: center;
  margin: 0 0 40px;
}
#shopify-section-{{ section.id }} .challenge-swiper {
  width: 100%;
  overflow: visible;
}
#shopify-section-{{ section.id }} .challenge-swiper .swiper-wrapper {
  display: flex;
  align-items: stretch;
}
/* 卡片容器使用flex垂直流式，内部自适应，不写死固定宽高 */
#shopify-section-{{ section.id }} .challenge-step-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  background: #f8f8f8;
  border-radius: 20px;
  overflow: hidden;
}
#shopify-section-{{ section.id }} .challenge-card-img {
  flex-shrink: 0;
}
#shopify-section-{{ section.id }} .card-img {
  width: 100%;
  height: auto;
  display: block;
  aspect-ratio: 449/367;
}
#shopify-section-{{ section.id }} .challenge-card-text {
  flex: 1;
  padding:  20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
#shopify-section-{{ section.id }} .step-tag {
  display: inline-block;
  color: #ff8844;
  width: fit-content;
  padding: 3px 10px;
  font-size: 12px;
  line-height: 14px;
  background: #FF6E151A;
  border-radius: 4px;
}
#shopify-section-{{ section.id }} .step-title {
  margin: 0;
}
#shopify-section-{{ section.id }} .step-desc {
  margin: 0;
  opacity: 0.75;
}
#shopify-section-{{ section.id }} .empty-tip {
  text-align: center;
  padding: 40px 0;
}
@media(max-width:1024px){
    #shopify-section-{{ section.id }} .card-img {
  
        aspect-ratio: 305/250;
    }
}
@media(max-width:767px){
    #shopify-section-{{ section.id }} .card-img {
  
        aspect-ratio: 442/362;
    }
    #shopify-section-{{ section.id }} .step-tag {
       
        padding: 7px 10px;
        font-size: calc(100vw * 20/var(--base-width));
        line-height: 14px;
       
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const swiperWrap = document.querySelector('#shopify-section-{{ section.id }} .challenge-swiper');
  if (!swiperWrap) return;

  new Swiper(swiperWrap, {
    spaceBetween: 14,
    allowTouchMove: true,
    grabCursor: true,
    slidesPerView: "auto",
    breakpoints: {
      1025: { slidesPerView: 4 },
      768: { slidesPerView: 3.1 },
      0: { slidesPerView: 1.3 }
    }
  });
});
</script>

