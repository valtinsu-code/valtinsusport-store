<script>
document.addEventListener('DOMContentLoaded', () => {
  const section = document.querySelector('#shopify-section-{{ section.id }}');
  if (!section || !window.Swiper) return;

  const swiperEl = section.querySelector('.quoteSwiper');
  const prevBtn = section.querySelector('.slider-btn.prev');
  const nextBtn = section.querySelector('.slider-btn.next');
  const currentIndexEl = section.querySelector('.current-index');

  const swiper = new Swiper(swiperEl, {
    slidesPerView: 1,
    loop: true,
    speed: 600,
    on: {
      slideChange: () => {
        const realIndex = swiper.realIndex + 1;
        if (currentIndexEl) currentIndexEl.textContent = realIndex;
      }
    }
  });

  prevBtn?.addEventListener('click', () => swiper.slidePrev());
  nextBtn?.addEventListener('click', () => swiper.slideNext());
});
</script>