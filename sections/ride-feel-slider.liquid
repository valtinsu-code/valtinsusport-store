<style>
#shopify-section-{{ section.id }} {
  --padding-top-pc: {{ section.settings.padding_top_pc }}px;
  --padding-bottom-pc: {{ section.settings.padding_bottom_pc }}px;
  --padding-top-ipad: {{ section.settings.padding_top_ipad }}px;
  --padding-bottom-ipad: {{ section.settings.padding_bottom_ipad }}px;
  --padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
  --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile}}px;
  & h2,& p{
    margin:0;
  }

}
#shopify-section-{{ section.id }} .slider-head-title {
  margin: 0 auto 40px;
  text-align: center;
}
#shopify-section-{{ section.id }} .slider-wrap {
  max-width:1920px;
  margin:0 auto;
    overflow: hidden;
  position:relative;
}
#shopify-section-{{ section.id }} .carSwiper {
  position: relative;
  overflow: visible ;
}
#shopify-section-{{ section.id }} .swiper-slide {
  border-radius:25px;
  overflow:hidden;
  position:relative;
  width: 996px;
}
#shopify-section-{{ section.id }} .slide-img {
  max-width: 996px;
  width:996px;
  height:auto;
  aspect-ratio: 996/605;
  object-fit:cover;
  display:block;
}
/* 镂空描边大标题蒙层文字 */
{% comment %} #shopify-section-{{ section.id }} .slide-mask-text {
  position:absolute;
  inset:0;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:185px;
  line-height: 222px;
  font-weight:900;
  letter-spacing:-3%;
  color:transparent;
  -webkit-text-stroke:2px #fff;
  pointer-events:none;
  white-space:nowrap;
  background: linear-gradient(0deg, rgba(0, 0, 0, 0.63) 10%, rgba(0, 0, 0, 0) 30%);
} {% endcomment %}
/* 底部标签组 */
#shopify-section-{{ section.id }} .slide-tag-group {
  position:absolute;
  bottom:20px;
  width: 100%;
  display:flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap:10px;
}
#shopify-section-{{ section.id }} .slide-tag {
  flex-shrink: 0;
  background:#FFFFFF1A;
  color:#fff;
  padding:5px 22px;
  border-radius:30px;
  letter-spacing: 0%;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  border: 1px solid rgba(255,255,255,0.2);
}
/* 左右箭头 */
#shopify-section-{{ section.id }} .swiper-btn-controls{
    position: absolute;
    top: 50%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 7%;
    width: 100%;
    transform: translateY(-50%);
    z-index:1;
}
#shopify-section-{{ section.id }} .swiper-btn-prev,
#shopify-section-{{ section.id }} .swiper-btn-next {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: #fff;
    border-radius: 10px;
    color: #000;
    cursor: pointer;
    z-index: 1;
}

#shopify-section-{{ section.id }} .swiper-btn-prev:hover,
  #shopify-section-{{ section.id }} .swiper-btn-next:hover{
    color: #000;
    background-color: #f3f3f3;
    transition: background-color .3s ease;
  }

#shopify-section-{{ section.id }} .swiper-btn-prev { 
  left:26px;
 }
#shopify-section-{{ section.id }} .swiper-btn-next {
   right:26px;
   transform: rotate(180deg);
 }
 @media screen and (max-width:1440px) {
  #shopify-section-{{ section.id }} .swiper-slide {
    max-width: 996px;
    width: 70vw;
  }
  #shopify-section-{{ section.id }} .slide-img {
    max-width: 996px;
    width:70vw;
    aspect-ratio: 996/605;
  }
  {% comment %} #shopify-section-{{ section.id }} .slide-mask-text{
    font-size: calc(100vw * (185/1440));
    line-height: calc(100vw * (222/1440));
  } {% endcomment %}

}
@media screen and (max-width:1024px) {
  #shopify-section-{{ section.id }} .swiper-slide {
    max-width: 707px;
    width: 70vw;
  }
  #shopify-section-{{ section.id }} .slide-img {
    max-width: 707px;
    width:70vw;
    aspect-ratio: 707/429;
  }
  #shopify-section-{{ section.id }} .swiper-btn-controls{
    padding: 0 4%;
  }
  {% comment %} #shopify-section-{{ section.id }} .slide-mask-text{
    font-size: calc(100vw * (136/1024));
    line-height: calc(100vw * (136/1024));
  } {% endcomment %}

}
@media screen and (max-width:767px) {
  #shopify-section-{{ section.id }} .slider-head-title{
    max-width: 77%
  }
  #shopify-section-{{ section.id }} .swiper-btn-controls{
    position: relative;
    display: flex;
    gap: 15px;
    margin-top: 40px;
    align-items: center;
    justify-content: center;
    transform: translateY(0);
  }
  #shopify-section-{{ section.id }} .swiper-btn-prev,
  #shopify-section-{{ section.id }} .swiper-btn-next{
    max-width: 67px;
    max-height: 67px;
    width: calc(100vw * (67/750));
    height: calc(100vw * (67/750));
    border-radius: calc(100vw * (18/750));
    background: #000;
    color: #fff;
    & svg{
      width: 10px;
      height: 18px;
    }
  }
  #shopify-section-{{ section.id }} .slide-tag-group {
    bottom:12px;
    gap:6px;
  }
  #shopify-section-{{ section.id }} .slide-tag{
    padding: 5px calc(100vw * 22/750);
  }
  #shopify-section-{{ section.id }} .swiper-slide {
    width: 66vw;
  }
  #shopify-section-{{ section.id }} .slide-img {
    max-width: 488px;
    width:66vw;
    aspect-ratio: 488/714;
  }
  {% comment %} #shopify-section-{{ section.id }} .slide-mask-text{
    font-size: calc(100vw * (93/750));
    line-height: calc(100vw * (93/750));
  } {% endcomment %}
  #shopify-section-{{ section.id }} .swiper-slide {
    border-radius:17px;
  }
}
@media screen and (max-width:480px){
  #shopify-section-{{ section.id }} .slider-head-title{
    margin: 0 auto 20px;
  }
  #shopify-section-{{ section.id }} .swiper-btn-controls{
    display: flex;
    gap: 10px;
    margin-top: 20px;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .swiper-btn-prev,
  #shopify-section-{{ section.id }} .swiper-btn-next{
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: #000;
    color: #fff;
    cursor:pointer;
    & svg{
      width: 7px;
      height: 12px;
    }
  }

}
</style>
{% assign card_blocks = section.blocks | where: 'type', 'slide_item' %}
<div class="slider-wrap page-width section-padding">
  <h2 class="slider-head-title font-h2">{{ section.settings.section_title }}</h2>
  <div class="swiper carSwiper " data-slide-count="{{ card_blocks.size }}">
    <div class="swiper-wrapper">
      {% for repeat in (1..3) %}
        {%- for block in section.blocks -%}
          {% if block.type == 'slide_item' %}
          <div class="swiper-slide slide-item">
            {% comment %} {% if block.settings.slide_img != blank %}
              {% comment %} <img class="slide-img" src="{{ block.settings.slide_img | image_url: width:1600 }}" alt="{{ block.settings.big_text }}"> {% endcomment %}
            
            {% endif %} {% endcomment %}
             <picture>
              {% if block.settings.img_mobile != blank %}
                <source media="(max-width:767px)" srcset="{{ block.settings.img_mobile | image_url }}">
              {% endif %}
              {% if block.settings.img_ipad != blank %}
                <source media="(max-width:1024px)" srcset="{{ block.settings.img_ipad | image_url }}">
              {% endif %}
              {% if block.settings.img_pc != blank %}
                <img class="slide-img" src="{{ block.settings.img_pc | image_url: width:3840 }}" alt="{{ block.settings.big_text }}">
              {% endif %}
            </picture>
            <!-- 空心描边大字 -->
              {% comment %} <div class="slide-mask-text">{{ block.settings.big_text }}</div> {% endcomment %}
              <!-- 底部标签 修复版 -->
              {%- assign tagArr = block.settings.tags | split:',' -%}
              <div class="slide-tag-group">
              {%- for tag in tagArr -%}
                  {% if tag != blank %}
                  <span class="slide-tag font-text-4">{{ tag | strip }}</span>
                  {% endif %}
              {%- endfor -%}
              </div>
          </div>
          {% endif %}
        {%- endfor -%}
      {% endfor %}
    </div>
    <div class="swiper-btn-controls">
      <div class="swiper-btn-prev">
        <svg width="7" height="12" viewBox="0 0 7 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0.609375 5.59375L5.59309 10.5775" stroke="currentColor" stroke-width="1.21987" stroke-linecap="round"/>
          <path d="M2.07031 4.13281L5.59433 0.608795" stroke="currentColor" stroke-width="1.21987" stroke-linecap="round"/>
        </svg>

      </div>
      <div class="swiper-btn-next">
        <svg width="7" height="12" viewBox="0 0 7 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0.609375 5.59375L5.59309 10.5775" stroke="currentColor" stroke-width="1.21987" stroke-linecap="round"/>
          <path d="M2.07031 4.13281L5.59433 0.608795" stroke="currentColor" stroke-width="1.21987" stroke-linecap="round"/>
        </svg>
      </div>
    
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bike Ride Feel Swiper",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#fff" },
    { "type": "header", "content": "Padding" },
    { "type": "number", "id": "padding_top_pc", "label": "Padding Top (PC)", "default": 40 },
    { "type": "number", "id": "padding_bottom_pc", "label": "Padding Bottom (PC)", "default": 40 },
    { "type": "number", "id": "padding_top_ipad", "label": "Padding Top (iPad)", "default": 30 },
    { "type": "number", "id": "padding_bottom_ipad", "label": "Padding Bottom (iPad)", "default": 30 },
    { "type": "number", "id": "padding_top_mobile", "label": "Padding Top (Mobile)", "default": 20 },
    { "type": "number", "id": "padding_bottom_mobile", "label": "Padding Bottom (Mobile)", "default": 20 },
    {
      "type":"text",
      "id":"section_title",
      "label":"Section Top Title",
      "default":"Pick The Ride Feel Before The Specs"
    }
  ],
  "blocks": [
    {
      "type":"slide_item",
      "name":"Single Slide",
      "settings": [
        {
      "type":"header",
      "content":"Banner Images (PC/Ipad/Mobile)"
    },
    {
      "type":"image_picker",
      "id":"img_pc",
      "label":"Desktop Image(>1024px)"
    },
    {
      "type":"image_picker",
      "id":"img_ipad",
      "label":"Tablet Image(768~1024px)"
    },
    {
      "type":"image_picker",
      "id":"img_mobile",
      "label":"Mobile Image(<767px)"
    },
        
        {
          "type":"text",
          "id":"tags",
          "label":"Bottom Tags(Split by comma)",
          "default":"Stronger Launch,Higher Power,Adult Ride Feel"
        }
      ]
    }
  ],
  "presets": [
    {
      "name":"Ride Feel Slider",
      "blocks": [
        {"type":"slide_item"},
        {"type":"slide_item"},
        {"type":"slide_item"}
      ]
    }
  ]
}
{% endschema %}

