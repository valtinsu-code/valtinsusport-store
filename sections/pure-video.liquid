{%- style -%}
  /* 区块上下内边距 */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .js-youtube,
  #shopify-section-{{ section.id }} .js-vimeo,
  #shopify-section-{{ section.id }} video {
    width: 100%;
    height: 100%;
    object-fit: cover; /* 裁切画面铺满容器，彻底消除黑边 */
    object-position: center center;
  }
  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }

  /* 视频容器最大宽度限制 */
  #shopify-section-{{ section.id }} .video-section {
    
    margin: 0 auto;
  }

  /* 隐藏原生视频控件容器 */
  #shopify-section-{{ section.id }} .player-controls-content,
  #shopify-section-{{ section.id }} #player-controls {
    display: none !important;
  }

  /* YouTube iframe 拦截鼠标悬浮，裁切边缘logo残留 */
  #shopify-section-{{ section.id }} .js-youtube {
    pointer-events: none;
    width: 100%;
    height: 100%;
    transform: scale(1.02);
  }
  #shopify-section-{{ section.id }} .js-vimeo {
    width: 100%;
    height: 100%;
  }

  /* 封面播放按钮居中样式 */
  .deferred-media__poster-button {
    z-index: 2;
  }
{%- endstyle -%}

{%- liquid
  assign video_id = section.settings.video.id | default: section.settings.video_url.id
  assign video_alt = section.settings.video.alt | default: section.settings.description
  assign alt = 'Load video content' | escape

  assign poster = section.settings.video.preview_image | default: section.settings.cover_image

  assign fix_ratio = false
  if section.settings.video != null and poster != null
    assign ratio_diff = section.settings.video.aspect_ratio | minus: poster.aspect_ratio | abs
    if ratio_diff < 0.01 and ratio_diff > 0
      assign fix_ratio = true
    endif
  endif
-%}

{%- capture sizes -%}
  {% if section.settings.full_width -%}
    100vw
  {%- else -%}
    (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px)
    calc(100vw - 10rem), 100vw
  {%- endif %}
{%- endcapture -%}

<div id="shopify-section-{{ section.id }}" class="color-{{ section.settings.color_scheme }} gradient">
  <div class="video-section isolate{% unless section.settings.full_width %} page-width{% endunless %} section-{{ section.id }}-padding">
    <!-- 标题区域 -->
    <div {% if section.settings.full_width %}class="page-width"{% endif %}>
      {%- unless section.settings.heading == blank -%}
        <div class="title-wrapper title-wrapper--no-top-margin{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        </div>
      {%- endunless -%}
    </div>

    <!-- 视频容器，比例由后台下拉控制 -->
    <deferred-media
      class="video-section__media deferred-media gradient global-media-settings{% if section.settings.full_width %} global-media-settings--full-width{% endif %}{% if fix_ratio %} media-fit-cover{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      data-media-id="{{ video_id }}"
      style="--ratio-percent: {{ section.settings.video_aspect_ratio | default: 56.25 }}%;"
    >
      <button
        id="Deferred-Poster-Modal-{{ video_id }}"
        class="video-section__poster media deferred-media__poster media--landscape"
        type="button"
        aria-label="{{ alt }}"
      >
        {%- if poster != null -%}
          {{
            poster
            | image_url: width: 3840
            | image_tag: sizes: sizes, widths: '375,750,1100,1500,1780,2000,3000,3840', alt: alt
          }}
        {%- else -%}
          {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
        {%- endif -%}
        <span class="deferred-media__poster-button motion-reduce">
          <span class="svg-wrapper">
            {{- 'icon-play.svg' | inline_asset_content -}}
          </span>
        </span>
      </button>

      <template>
        {%- if section.settings.video == null and section.settings.video_url != null -%}
          {%- liquid
            assign loop_param = ''
            if section.settings.enable_video_looping
              assign loop_param = '&loop=1&playlist=' | append: video_id
            endif
            assign extra_params = '&mute=1&controls=0&disablekb=1&modestbranding=1&rel=0'
          -%}
          {%- if section.settings.video_url.type == 'youtube' -%}
            <iframe
              src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&autoplay=1{{ loop_param }}{{ extra_params }}"
              class="js-youtube"
              allow="autoplay; encrypted-media"
              allowfullscreen
              title="{{ section.settings.description | escape }}"
            ></iframe>
          {%- else -%}
            <iframe
              src="https://player.vimeo.com/video/{{ video_id }}?autoplay=1&controls=0"
              class="js-vimeo"
              allow="autoplay; encrypted-media"
              allowfullscreen
              title="{{ section.settings.description | escape }}"
            ></iframe>
          {%- endif -%}
        {%- else -%}
          {{
            section.settings.video
            | video_tag:
              image_size: '1100x',
              autoplay: true,
              loop: section.settings.enable_video_looping,
              controls: false,
              muted: true
          }}
        {%- endif -%}
      </template>
    </deferred-media>
  </div>
</div>

<!-- 仅当前区块生效的可视播放/暂停JS -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  const sectionEl = document.querySelector('#shopify-section-{{ section.id }}');
  if (!sectionEl) return;

  const mediaWrap = sectionEl.querySelector('deferred-media');
  const posterBtn = mediaWrap.querySelector('.deferred-media__poster');
  const playBtnUI = mediaWrap.querySelector('.deferred-media__poster-button');
  let iframePlayer = null;
  let iframeReady = false;

  const io = new IntersectionObserver((entries) => {
    const entry = entries[0];
    const isShow = entry.isIntersecting;

    if (isShow) {
      if (!iframePlayer) {
        posterBtn.click();
        iframePlayer = mediaWrap.querySelector('.js-youtube, .js-vimeo');
        iframePlayer.onload = () => iframeReady = true;
      }
      setTimeout(() => {
        if (!iframeReady) return;
        iframePlayer.contentWindow.postMessage(JSON.stringify({
          event: "command",
          func: "playVideo",
          args: ""
        }), "*");
        playBtnUI.style.opacity = "0";
      }, 150);
    } else {
      setTimeout(() => {
        if (!iframeReady) return;
        iframePlayer.contentWindow.postMessage(JSON.stringify({
          event: "command",
          func: "pauseVideo",
          args: ""
        }), "*");
        playBtnUI.style.opacity = "1";
      }, 100);
    }
  }, { threshold: 0.3 });

  io.observe(mediaWrap);
});
</script>

{% schema %}
{
  "name": "Pure Video",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Header Text"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Video Title",
      "label": "Section Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {"value":"h2","label":"H2 Size"},
        {"value":"h1","label":"H1 Size"},
        {"value":"h0","label":"H0 Size"},
        {"value":"hxl","label":"HXL Size"},
        {"value":"hxxl","label":"HXXL Size"}
      ],
      "default": "h1",
      "label": "Heading Font Size"
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "Enable Video Loop",
      "default": false
    },
    {
      "type": "header",
      "content": "Local Video File"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Upload Local MP4 Video"
    },
    {
      "type": "header",
      "content": "Youtube / Vimeo Video"
    },
    {
      "type": "paragraph",
      "content": "Paste full video link below if you do not upload local video file."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
      "label": "Youtube / Vimeo Video Link",
      "info": "Support short link https://youtu.be/xxx or standard watch link"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Video Cover Screenshot",
      "info": "Placeholder image before video loads"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Video Alt Text",
      "info": "For screen reader accessibility"
    },
    {
      "type": "header",
      "content": "Layout & Size Control"
    },
    {
      "type": "select",
      "id": "video_aspect_ratio",
      "options": [
        {"value":"56.25","label":"16:9 Standard Video"},
        {"value":"42.85","label":"21:9 Ultra Wide Banner"},
        {"value":"46.20","label":"1920 / 887 Custom Banner"},
        {"value":"133.33","label":"3:4 Vertical Short Video"}
      ],
      "default": "46.20",
      "label": "Video Width & Height Ratio",
      "info": "Adjust video container proportion"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Browser Width",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section Vertical Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Bottom Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Top Padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Bottom Padding",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Pure Video"
    }
  ]
}
{% endschema %}
 