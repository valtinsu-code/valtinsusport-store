{%- style -%}
#shopify-section-{{ section.id }} {
    --padding-top-pc:{{ section.settings.padding_top_pc }}px;
    --padding-bottom-pc:{{ section.settings.padding_bottom_pc }}px;
    --padding-top-ipad:{{ section.settings.padding_top_ipad }}px;
    --padding-bottom-ipad:{{ section.settings.padding_bottom_ipad }}px;
    --padding-top-mobile:{{ section.settings.padding_top_mobile }}px;
    --padding-bottom-mobile:{{ section.settings.padding_bottom_mobile}}px;
  }
#shopify-section-{{ section.id }} * {
  box-sizing: border-box;
  
}

#shopify-section-{{ section.id }} .dealer-support-section {
  background-color: #ffffff;
}

#shopify-section-{{ section.id }} .dealer-support-grid {
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
  gap: 1.5rem;
  align-items: stretch;
}

/* 卡片容器 */
#shopify-section-{{ section.id }} .feature-card {
  padding: 40px;
  background: #f8f8f8;
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  border-radius: 25px;
   height: 100%;
}

/* 带圆角的图片 */
#shopify-section-{{ section.id }} .card-image-wrapper {
  width: 100%;
  height: 332px;
  border-radius: 16px 16px 0 0;
  flex-shrink: 0;
  overflow: hidden;
}

#shopify-section-{{ section.id }} .card-image-wrapper img {
  width: 100%;
  height: 100%;
  border-radius: 25px;
  object-fit: cover;
  display: block;
}

#shopify-section-{{ section.id }} .card-footer {
  flex: 1;
  margin-top: 40px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
}

#shopify-section-{{ section.id }} .card-text-group {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    align-self: flex-start;
    height: 100%;
    width: 100%;
}

#shopify-section-{{ section.id }} .card-title {

  color: #333333;
  margin: 0;
}

/* 描述文本 */
#shopify-section-{{ section.id }} .card-desc {
  display: block;
  max-width: 436px;
  font-weight: 400;
  letter-spacing: 0;
  color: rgba(51, 51, 51, 0.6);
  margin: 0;
}

#shopify-section-{{ section.id }} .card-desc p{
  margin: 0;
}


/* 右侧按钮 */
#shopify-section-{{ section.id }} .card-link {
   display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  /* width: 219px;
  height: 46px; */
  flex-shrink: 0;
  padding: 10px 30px;
  background-color: #FF6E1D;
  color: #ffffff;
  border-radius: 55px;
  text-decoration: none;
  transition: background-color 0.2s ease;
  text-align: center;
  text-transform: capitalize;
}


#shopify-section-{{ section.id }} .card-link:hover {
  background-color: #e55a0f;
}

/* 响应式适配 */
@media(max-width: 1440px){
  #shopify-section-{{ section.id }} .dealer-support-grid{
    /* padding: 0 40px; */
  }
  #shopify-section-{{ section.id }} .feature-card{
    padding: 36px 29px;
  }
  /* #shopify-section-{{ section.id }} .card-link{
    width: 186px;
  } */
  #shopify-section-{{ section.id }} .card-desc{
    max-width: 386px;
  }
}
@media(max-width: 1024px){
  #shopify-section-{{ section.id }} .feature-card{
    padding: 20px;
  }
  #shopify-section-{{ section.id }} .card-footer{
    margin-top: 20px;
    flex-direction: column;
    align-items: flex-start;
  }
  #shopify-section-{{ section.id }} .card-text-group{
    gap: 20px;
    flex-direction: column;
    align-items: flex-start;
  }
}
@media (max-width: 767px) {
  #shopify-section-{{ section.id }} .dealer-support-grid {
    grid-template-columns: 1fr;
    /* padding: 0 1rem; */
  }
  #shopify-section-{{ section.id }} .feature-card{
    padding: 25px;
  }

  #shopify-section-{{ section.id }} .card-footer {
    gap: 15px;
    flex-direction: column;
    align-items: flex-start;
  }

  #shopify-section-{{ section.id }} .card-button {
    align-self: flex-start;
  }

  #shopify-section-{{ section.id }} .card-title {
    max-width: 620px;
  }
  #shopify-section-{{ section.id }} .card-desc {
    max-width: 620px;
  }
  #shopify-section-{{ section.id }} .card-image-wrapper{
   
    width: 100%;
    height: auto;
    aspect-ratio: 620 / 332;
  }
  #shopify-section-{{ section.id }} .card-text-group{
    gap: 15px;

  }  

}

@media(max-width:480px){
  #shopify-section-{{ section.id }} .card-footer{
    margin-top: 20px;
  }  
  #shopify-section-{{ section.id }} .feature-card{
    padding: 15px;
  }
}

{%- endstyle -%}

{% schema %}
{
  "name": "Dealer & Support Cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Title",
      "default": "Dirt Clips From Thousands Of Creators"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "background color",
      "default": "#fff"
    },
    {
      "type": "header",
      "content": "padding"
    },
    {
      "type": "number",
      "id": "padding_top_pc",
      "label": "padding top pc"
    },
    {
      "type": "number",
      "id": "padding_bottom_pc",
      "label": "padding bottom pc"
    },
    {
      "type": "number",
      "id": "padding_top_ipad",
      "label": "padding top ipad"
    },
    {
      "type": "number",
      "id": "padding_bottom_ipad",
      "label": "padding bottom ipad"
    },
    {
      "type": "number",
      "id": "padding_top_mobile",
      "label": "padding top mobile"
    },
    {
      "type": "number",
      "id": "padding_bottom_mobile",
      "label": "padding bottom mobile"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Feature Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Card Image mobile"
        },
        
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "A Valtinsu Dealer May Be Closer Than You Think"
        },
        {
          "type": "richtext",
          "id": "desc",
          "label": "Card Description",
          "default": "<p>Find your nearest dealer to explore Valtinsu in person and get closer to the ride that fits your dirt season.</p>"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Find A Dealer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dealer & Support Cards",
      "blocks": [
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}

<div class="dealer-support-section page-width section-padding">
  <div class="dealer-support-grid">
    {% for block in section.blocks %}
      <div class="feature-card">
        {% if block.settings.image %}
          <div class="card-image-wrapper">
            {% comment %} <img 
              src="{{ block.settings.image | image_url }}"
              
              alt="{{ block.settings.title | escape }}"
              loading="lazy"
              width="834"
              height="332"
              class="card-image"
            > {% endcomment %}
              {% comment %} <img 
              src="{{ block.settings.image | image_url: width:834, format:'webp' }}"
              srcset="
                {{ block.settings.image | image_url: width:620, format:'webp' }} 750w,
                {{ block.settings.image | image_url: width:427, format:'webp' }} 1024w,
                {{ block.settings.image | image_url: width:615, format:'webp' }} 1440w,
                {{ block.settings.image | image_url: width:834, format:'webp' }} 1920w
              "
              sizes="(max-width: 750px) 620px,
                    (max-width: 1024px) 427px,
                    (max-width: 1440px) 615px,
                    834px"
              alt="{{ block.settings.title | escape }}"
              loading="lazy"
              width="834"
              height="332"
              class="card-image"
            > {% endcomment %}
              {% comment %} <picture>
                {% if block.settings.image_mobile != blank %}
                  <source media="(max-width:767px)" srcset="{{ block.settings.image_mobile | image_url }}">
                {% endif %}
                {% comment %} {% if block.settings.img_ipad != blank %}
                  <source media="(max-width:1024px)" srcset="{{ block.settings.img_ipad | image_url }}">
                {% endif %} {% endcomment %}
                {% if block.settings.image != blank %}
                  <img class="card-image" src="{{ block.settings.image | image_url: width:3840 }}" alt="{{ block.settings.title }}">
                {% endif %}
              </picture> {% endcomment %}
              <picture>
              {% if block.settings.image_mobile != blank %}
                <source media="(max-width:767px)" srcset="{{ block.settings.image_mobile | image_url: width: 800 }}">
              {% endif %}
              {% if block.settings.image != blank %}
                <img 
                  class="card-image" 
                  src="{{ block.settings.image | image_url: width: 1920 }}" 
                  srcset="
                    {{ block.settings.image | image_url: width: 720 }} 720w,
                    {{ block.settings.image | image_url: width: 900 }} 900w,
                     {{ block.settings.image | image_url: width: 1100 }} 1100w,
                    {{ block.settings.image | image_url: width: 1536 }} 1536w,
                    {{ block.settings.image | image_url: width: 1920 }} 1920w
                  "
                  sizes="(max-width: 767px) 100vw, min(100vw, var(--card-max-width, 1920px))"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  decoding="async"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {% endif %}
            </picture>
          </div>
        {% endif %}

        <div class="card-footer">
          <h3 class="card-title font-h3">{{ block.settings.title }}</h3>
          <div class="card-text-group">
            
            <div class="card-desc font-text-5">{{ block.settings.desc }}</div>
            {% if block.settings.button_link and block.settings.button_text %}
            <a href="{{ block.settings.button_link }}" class="card-link font-button-1">
              {{ block.settings.button_text }}
              <svg xmlns="http://www.w3.org/2000/svg" width="9" height="15" viewBox="0 0 9 15" fill="none">
                <path d="M1.59071 13.589L1.53409 13.6401C1.2395 13.8806 0.804746 13.8637 0.530054 13.589C0.255361 13.3143 0.238401 12.8795 0.478954 12.5849L0.530054 12.5283L6.5301 6.52826C6.823 6.23537 7.29787 6.23537 7.59076 6.52826C7.88366 6.82116 7.88366 7.29603 7.59076 7.58892L1.59071 13.589Z" fill="currentColor"></path>
                <path d="M0.539529 1.59031L0.487739 1.533C0.247784 1.23842 0.265054 0.804125 0.539529 0.52965C0.814004 0.255175 1.2483 0.237905 1.54288 0.47786L1.60019 0.52965L5.84283 4.77229C6.13572 5.06518 6.13572 5.54006 5.84283 5.83295C5.54994 6.12584 5.07506 6.12584 4.78217 5.83295L0.539529 1.59031Z" fill="currentColor"></path>
              </svg>
            </a>
          {% endif %}
          </div>
          
        </div>
      </div>
    {% endfor %}
  </div>
</div>