<script>
  {% comment %} document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('#shopify-section-{{ section.id }}');
    const wrapper = section?.querySelector('.cards-wrapper');
    const cards = wrapper ? Array.from(wrapper.querySelectorAll('.polaroid-card')) : [];

    const svg = section?.querySelector('.section-svg-bg svg');
    const bgPaths = svg ? Array.from(svg.querySelectorAll('path')) : [];
    const arrowSvg = section?.querySelector('.callout-arrow svg');
    const arrowPaths = arrowSvg ? Array.from(arrowSvg.querySelectorAll('path')) : [];

    const shutterBtn = section?.querySelector('.camera-shutter-btn');

    // 保存每张卡片的【相对百分比】（永久不变）
    const initialWrapperWidth = wrapper?.offsetWidth || 1;
    const cardInfos = cards.map(card => {
      const l = parseFloat(getComputedStyle(card).left) || 0;
      const t = parseFloat(getComputedStyle(card).top) || 0;
      const w = parseFloat(getComputedStyle(card).width) || 1;

      return {
        el: card,
        leftRatio: l / initialWrapperWidth,   // left 相对比例
        topRatio: t / initialWrapperWidth,    // top 相对比例
        widthRatio: w / initialWrapperWidth,  // 宽度相对比例
      };
    });

    // ==============================
    // ✅ 核心：永远按当前容器宽度重算
    // 尺寸 + 定位 同步等比缩放
    // ==============================
    function updateResponsiveCards() {
      if (window.ScrollTrigger) ScrollTrigger.refresh();
      // 🔥 永远取当前最新的容器宽度（完全灵活）
    }

    function updateCardPosition() {
      updateResponsiveCards();
    }

    // 初始化
    updateResponsiveCards();

    if (bgPaths.length > 0) {
      bgPaths.forEach(path => {
        const len = path.getTotalLength();
        gsap.set(path, { strokeDasharray: len, strokeDashoffset: -len, opacity: 1 });
      });
      gsap.to(bgPaths, {
        strokeDashoffset: 0,
        ease: "none",
        scrollTrigger: { trigger: section, start: "top center", end: "bottom center", scrub: true }
      });
    }
    if (arrowPaths.length > 0) {
      arrowPaths.forEach(path => {
        const len = path.getTotalLength();
        gsap.set(path, { strokeDasharray: len, strokeDashoffset: len });
      });
    }

    gsap.set(cards, { scale: 0, opacity: 0, transformOrigin: 'center center' });

    cards.forEach(card => {
      card.addEventListener('mouseenter', () => {
        card.style.zIndex = 99;
        gsap.to(card, { scale: 1.08, duration: 0.22 });
      });
      card.addEventListener('mouseleave', () => {
        gsap.to(card, { scale: 1, duration: 0.25, onComplete: () => { card.style.zIndex = 1; } });
      });
    });

    function playCameraSound() {
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        const audioCtx = new AudioContext();
        const now = audioCtx.currentTime;

        function shutterClick(startTime, frequency, volume, duration) {
          const oscillator = audioCtx.createOscillator();
          const gainNode = audioCtx.createGain();
          oscillator.type = 'square';
          oscillator.frequency.setValueAtTime(frequency, startTime);
          oscillator.frequency.exponentialRampToValueAtTime(frequency * 0.45, startTime + duration);
          gainNode.gain.setValueAtTime(0.0001, startTime);
          gainNode.gain.exponentialRampToValueAtTime(volume, startTime + 0.008);
          gainNode.gain.exponentialRampToValueAtTime(0.0001, startTime + duration);
          oscillator.connect(gainNode);
          gainNode.connect(audioCtx.destination);
          oscillator.start(startTime);
          oscillator.stop(startTime + duration + 0.02);
        }

        function shutterNoise(startTime) {
          const bufferSize = audioCtx.sampleRate * 0.12;
          const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
          const output = buffer.getChannelData(0);
          for (let i = 0; i < bufferSize; i++) {
            output[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / bufferSize, 2.2);
          }
          const source = audioCtx.createBufferSource();
          const filter = audioCtx.createBiquadFilter();
          const gainNode = audioCtx.createGain();
          source.buffer = buffer;
          filter.type = 'highpass';
          filter.frequency.setValueAtTime(1200, startTime);
          gainNode.gain.setValueAtTime(0.0001, startTime);
          gainNode.gain.exponentialRampToValueAtTime(0.09, startTime + 0.012);
          gainNode.gain.exponentialRampToValueAtTime(0.0001, startTime + 0.12);
          source.connect(filter);
          filter.connect(gainNode);
          gainNode.connect(audioCtx.destination);
          source.start(startTime);
        }

        shutterClick(now, 1450, 0.12, 0.055);
        shutterNoise(now + 0.035);
        shutterClick(now + 0.105, 720, 0.18, 0.075);
      } catch (e) {}
    }

    function playCardAnimation() {
      gsap.set(cards, { scale: 0, opacity: 0 });
      gsap.set(section, { opacity: 0 });
      gsap.to(section, {
        opacity: 1,
        duration: 1.2,
        ease: 'power2.out'
      });
      gsap.to(cards, {
        scale: 1,
        opacity: 1,
        duration: 1,
        ease: 'back.out(1.2)',
        stagger: 0.15
      });
    }

    if (shutterBtn) {
      shutterBtn.addEventListener('click', () => {
        playCameraSound();
        updateCardPosition();

        showNextBatch();

        playCardAnimation(true);
      });

      shutterBtn.addEventListener('touchstart', (e) => {
        e.preventDefault();
        shutterBtn.click();
      });
    }

    // 窗口变化 → 永远按当前宽度重算
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        updateResponsiveCards();
      }, 50);
    });

    const observer = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting) {
        if (arrowPaths.length) {
          gsap.to(arrowPaths, { strokeDashoffset: 0, duration: 1, delay: 0.5 });
        }
        playCardAnimation(true);
        observer.unobserve(section);

      }
    }, { threshold: 0.25, rootMargin: '0px 0px -10% 0px' });
    observer.observe(section);
  }); {% endcomment %}
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('#shopify-section-{{ section.id }}');
    const wrapper = section?.querySelector('.cards-wrapper');
    const cards = wrapper ? Array.from(wrapper.querySelectorAll('.polaroid-card')) : [];

    const svg = section?.querySelector('.section-svg-bg svg');
    const bgPaths = svg ? Array.from(svg.querySelectorAll('path')) : [];
    const arrowSvg = section?.querySelector('.callout-arrow svg');
    const arrowPaths = arrowSvg ? Array.from(arrowSvg.querySelectorAll('path')) : [];

    const shutterBtn = section?.querySelector('.js-shot-trigger');
    const initialWrapperWidth = wrapper?.offsetWidth || 1;
    let hasPlayedCardAnimation = false;
    const cardsPerBatch = 5;
    const totalBatches = Math.max(1, Math.ceil(cards.length / cardsPerBatch));
    let currentBatchIndex = 0;

    function getBatchCards(batchIndex = currentBatchIndex) {
      const start = batchIndex * cardsPerBatch;
      return cards.slice(start, start + cardsPerBatch);
    }

    function setVisibleBatch(batchIndex) {
      currentBatchIndex = batchIndex;
      cards.forEach((card, index) => {
        const isActive = Math.floor(index / cardsPerBatch) === currentBatchIndex;
        const slotIndex = index % cardsPerBatch;
        card.classList.toggle('is-hidden', !isActive);
        card.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        for (let i = 1; i <= cardsPerBatch; i++) {
          card.classList.toggle(`is-slot-${i}`, isActive && slotIndex === i - 1);
        }
        if (!isActive) {
          gsap.set(card, { '--card-scale': 0.08, opacity: 0 });
        }
      });
    }

    function showNextBatch() {
      setVisibleBatch((currentBatchIndex + 1) % totalBatches);
    }

    gsap.set(cards, { '--card-scale': 0, opacity: 0, transformOrigin: 'center center' });
    setVisibleBatch(0);

    // 保存每张卡片的【相对百分比】（永久不变）
    const cardInfos = cards.map(card => {
      const l = parseFloat(getComputedStyle(card).left) || 0;
      const t = parseFloat(getComputedStyle(card).top) || 0;
      const w = parseFloat(getComputedStyle(card).width) || 1;

      return {
        el: card,
        leftRatio: l / initialWrapperWidth,   // left 相对比例
        topRatio: t / initialWrapperWidth,    // top 相对比例
        widthRatio: w / initialWrapperWidth,  // 宽度相对比例
      };
    });

    // ==============================
    // ✅ 核心：永远按当前容器宽度重算
    // 尺寸 + 定位 同步等比缩放
    // ==============================
    function updateResponsiveCards() {
      if (window.ScrollTrigger) ScrollTrigger.refresh();

    }

    function updateCardPosition() {
      updateResponsiveCards();
    }

    // 初始化布局（不碰卡片动画状态）
    updateResponsiveCards();

    if (bgPaths.length > 0) {
      bgPaths.forEach(path => {
        const len = path.getTotalLength();
        gsap.set(path, { strokeDasharray: len, strokeDashoffset: -len, opacity: 1 });
      });
      gsap.to(bgPaths, {
        strokeDashoffset: 0,
        ease: "none",
        scrollTrigger: { trigger: section, start: "top center", end: "bottom center", scrub: true }
      });
    }

    // ======================
    // ✅ 箭头初始化（不动）
    // ======================
    if (arrowPaths.length > 0) {
      arrowPaths.forEach(path => {
        const len = path.getTotalLength();
        gsap.set(path, { strokeDasharray: len, strokeDashoffset: len });
      });
    }

    // ==============================
    // 🔥 🔥 🔥 关键：图片全部加载完再初始化卡片状态
    // ==============================
    const images = cards.map(card => card.querySelector('img')).filter(Boolean);
    let loadedImages = 0;

    function onAllImagesLoaded() {
      // ✅ 所有图片加载完成 → 现在才能设置卡片隐藏
      updateResponsiveCards();
    }

    function onImageLoad() {
      loadedImages++;
      if (loadedImages === images.length) {
        onAllImagesLoaded();
      }
    }

    if (images.length === 0) {
      onAllImagesLoaded();
    } else {
      images.forEach(img => {
        if (img.complete && img.naturalHeight > 0) {
          onImageLoad();
        } else {
          img.addEventListener('load', onImageLoad);
          img.addEventListener('error', onImageLoad);
        }
      });
    }

    // hover 不变
    cards.forEach(card => {
      card.addEventListener('mouseenter', () => {
        card.style.zIndex = 99;
        gsap.to(card, {
          '--card-scale': 1.055,
          '--card-hover-y': '-8px',
          boxShadow: '0 18px 38px rgba(0,0,0,0.16)',
          duration: 0.28,
          ease: 'power3.out',
          overwrite: 'auto'
        });
      });
      card.addEventListener('mouseleave', () => {
        gsap.to(card, {
          '--card-scale': 1,
          '--card-hover-y': '0px',
          boxShadow: '0 10px 25px rgba(0,0,0,0.1)',
          duration: 0.2,
          ease: 'power3.out',
          overwrite: 'auto',
          onComplete: () => {
            card.style.zIndex = 1;
          }
        });
      });
    });

    function playCameraSound() {
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        const audioCtx = new AudioContext();
        const now = audioCtx.currentTime;

        function shutterClick(startTime, frequency, volume, duration) {
          const oscillator = audioCtx.createOscillator();
          const gainNode = audioCtx.createGain();
          oscillator.type = 'square';
          oscillator.frequency.setValueAtTime(frequency, startTime);
          oscillator.frequency.exponentialRampToValueAtTime(frequency * 0.45, startTime + duration);
          gainNode.gain.setValueAtTime(0.0001, startTime);
          gainNode.gain.exponentialRampToValueAtTime(volume, startTime + 0.008);
          gainNode.gain.exponentialRampToValueAtTime(0.0001, startTime + duration);
          oscillator.connect(gainNode);
          gainNode.connect(audioCtx.destination);
          oscillator.start(startTime);
          oscillator.stop(startTime + duration + 0.02);
        }

        function shutterNoise(startTime) {
          const bufferSize = audioCtx.sampleRate * 0.12;
          const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
          const output = buffer.getChannelData(0);
          for (let i = 0; i < bufferSize; i++) {
            output[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / bufferSize, 2.2);
          }
          const source = audioCtx.createBufferSource();
          const filter = audioCtx.createBiquadFilter();
          const gainNode = audioCtx.createGain();
          source.buffer = buffer;
          filter.type = 'highpass';
          filter.frequency.setValueAtTime(1200, startTime);
          gainNode.gain.setValueAtTime(0.0001, startTime);
          gainNode.gain.exponentialRampToValueAtTime(0.09, startTime + 0.012);
          gainNode.gain.exponentialRampToValueAtTime(0.0001, startTime + 0.12);
          source.connect(filter);
          filter.connect(gainNode);
          gainNode.connect(audioCtx.destination);
          source.start(startTime);
        }

        shutterClick(now, 1450, 0.12, 0.055);
        shutterNoise(now + 0.035);
        shutterClick(now + 0.105, 720, 0.18, 0.075);
      } catch (e) {}
    }

    // ==============================
    // ✅ 点击拍照：组件透明→不透明
    // ==============================
    function playCardAnimation(forceReplay = false) {
      if (hasPlayedCardAnimation && !forceReplay) return;
      hasPlayedCardAnimation = true;
      const activeCards = getBatchCards();

      gsap.killTweensOf(activeCards);
      gsap.set(activeCards, { '--card-scale': 0.08, opacity: 0 });
      gsap.to(activeCards, {
        '--card-scale': 1,
        opacity: 1,
        duration: 0.85,
        ease: 'back.out(1.45)',
        stagger: 0.18
      });
    }

    if (shutterBtn) {
      shutterBtn.addEventListener('click', () => {
        playCameraSound();
        updateCardPosition();

        showNextBatch();

        // ✅ 这里补上：点击拍照 → 整个组件 0 → 1 透明动画
        gsap.set(section, { opacity: 0 });
        gsap.to(section, {
          opacity: 1,
          duration: 5,
          ease: "power2.out"
        });

        playCardAnimation(true);
      });

      shutterBtn.addEventListener('touchstart', (e) => {
        e.preventDefault();
        shutterBtn.click();
      });
    }

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        updateResponsiveCards();
      }, 50);
    });

    // ==============================
    // ✅ 箭头动画修复：先画长线 → 再画两个短线
    // ==============================
    const observer = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting) {
        if (arrowPaths.length) {
          const arrowTl = gsap.timeline();
          // 第一步：先画主长线
          arrowTl.to(arrowPaths[0], {
            strokeDashoffset: 0,
            duration: 1,
            ease: "power2.out"
          });
          // 第二步：再画两个箭头小尾巴
          arrowTl.to([arrowPaths[1], arrowPaths[2]], {
            strokeDashoffset: 0,
            duration: 0.4,
            ease: "power2.out"
          }, "+=0.1");
        }

        playCardAnimation();
        observer.unobserve(section);
      }
    }, { threshold: 0.25, rootMargin: '0px 0px -10% 0px' });
    observer.observe(section);
  });
</script>

