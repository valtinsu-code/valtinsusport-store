  <div class="camera-section-header">
    <h2 class="camera-title font-h2">{{ section.settings.title }}</h2>
    <div class="camera-subtitle font-text-2">{{ section.settings.subtitle }}</div>
  </div>

  <div class="camera-img-box">
    <div class="camera-callout-inner">
      <span class="callout-text caveat-brush-font-family">
        {{- section.settings.callout_text | default: 'CLICK HERE' -}}
      </span>
      <div class="callout-arrow">
        <svg viewBox="0 0 106 75" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2.82937 3.26769C1.3502 16.837 9.92938 44.8803 56.0795 48.4987C113.767 53.0219 105.634 15.1408 85.6653 5.52924C65.6965 -4.08236 35.3735 11.1831 44.9881 42.8449C51.6444 57.545 71.6132 63.7643 102.676 61.5027" stroke="#FF6E1D" stroke-width="5.35256" stroke-linecap="round" class="arrow-path-1"/>
          <path d="M102.676 61.5027L93.0612 71.6797" stroke="#FF6E1D" stroke-width="5.35256" stroke-linecap="round" class="arrow-path-2"/>
          <path d="M102.676 61.5027L90.1028 54.1527" stroke="#FF6E1D" stroke-width="5.35256" stroke-linecap="round" class="arrow-path-3"/>
        </svg>
      </div>
    </div>
    <button class="camera-shutter-btn js-shot-trigger" type="button" aria-label="Take photo">
      <span class="camera-shutter-btn-inner"></span>
    </button>

    {% if section.settings.camera_icon != blank %}
      {{
        section.settings.camera_icon
        | image_url: width: 600, format: 'webp'
        | image_tag: class: 'camera-img', alt: 'camera_img', loading: 'lazy'
      }}
    {% endif %}
  </div>

  <div class="cards-wrapper">
    {% for block in section.blocks %}
      <div class="polaroid-card{% if forloop.index > 5 %} is-hidden{% endif %}" data-card-index="{{ forloop.index0 }}">
        <div class="polaroid-img-inner">
          {% if block.settings.photo != blank %}
            <img
              src="{{ block.settings.photo | image_url: width: 800, format:'webp' }}"
              alt="{{ block.settings.caption | strip_html |default: 'Photo' }}"
              loading="lazy"
              data-original-src="{{ block.settings.photo | image_url: width: 800, format:'webp' }}"
              data-src="{% if block.settings.new_photo != blank %}{{ block.settings.new_photo | image_url: width: 800, format:'webp' }}{% endif %}"
              width="{{ block.settings.w_1920 }}"
              height="{{ block.settings.h_1920 }}"
            >
          {% else %}
            <div class="img-placeholder"></div>
          {% endif %}
        </div>
        {% if block.settings.caption != blank %}
          <div class="polaroid-text caveat-brush-font-family">{{ block.settings.caption }}</div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% style %}
  #shopify-section-{{ section.id }} {
      --padding-top-pc:{{ section.settings.padding_top_pc }}px;
      --padding-bottom-pc:{{ section.settings.padding_bottom_pc }}px;
      --padding-top-ipad:{{ section.settings.padding_top_ipad }}px;
      --padding-bottom-ipad:{{ section.settings.padding_bottom_ipad }}px;
      --padding-top-mobile:{{ section.settings.padding_top_mobile }}px;
      --padding-bottom-mobile:{{ section.settings.padding_bottom_mobile}}px;
    }
  #shopify-section-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    opacity:1; /* 初始正常显示 */
  }
  #shopify-section-{{ section.id }} .section-svg-bg {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;   /* 👈 限制最大宽度 */
    max-height: 100%;  /* 👈 限制最大高度 */
    z-index: 0;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .callout-arrow{
    width: 100px;
    height: 69px;
  }
  #shopify-section-{{ section.id }} .camera-section{
    position: relative;
    overflow: hidden;
    z-index: 1;
  }
  #shopify-section-{{ section.id }} .section-svg-bg svg {
    max-width: 1920px;
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .camera-section-header {
    text-align: center;
    margin: 0 auto 40px;
    max-width: 900px;
    position: relative;
    z-index: 1;
  }
  #shopify-section-{{ section.id }} .camera-title {
    margin: 0 auto 18px;
    color: #333333;
  }
  #shopify-section-{{ section.id }} .camera-subtitle {
    color: #333333;
    margin: 0 auto;
    max-width: 530px;
    letter-spacing:0%;
    & p{
      margin:0;
    }
  }

  #shopify-section-{{ section.id }} .camera-img-box{
    position: relative;
    margin: 0 auto;
    width: fit-content;
    height: auto;
    max-width:538px;
    z-index: 1;
  }
  #shopify-section-{{ section.id }} .camera-img-box .camera-img{
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .camera-shutter-btn{
    display: flex;
    justify-content: center;
    align-items: center;
    position: absolute;
    top: 33.6%;       /* 红点位置 */
    left: 21%;     /* 红点位置 */
    transform: translate(-50%, -50%);
    background: #fff;
    padding: 4px;
    border-radius: 50%;
    border: none;
    z-index: 99;
  }
  #shopify-section-{{ section.id }} .camera-shutter-btn-inner {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: none;
    background: #e63935;
    cursor: pointer;
    z-index: 999;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  #shopify-section-{{ section.id }} .camera-shutter-btn:active {
    transform: translate(-50%, -50%) scale(0.9);
    background: #b51b14; /* 点击变色 */
  }

  #shopify-section-{{ section.id }} .camera-callout-inner {
    position: absolute;
    display: flex;
    flex-direction: column;
    top: {{ section.settings.arrow_top | default: 40 | append: "%" }};
    left: {{ section.settings.arrow_right | default: 0 | append: "%" }};
    z-index: 10;
  }
  #shopify-section-{{ section.id }} .callout-text {
    position: relative;
    right: 50%;
    color: #FF6E1D;
    font-size: 30px;
    font-weight: 400;
    line-height: 78%;
    letter-spacing: -4%;
    white-space: nowrap;
    transform: rotate(-15deg);
  }

  #shopify-section-{{ section.id }} .cards-wrapper {
    position: relative;
    z-index: 1;
    width: min(100%, 1600px);
    margin: {{ section.settings.wrap_top_1920 }}px auto 0;
    aspect-ratio: 596 / 315;
    height: auto;
  }


  #shopify-section-{{ section.id }} .polaroid-card {
    position: absolute;
    box-sizing: content-box;
    background: #fff;
    padding: clamp(8px, 0.85vw, 12px);
    padding-bottom: clamp(10px, 1.05vw, 15px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    border-radius: 6px;
    transform-origin: center center;
    transform: rotate(var(--card-rotate, 0deg)) translate(var(--card-translate-x, 0), var(--card-translate-y, 0)) translateY(var(--card-hover-y, 0px)) scale(var(--card-scale, 1))!important;
    will-change: transform, box-shadow;
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .polaroid-card.is-hidden {
    display: none;
  }
  #shopify-section-{{ section.id }} .polaroid-img-inner {
    overflow: hidden;
    border-radius: 4px;
  }
  #shopify-section-{{ section.id }} .polaroid-img-inner img {
    display: block;
    object-fit: cover;
    width: 100%;
    height: auto;
    max-width: 100%;
  }
  #shopify-section-{{ section.id }} .polaroid-text {
    margin: 8px 0 0;
    font-size: clamp(12px, 1.05vw, 20px);
    text-align: left;
    line-height: 1;
    letter-spacing: -3%;
    overflow-wrap: anywhere;
    color:#000;
  }
  #shopify-section-{{ section.id }} .polaroid-text p{
    margin: 0;
  }
  #shopify-section-{{ section.id }} .img-placeholder {
    width: 100%;
    height: 100%;
    background: #f3f3f3;
  }
  @media (max-width: 1440px) {
    #shopify-section-{{ section.id }} .cards-wrapper {
      margin-top: -170px;
      width: min(100%, 1400px);
    }
    #shopify-section-{{ section.id }} .polaroid-text{
      font-size: 16px;
    }
  }
  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .cards-wrapper {
          margin-top: -163px;
          width: 100%;
    }
     #shopify-section-{{ section.id }} .polaroid-text{
      font-size: 12px;
    }
    #shopify-section-{{ section.id }} .camera-subtitle {
    max-width: 90vw;
  }
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .cards-wrapper {
      margin-top: {{ section.settings.wrap_top_768 }}px;
      width: 100%;
      aspect-ratio: 1 / 1;
    }
    #shopify-section-{{ section.id }} .callout-arrow{
      width: 12vw;
      height: auto;
      aspect-ratio: 100 / 19;
    }
    #shopify-section-{{ section.id }} .camera-title{
      max-width: 90vw;
    }
    #shopify-section-{{ section.id }} .camera-img-box{
      max-width:480px
      width: 64vw;
    }
     #shopify-section-{{ section.id }} .polaroid-text{
      font-size: clamp(7px, 1.85vw, 10px);
    }
    #shopify-section-{{ section.id }} .callout-text{
      font-size: calc(100vw * (44 / 750));
    }
    #shopify-section-{{ section.id }} .camera-shutter-btn{
      top: 33.6%;
      left: 21%;
    }
    #shopify-section-{{ section.id }} .camera-shutter-btn-inner{
      width: 30px;
      height: 30px;
    }
  }
  @media (max-width: 480px) {
    #shopify-section-{{ section.id }} .cards-wrapper {
      margin-top: {{ section.settings.wrap_top_480 }}px;
      width: min(100%, 430px);
      aspect-ratio: 3 / 4;
    }
    #shopify-section-{{ section.id }} .camera-img-box{
      max-width: 65vw;
    }
    #shopify-section-{{ section.id }} .camera-subtitle,
    #shopify-section-{{ section.id }} .camera-title{
      max-width: 90vw;
    }
      #shopify-section-{{ section.id }} .polaroid-text{
      font-size: clamp(7px, 1.85vw, 10px);
    }
    #shopify-section-{{ section.id }} .callout-arrow{
      width: 10vw;
      height: auto;
      aspect-ratio: 100 / 69;
    }
      #shopify-section-{{ section.id }} .callout-text{
      font-size: calc(100vw * (44/750));
    }
    #shopify-section-{{ section.id }} .polaroid-img-inner{
      max-width: none;
    }
    #shopify-section-{{ section.id }} .camera-shutter-btn-inner{
      width: 20px;
      height: 20px;
    }
    #shopify-section-{{ section.id }} .camera-callout-inner {
      top: 17%;
      left: -1%;
    }
  }

  {% for block in section.blocks %}
  #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child({{ forloop.index }}) {
    top: {{ block.settings.top }}%;
    left: {{ block.settings.left }}%;
    width: {{ block.settings.w_1920 | times: 100.0 | divided_by: 1180 }}%;
    --card-rotate: {{ block.settings.rotate }}deg;
    --card-translate-x: {%- if block.settings.use_translate_x -%}{{ block.settings.translate_x }}%{%- else -%}0{%- endif -%};
    --card-translate-y: {%- if block.settings.use_translate_y -%}{{ block.settings.translate_y }}%{%- else -%}0{%- endif -%};
  }
  #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child({{ forloop.index }}) img {
    aspect-ratio: {{ block.settings.w_1920 }} / {{ block.settings.h_1920 }};
  }
  /* #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child({{ forloop.index }}) .polaroid-text{
    max-width:{{ block.settings.w_1920 }}px;
  } */
  {% endfor %}


  @media (max-width: 1440px) {
    {% for block in section.blocks %}
    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child({{ forloop.index }}) {
      top: {{ block.settings.top }}%;
      left: {{ block.settings.left }}%;
      width: {{ block.settings.w_1920 | times: 100.0 | divided_by: 1180 }}%;
      --card-rotate: {{ block.settings.rotate }}deg;
      --card-translate-x: {%- if block.settings.use_translate_x -%}{{ block.settings.translate_x }}%{%- else -%}0{%- endif -%};
      --card-translate-y: {%- if block.settings.use_translate_y -%}{{ block.settings.translate_y }}%{%- else -%}0{%- endif -%};
    }
    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child({{ forloop.index }}) img {
      aspect-ratio: {{ block.settings.w_1920 }} / {{ block.settings.h_1920 }};
    }
    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child({{ forloop.index }}) .polaroid-text{
     max-width:none;
    }
    {% endfor %}
  }


  @media (max-width: 1024px) {
    {% for block in section.blocks %}
    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child({{ forloop.index }}) {
      top: {{ block.settings.top }}%;
      left: {{ block.settings.left }}%;
      width: {{ block.settings.w_1920 | times: 100.0 | divided_by: 1180 }}%;
      --card-rotate: {{ block.settings.rotate }}deg;
      --card-translate-x: {%- if block.settings.use_translate_x -%}{{ block.settings.translate_x }}%{%- else -%}0{%- endif -%};
      --card-translate-y: {%- if block.settings.use_translate_y -%}{{ block.settings.translate_y }}%{%- else -%}0{%- endif -%};
    }
    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child({{ forloop.index }}) img {
      aspect-ratio: {{ block.settings.w_1920 }} / {{ block.settings.h_1920 }};
    }
    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child({{ forloop.index }}) .polaroid-text{
    max-width:none;
  }
    {% endfor %}
  }

  @media (max-width: 768px) {
    {% for block in section.blocks %}
    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child({{ forloop.index }}) {
      top: {{ block.settings.top_480 }}%;
      left: {{ block.settings.left_480 }}%;
      width: {{ block.settings.w_480 }}%;
      --card-rotate: {{ block.settings.rotate_480 }}deg;
      --card-translate-x: {%- if block.settings.use_translate_x_480 -%}{{ block.settings.translate_x_480 }}%{%- else -%}0{%- endif -%};
      --card-translate-y: {%- if block.settings.use_translate_y_480 -%}{{ block.settings.translate_y_480 }}%{%- else -%}0{%- endif -%};
    }
    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child({{ forloop.index }}) img {
      aspect-ratio: {{ block.settings.w_480 }} / {{ block.settings.h_480 }};
    }
    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child({{ forloop.index }}) .polaroid-text{
    max-width:none;
  }
    {% endfor %}

    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child(1),
    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child(2) {
      z-index: 2;
    }
    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child(1) {
      top: 5%;
      left: 1%;
      width: 38%;
      --card-rotate: -12deg;
      --card-translate-x: 0;
      --card-translate-y: 0;
    }
    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child(2) {
      top: 4%;
      left: 43%;
      width: 49%;
      --card-rotate: 0deg;
      --card-translate-x: 0;
      --card-translate-y: 0;
    }
    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child(3) {
      top: 27%;
      left: 20%;
      width: 54%;
      z-index: 4;
      --card-rotate: -4deg;
      --card-translate-x: 0;
      --card-translate-y: 0;
    }
    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child(4),
    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child(5) {
      z-index: 1;
    }
    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child(4) {
      top: 61%;
      left: 2%;
      width: 39%;
      --card-rotate: 7deg;
      --card-translate-x: 0;
      --card-translate-y: 0;
    }
    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card:nth-child(5) {
      top: 58%;
      left: 60%;
      width: 37%;
      --card-rotate: 0deg;
      --card-translate-x: 0;
      --card-translate-y: 0;
    }

    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card.is-slot-1 {
      top: 5%;
      left: 1%;
      width: 38%;
      z-index: 2;
      --card-rotate: -12deg;
      --card-translate-x: 0;
      --card-translate-y: 0;
    }
    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card.is-slot-2 {
      top: 4%;
      left: 43%;
      width: 49%;
      z-index: 2;
      --card-rotate: 0deg;
      --card-translate-x: 0;
      --card-translate-y: 0;
    }
    #shopify-section-{{ section.id }} .cards-wrapper .polaroid-card.is-slot-3 {
      top: 27%;
      left: 20%;
      width: 54%;
      z-index: 4;
      --card-rotate: -4deg;
      --card-translate-x: 0;
      --card-translate-y: 0;
    }
