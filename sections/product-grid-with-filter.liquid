{% comment %} <script>
document.addEventListener('DOMContentLoaded', () => {
  const sectionRoot = document.querySelector('#shopify-section-{{ section.id }}');
  const header = document.querySelector('sticky-header');
  const headerSection = header ? header.dataset['section'] : null;
  
  if (!sectionRoot) return;

  const panel = sectionRoot.querySelector('.pf-filter-panel');
  const toggle = sectionRoot.querySelector('.pf-filter-toggle');
  const selects = sectionRoot.querySelectorAll('.pf-filter-select');
  const sortSel = sectionRoot.querySelector('.pf-sort-select');
  const wrap = sectionRoot.querySelector('[data-products]');
  let originList = Array.from(sectionRoot.querySelectorAll('[data-product]'));
  const reset = sectionRoot.querySelector('.pf-btn-reset');
  const apply = sectionRoot.querySelector('.pf-btn-apply');
  const priceSelect = sectionRoot.querySelector('[data-type="price"]');
  const noResultEl = sectionRoot.querySelector('.pf-no-result');
  const addButtons = sectionRoot.querySelectorAll('.pf-add-to-cart');

  if (!wrap || originList.length === 0) return;

  if (toggle && panel) {
    toggle.addEventListener('click', () => panel.classList.toggle('active'));
  }

  function filterAndSort(){
    const priceVal = priceSelect ? priceSelect.value : '';
    const sortType = sortSel ? sortSel.value : 'default';

    let filtered = originList.filter(el => {
      const p = Number(el.dataset.price);
      let pass = true;

      if (priceVal) {
        if (priceVal === '2000+') {
          pass = p >= 2000;
        } else {
          let parts = priceVal.split('-');
          let min = Number(parts[0]);
          let max = Number(parts[1]);
          pass = p >= min && p <= max;
        }
      }
      return pass;
    });

    filtered.sort((a, b) => {
      let pa = Number(a.dataset.price), pb = Number(b.dataset.price);
      switch (sortType) {
        case 'price_asc': return pa - pb;
        case 'price_desc': return pb - pa;
        default: return 0;
      }
    });

    wrap.innerHTML = '';
    let has = filtered.length > 0;
    filtered.forEach(item => wrap.appendChild(item));
    if (noResultEl) {
      noResultEl.style.display = has ? 'none' : 'block';
    }
  }

  if (apply) apply.addEventListener('click', filterAndSort);
  if (sortSel) sortSel.addEventListener('change', filterAndSort);
  if (reset) {
    reset.addEventListener('click', () => {
      selects.forEach(s => s.value = '');
      if (sortSel) sortSel.value = 'default';
      filterAndSort();
    });
  }

  // 加购按钮：显示 loading-spinner，然后成功后跳转 cart 页面
  addButtons.forEach(button => {
    button.addEventListener('click', () => {
      const variantId = button.getAttribute('data-variant-id');
      if (!variantId || button.disabled) return;

      const parentBox = button.closest('.pf-product-link-box');
      const arrowSvg = parentBox.querySelector('svg');
      const loadingSpinner = parentBox.querySelector('.loading__spinner');

      button.disabled = true;
      button.classList.add('hidden');
      if (arrowSvg) arrowSvg.classList.add('hidden');
      if (loadingSpinner) loadingSpinner.classList.remove('hidden');

      const bodyData = {
        id: Number(variantId),
        quantity: 1
      };

      if (headerSection) {
        bodyData.sections = [headerSection];
      }

      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(bodyData)
      })
      .then(res => {
        if (!res.ok) throw new Error('failed');
        return res.json();
      })
      .then((res) => {
        if (headerSection && res.sections && res.sections[headerSection] && header) {
          const oldCartBubble = header.querySelector('#cart-icon-bubble');
          const parser = new DOMParser();
          const doc = parser.parseFromString(res.sections[headerSection], 'text/html');
          const newCartBubble = doc.querySelector('#cart-icon-bubble');
          if (oldCartBubble && newCartBubble) {
            oldCartBubble.replaceWith(newCartBubble);
          }
        }

        // 成功：直接跳转到购物车页面
        //window.location.href = '/cart';
        const notification = document.querySelector('#cart-notification');
        notification.classList.add('animate');
        notification.classList.add('active');
      })
      .catch(() => {
        // 失败：还原按钮状态，不跳转
        if (loadingSpinner) loadingSpinner.classList.add('hidden');
        button.classList.remove('hidden');
        if (arrowSvg) arrowSvg.classList.remove('hidden');
        button.disabled = false;
      });
    });
  });

  // 布局切换
  const layoutBox = sectionRoot.querySelector('.mobile-layout-cahnge-btn');
  const doubleItem = layoutBox ? layoutBox.querySelector('.double-layout') : null;
  const singleItem = layoutBox ? layoutBox.querySelector('.single-layout') : null;
  const gridWrap = sectionRoot.querySelector('.pf-product-grid');

  function setLayout(type){
    if (!doubleItem || !singleItem || !gridWrap) return;
    doubleItem.classList.remove('layout-active');
    singleItem.classList.remove('layout-active');
    if(type === 'double'){
      doubleItem.classList.add('layout-active');
      gridWrap.classList.add('grid-double');
    }else{
      singleItem.classList.add('layout-active');
      gridWrap.classList.remove('grid-double');
    }
  }
  if(doubleItem && singleItem && gridWrap){
    doubleItem.addEventListener('click',()=>setLayout('double'));
    singleItem.addEventListener('click',()=>setLayout('single'));
  }
});
</script> {% endcomment %}
